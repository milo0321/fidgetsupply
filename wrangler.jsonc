{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fidgetsupply",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "vars": {
    "NOTIFICATION_EMAIL": "sales@fidgetsupply.com",
    "RESEND_FROM_EMAIL": "FidgetSupply Inquiries <quotes@send.fidgetsupply.com>",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAF1GTaPVmYSNUcHS"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
