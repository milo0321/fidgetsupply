---
import { getLanguageFromURL, useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/config';

interface Props {
  title?: string;
  answer: string;
  metrics?: { label: string; value: string }[];
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLanguageFromURL(Astro.url.pathname);
const t = useTranslations(currentLang);

const {
  title = t('geo.defaultTitle'),
  answer,
  metrics = [
    { label: t('geo.metricTooling'), value: t('geo.metricToolingVal') },
    { label: t('geo.metricBlankMoq'), value: t('geo.metricBlankMoqVal') },
    { label: t('geo.metricLogoMoq'), value: t('geo.metricLogoMoqVal') },
    { label: t('geo.metricSafety'), value: t('geo.metricSafetyVal') }
  ]
} = Astro.props;

// Auto-format inline numbered lists like "(1) ... (2) ... (3) ..." into scannable vertical lines
let introText = answer;
let listItems: string[] = [];
let outroText = '';

if (answer && /\(1\)\s+/.test(answer) && /\(2\)\s+/.test(answer)) {
  const firstIdx = answer.indexOf('(1)');
  introText = answer.slice(0, firstIdx).trim();
  const rest = answer.slice(firstIdx);
  const parts = rest.split(/\(\d+\)\s+/).map((s) => s.trim()).filter(Boolean);
  if (parts.length >= 2) {
    const lastPart = parts[parts.length - 1];
    // Split trailing sentence after the last numbered item if present (e.g. "). Free Amazon...")
    const splitMatch = lastPart.match(/^(.+?\)\.)\s+([A-Z].+)$/);
    if (splitMatch) {
      parts[parts.length - 1] = splitMatch[1].trim();
      outroText = splitMatch[2].trim();
    }
    listItems = parts.map((item) => item.replace(/[,;]\s*(and\s+)?$/i, '').replace(/\.$/, '').trim());
  }
}
---

<section class="geo-direct-answer" aria-label="Engineering Summary" itemscope itemtype="https://schema.org/WebPageElement">
  <div class="geo-header">
    <span class="geo-badge">{t('geo.badge')}</span>
    <h2 class="geo-title" itemprop="headline">{title}</h2>
  </div>
  {listItems.length >= 2 ? (
    <div class="geo-structured-answer" itemprop="description">
      {introText && <p class="geo-text geo-text-intro">{introText}</p>}
      <ol class="geo-answer-list">
        {listItems.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
      {outroText && <p class="geo-text geo-text-outro">{outroText}</p>}
    </div>
  ) : (
    <p class="geo-text" itemprop="description">{answer}</p>
  )}
  {metrics.length > 0 && (
    <div class="geo-metrics">
      {metrics.map((m) => (
        <div class="geo-metric-card">
          <span class="metric-label">{m.label}</span>
          <strong class="metric-value">{m.value}</strong>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .geo-direct-answer {
    background: linear-gradient(135deg, #f0f9ff 0%, #f8fafc 100%);
    border: 1px solid #bae6fd;
    border-left: 5px solid #0284c7;
    border-radius: 0.85rem;
    padding: clamp(2.25rem, 3.5vw, 2.5rem) clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 2.5rem 0;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.06);
  }
  .geo-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .geo-badge {
    background: #0369a1;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
  }
  .geo-title {
    font-size: 1.08rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }
  .geo-text {
    color: #1e293b;
    font-size: 0.96rem;
    line-height: 1.72;
    margin-bottom: 1.25rem;
  }
  .geo-text-intro {
    margin-bottom: 0.7rem;
  }
  .geo-text-outro {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 0.92rem;
    color: #334155;
  }
  .geo-answer-list {
    margin: 0 0 0.85rem;
    padding: 0;
    list-style: none;
    counter-reset: geo-item;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .geo-answer-list li {
    counter-increment: geo-item;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid #dbeafe;
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    color: #0f172a;
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .geo-answer-list li::before {
    content: counter(geo-item);
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: #0369a1;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
  }
  .geo-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 0.85rem;
  }
  .geo-metric-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.55rem;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .metric-label {
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .metric-value {
    font-size: 0.92rem;
    color: #0f172a;
    font-weight: 800;
    margin-top: 0.15rem;
  }
  @media (max-width: 640px) {
    .geo-direct-answer {
      padding: 1.35rem 1.15rem;
      margin: 1.65rem 0;
    }
    .geo-title {
      font-size: 0.98rem;
      line-height: 1.35;
    }
    .geo-text {
      font-size: 0.88rem;
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    .geo-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .geo-metric-card {
      padding: 0.65rem 0.75rem;
    }
    .metric-label {
      font-size: 0.66rem;
    }
    .metric-value {
      font-size: 0.82rem;
    }
  }
</style>
