    contactLabel: 'البريد الإلكتروني للعمل (أو رقم واتساب) *',
    contactPlaceholder: 'name@company.com أو +966 / +971 ...',
    noteLabel: 'الطراز المختار (SKU) / الكمية / ملاحظات (اختياري)',
    submitBtn: '⚡ أرسل قائمة الأسعار PDF وعرض السعر الآن →',
    submittingText: 'جارٍ الإرسال...',
    waBtn: '💬 أو تحدث مباشرة عبر واتساب (رد خلال 15 ثانية)',
    fullFormLink: 'هل تريد إرفاق ملف الشعار (.AI/.PDF)؟ افتح النموذج الكامل →',
    successTitle: '✅ تم استلام طلبك! يرجى التحقق من بريدك الإلكتروني.',
    successSub: 'سيرسل لك مكتب التصدير لدينا قائمة الأسعار الكاملة PDF أو فاتورة العينة أو تصميم الشعار 1:1 خلال 2 إلى 12 ساعة.',
    closeLabel: 'متابعة التصفح'
  }
};

const L = MODAL_I18N[currentLang] || MODAL_I18N.en;
---

<div
  id="fs-quick-rfq-modal"
  class="qrfq-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="qrfq-title"
  hidden
>
  <div class="qrfq-backdrop" data-qrfq-close></div>
  <div class="qrfq-dialog">
    <button type="button" class="qrfq-close-btn" data-qrfq-close aria-label={L.closeLabel}>
      &times;
    </button>

    <div id="qrfq-form-view">
      <div class="qrfq-header">
        <span class="qrfq-badge">{L.badge}</span>
        <h3 id="qrfq-title" class="qrfq-title">{L.title}</h3>
        <p class="qrfq-subtitle">{L.subtitle}</p>
      </div>

      <div class="qrfq-tabs" role="tablist">
        <button type="button" class="qrfq-tab active" data-qrfq-tab="sample">
          {L.tabSample}
        </button>
        <button type="button" class="qrfq-tab" data-qrfq-tab="sheet">
          {L.tabSheet}
        </button>
        <button type="button" class="qrfq-tab" data-qrfq-tab="quote">
          {L.tabQuote}
        </button>
      </div>

      <form id="qrfq-form" class="qrfq-form" novalidate>
        <input type="text" id="qrfq-hp" name="rx_bot_trap_hp9" tabindex="-1" autocomplete="off" style="display:none;" />
        <div class="qrfq-field">
          <label for="qrfq-contact-input" class="qrfq-label">{L.contactLabel}</label>
          <input
            type="text"
            id="qrfq-contact-input"
            class="qrfq-input"
            placeholder={L.contactPlaceholder}
            required
            autocomplete="email"
          />
        </div>

        <div class="qrfq-field">
          <label for="qrfq-note-input" class="qrfq-label">{L.noteLabel}</label>
          <input
            type="text"
            id="qrfq-note-input"
            class="qrfq-input qrfq-input-note"
            value="FS-125 · 1-Pc Sample / 140-SKU Price Sheet"
          />
        </div>

        <button
          type="submit"
          id="qrfq-submit-btn"
          class="qrfq-submit-btn"
          data-default-text={L.submitBtn}
          data-loading-text={L.submittingText}
        >
          {L.submitBtn}
        </button>
      </form>

      <div class="qrfq-alt-actions">
        <a
          id="qrfq-wa-link"
          href="https://wa.me/8618750126315"
          target="_blank"
          rel="noopener noreferrer"
          class="qrfq-wa-btn"
        >
          {L.waBtn}
        </a>
        <a id="qrfq-full-form-link" href={fullContactUrl} class="qrfq-full-link">
          {L.fullFormLink}
        </a>
      </div>
    </div>

    <div id="qrfq-success-view" class="qrfq-success" hidden>
      <div class="qrfq-success-icon">✓</div>
      <h3 class="qrfq-success-title">{L.successTitle}</h3>
      <p class="qrfq-success-sub">{L.successSub}</p>
      <div class="qrfq-alt-actions" style="margin-top: 1.25rem;">
        <a
          id="qrfq-success-wa-link"
          href="https://wa.me/8618750126315"
          target="_blank"
          rel="noopener noreferrer"
          class="qrfq-wa-btn"
        >
          {L.waBtn}
        </a>
        <button type="button" class="qrfq-close-secondary" data-qrfq-close>
          {L.closeLabel}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var modal = document.getElementById('fs-quick-rfq-modal');
    if (!modal) return;
    var formView = document.getElementById('qrfq-form-view');
    var successView = document.getElementById('qrfq-success-view');
    var form = document.getElementById('qrfq-form');
    var contactInput = document.getElementById('qrfq-contact-input');
    var noteInput = document.getElementById('qrfq-note-input');
    var submitBtn = document.getElementById('qrfq-submit-btn');
    var waLink = document.getElementById('qrfq-wa-link');
    var successWaLink = document.getElementById('qrfq-success-wa-link');
    var fullFormLink = document.getElementById('qrfq-full-form-link');
    var tabs = modal.querySelectorAll('.qrfq-tab');

    var state = {
      sku: 'All 140 Ready Molds',
      mode: 'Sample / Prototype Evaluation',
      qty: '1',
      tab: 'sample'
    };

    try {
      var savedEmail = localStorage.getItem('rx_user_email') || sessionStorage.getItem('rx_user_email') || '';
      if (savedEmail && contactInput) contactInput.value = savedEmail;
    } catch (_) {}

    function syncModalFields() {
      var summary = '';
      if (state.tab === 'sample') {
        summary = state.sku + ' · 1-Pc Evaluation Sample + Free 1:1 Logo Proof';
      } else if (state.tab === 'sheet') {
        summary = 'Full 140-SKU Wholesale Price Sheet (PDF/Excel) + ' + state.sku;
      } else {
        summary = state.sku + ' · Qty: ' + (state.qty === '1' ? '50' : state.qty) + ' pcs · ' + state.mode;
      }
      if (noteInput) noteInput.value = summary;

      var waMsg = 'Hello FidgetSupply, I would like: ' + summary + ' (Page: ' + window.location.pathname + ')';
      var waUrl = 'https://wa.me/8618750126315?text=' + encodeURIComponent(waMsg);
      if (waLink) waLink.setAttribute('href', waUrl);
      if (successWaLink) successWaLink.setAttribute('href', waUrl);

      tabs.forEach(function (t) {
        t.classList.toggle('active', t.getAttribute('data-qrfq-tab') === state.tab);
      });
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        state.tab = t.getAttribute('data-qrfq-tab') || 'sample';
        syncModalFields();
      });
    });

    function openQuickRfqModal(opts) {
      opts = opts || {};
      try {
        sessionStorage.setItem('fs_qrfq_auto_shown', '1');
      } catch (_) {}
      state.sku = opts.sku || state.sku || 'All 140 Ready Molds';
      state.mode = opts.mode || 'Blank Stock (MOQ 50 pcs)';
      state.qty = opts.qty || '50';

      if (state.qty === '1' || /sample/i.test(state.mode)) {
        state.tab = 'sample';
      } else if (/140|catalog|sheet/i.test(state.sku)) {
        state.tab = 'sheet';
      } else {
        state.tab = 'quote';
      }

      if (opts.href && fullFormLink) {
        fullFormLink.setAttribute('href', opts.href);
      }

      if (formView) formView.hidden = false;
      if (successView) successView.hidden = true;
      syncModalFields();
      modal.hidden = false;
      setTimeout(function () {
        if (contactInput) contactInput.focus();
      }, 60);

      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'rfq_form_start', {
            event_category: 'conversion_intent',
            source_page: window.location.pathname,
            rfq_sku: state.sku,
            rfq_qty: state.qty
          });
        }
      } catch (_) {}
    }

    function closeQuickRfqModal() {
      modal.hidden = true;
    }

    modal.querySelectorAll('[data-qrfq-close]').forEach(function (el) {
      el.addEventListener('click', closeQuickRfqModal);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeQuickRfqModal();
    });

    function detectPageSkuContext() {
      var skuEl = document.getElementById('display-sku');
      var h1El = document.querySelector('h1');
      var h1Text = h1El ? h1El.innerText.trim().slice(0, 65) : '';
      if (skuEl) {
        var cleanSku = skuEl.innerText.replace('SKU:', '').trim();
        return {
          sku: cleanSku + (h1Text ? ' (' + h1Text + ')' : ''),
          mode: 'Sample / Prototype Evaluation',
          qty: '1'
        };
      }
      return {
        sku: h1Text ? 'All 140 Ready Molds (' + h1Text + ')' : 'All 140 Ready Molds (Full Catalog & Price List)',
        mode: 'Sample / Prototype Evaluation',
        qty: '1'
      };
    }

    // Smart Proactive Trigger: 1) Desktop Exit-Intent (>7s), 2) Engaged Reader (>24s + scroll), max 1x per session
    var pageEnterTs = Date.now();
    var hasUserScrolled = false;
    window.addEventListener(
      'scroll',
      function () {
        if (window.scrollY > 120) hasUserScrolled = true;
      },
      { passive: true }
    );

    function triggerProactiveModal(reason) {
      if (window.location.pathname.replace(/\/+$/, '').endsWith('/contact')) return;
      if (!modal.hidden) return;
      try {
        if (sessionStorage.getItem('fs_qrfq_auto_shown') === '1') return;
        if (localStorage.getItem('rx_user_email')) return;
        sessionStorage.setItem('fs_qrfq_auto_shown', '1');
      } catch (_) {}
      var ctx = detectPageSkuContext();
      openQuickRfqModal(ctx);
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'proactive_rfq_prompt', {
            event_category: 'conversion_intent',
            trigger_type: reason,
            source_page: window.location.pathname
          });
        }
      } catch (_) {}
    }

    document.addEventListener('mouseleave', function (e) {
      if (e.clientY <= 12 && Date.now() - pageEnterTs > 7000) {
        triggerProactiveModal('desktop_exit_intent');
      }
    });

    setTimeout(function () {
      if (hasUserScrolled) {
        triggerProactiveModal('engaged_24s_scroll');
      } else {
        var onLateScroll = function () {
          if (window.scrollY > 150) {
            window.removeEventListener('scroll', onLateScroll);
            triggerProactiveModal('engaged_late_scroll');
          }
        };
        window.addEventListener('scroll', onLateScroll, { passive: true });
      }
    }, 24000);

    // Global Inline 1-Field Email/WhatsApp Capture Form Handler (.inline-quick-sheet-form)
    document.addEventListener('submit', function (e) {
      var inlineForm = e.target.closest('.inline-quick-sheet-form');
      if (!inlineForm) return;
      e.preventDefault();
      var input = inlineForm.querySelector('.inline-qrfq-input');
      var btn = inlineForm.querySelector('.inline-qrfq-btn');
      var statusEl = inlineForm.querySelector('.inline-qrfq-status');
      var rawVal = (input && input.value.trim()) || '';
      if (!rawVal || rawVal.length < 3) {
        if (input) {
          input.style.borderColor = '#ef4444';
          input.focus();
        }
        return;
      }
      if (input) input.style.borderColor = '#cbd5e1';
      var skuTarget = inlineForm.getAttribute('data-inline-sku') || 'All 140 Ready Molds (Full Catalog & Price List)';
      try {
        localStorage.setItem('rx_user_email', rawVal);
        sessionStorage.setItem('rx_user_email', rawVal);
        sessionStorage.setItem('fs_qrfq_auto_shown', '1');
      } catch (_) {}

      if (btn) {
        btn.disabled = true;
        btn.textContent = '...';
      }
      var journeySnapshot =
        typeof window.getRxBrowsingJourneySnapshot === 'function'
          ? window.getRxBrowsingJourneySnapshot()
          : [];
      var urlParams = new URLSearchParams(window.location.search);

      fetch('/api/whatsapp-track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event: 'message_sent',
          triggerSource: 'Inline 1-Field Catalog Price Sheet Bar',
          userEmail: rawVal,
          pageUrl: window.location.href,
          pagePath: window.location.pathname,
          pageTitle: document.title,
          productName: skuTarget,
          messageText: '[Inline 1-Field Lead]\nContact: ' + rawVal + '\nRequested: 140-SKU PDF Price Sheet & 1-Pc Sample Info for ' + skuTarget,
          browsingJourney: JSON.stringify(journeySnapshot),
          pageReferrer: document.referrer || 'Direct Visit',
          browserLanguage: navigator.language || 'en',
          screenResolution: window.screen.width + 'x' + window.screen.height,
          clientTimezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
          clientLocalTime: new Date().toLocaleString(),
          timeOnPageSeconds: Math.max(1, Math.round((Date.now() - pageEnterTs) / 1000)) + 's',
          utmSource: urlParams.get('utm_source') || '',
          utmMedium: urlParams.get('utm_medium') || '',
          utmCampaign: urlParams.get('utm_campaign') || ''
        }),
        keepalive: true
      })
        .catch(function () {})
        .finally(function () {
          if (btn) {
            btn.textContent = '✓';
            btn.style.background = '#059669';
          }
          if (statusEl) {
            statusEl.hidden = false;
          }
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', {
                event_category: 'form_submission',
                event_label: 'inline_catalog_sheet_bar',
                rfq_sku: skuTarget,
                page_location: window.location.href
              });
            }
          } catch (_) {}
        });
    });

    // Intercept clicks on any [data-rfq-sku] element outside the /contact page
    document.addEventListener(
      'click',
      function (e) {
        if (window.location.pathname.replace(/\/+$/, '').endsWith('/contact')) return;
        var trigger = e.target.closest('[data-rfq-sku]');
        if (!trigger || trigger.id === 'qrfq-full-form-link') return;

        var sku = trigger.getAttribute('data-rfq-sku') || '';
        var mode = trigger.getAttribute('data-rfq-mode') || 'Blank Stock (MOQ 50 pcs)';
        var qty = trigger.getAttribute('data-rfq-qty') || '50';
        var href = trigger.getAttribute('href') || '/contact';

        try {
          var payload = JSON.stringify({ sku: sku, mode: mode, qty: qty, ts: Date.now() });
          sessionStorage.setItem('fs_rfq_prefill', payload);
          localStorage.setItem('fs_rfq_prefill', payload);
        } catch (_) {}

        e.preventDefault();
        openQuickRfqModal({ sku: sku, mode: mode, qty: qty, href: href });
      },
      false
    );

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var rawContact = (contactInput && contactInput.value.trim()) || '';
        if (!rawContact || rawContact.length < 3) {
          if (contactInput) {
            contactInput.style.borderColor = '#ef4444';
            contactInput.focus();
          }
          return;
        }
        if (contactInput) contactInput.style.borderColor = '#cbd5e1';

        var hpVal = (document.getElementById('qrfq-hp') && document.getElementById('qrfq-hp').value) || '';
        var noteVal = (noteInput && noteInput.value.trim()) || '';

        try {
          localStorage.setItem('rx_user_email', rawContact);
          sessionStorage.setItem('rx_user_email', rawContact);
        } catch (_) {}

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = submitBtn.getAttribute('data-loading-text') || 'Sending...';
        }

        var journeySnapshot =
          typeof window.getRxBrowsingJourneySnapshot === 'function'
            ? window.getRxBrowsingJourneySnapshot()
            : [];
        var urlParams = new URLSearchParams(window.location.search);

        fetch('/api/whatsapp-track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: 'message_sent',
            triggerSource: '1-Step Instant RFQ Modal (' + state.tab.toUpperCase() + ')',
            userEmail: rawContact,
            userName: '',
            userCompany: '',
            pageUrl: window.location.href,
            pagePath: window.location.pathname,
            pageTitle: document.title,
            productName: state.sku,
            messageText:
              '[1-Step Instant Lead]\nContact: ' +
              rawContact +
              '\nRequest Type: ' +
              state.tab.toUpperCase() +
              '\nSelected SKU & Details: ' +
              noteVal,
            browsingJourney: JSON.stringify(journeySnapshot),
            rx_bot_trap_hp9: hpVal,
            pageReferrer: document.referrer || 'Direct Visit',
            browserLanguage: navigator.language || 'en',
            screenResolution:
              window.screen.width +
              'x' +
              window.screen.height +
              ' (' +
              (window.devicePixelRatio || 1) +
              'x DPR)',
            clientTimezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
            clientLocalTime: new Date().toLocaleString(),
            timeOnPageSeconds: 'Instant Modal',
            utmSource: urlParams.get('utm_source') || '',
            utmMedium: urlParams.get('utm_medium') || '',
            utmCampaign: urlParams.get('utm_campaign') || '',
            utmTerm: urlParams.get('utm_term') || '',
            utmContent: urlParams.get('utm_content') || ''
          }),
          keepalive: true
        })
          .catch(function () {})
          .finally(function () {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = submitBtn.getAttribute('data-default-text') || 'Send →';
            }
            if (formView) formView.hidden = true;
            if (successView) successView.hidden = false;

            try {
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'generate_lead', {
                  event_category: 'form_submission',
                  event_label: 'quick_rfq_modal_' + state.tab,
                  rfq_sku: state.sku,
                  rfq_qty: state.qty,
                  page_location: window.location.href
                });
              }
            } catch (_) {}
          });
      });
    }
  })();
</script>

<style>
  .qrfq-overlay[hidden] {
    display: none !important;
  }
  .qrfq-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .qrfq-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(4px);
    transform: translateZ(0);
  }
  .qrfq-dialog {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 500px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    padding: 1.5rem 1.5rem 1.35rem;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.45);
    overflow: hidden;
    transform: translateZ(0);
  }
  .qrfq-close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.85rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    color: #334155;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qrfq-close-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .qrfq-header {
    padding-right: 2rem;
    margin-bottom: 1rem;
  }
  .qrfq-badge {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.45rem;
  }
  .qrfq-title {
    font-size: clamp(1.12rem, 2.5vw, 1.32rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.3;
    margin: 0 0 0.35rem 0;
  }
  .qrfq-subtitle {
    font-size: 0.78rem;
    font-weight: 700;
    color: #047857;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.35rem 0.65rem;
    border-radius: 0.45rem;
    margin: 0;
  }
  .qrfq-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .qrfq-tab {
    padding: 0.5rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    background: #f8fafc;
    color: #334155;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .qrfq-tab.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }
  .qrfq-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .qrfq-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .qrfq-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
  }
  .qrfq-input {
    width: 100%;
    padding: 0.7rem 0.85rem;
    font-size: 0.92rem;
    border: 1.5px solid #94a3b8;
    border-radius: 0.55rem;
    color: #0f172a;
    background: #ffffff;
  }
  .qrfq-input:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }
  .qrfq-input-note {
    font-size: 0.82rem;
    background: #f8fafc;
    color: #334155;
  }
  .qrfq-submit-btn {
    width: 100%;
    padding: 0.82rem 1rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: #ffffff;
    background: #0284c7;
    border: none;
    border-radius: 0.6rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .qrfq-submit-btn:hover {
    background: #0369a1;
  }
  .qrfq-alt-actions {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }
  .qrfq-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.62rem 0.85rem;
    background: #059669;
    color: #ffffff !important;
    font-size: 0.82rem;
    font-weight: 800;
    border-radius: 0.55rem;
    text-decoration: none !important;
  }
  .qrfq-wa-btn:hover {
    background: #047857;
  }
  .qrfq-full-link {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    text-decoration: underline;
