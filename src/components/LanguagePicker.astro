---
import { languages, type SupportedLanguage } from '../i18n/config';
import { getLanguageFromURL, getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLanguage;
  variant?: 'header' | 'footer' | 'topbar';
}

const currentPath = Astro.url.pathname;
const detectedLang = getLanguageFromURL(currentPath);
const { currentLang = detectedLang, variant = 'header' } = Astro.props;
const t = useTranslations(currentLang);

const currentLangMeta = languages[currentLang] || languages.en;
const displayLanguages: SupportedLanguage[] = [
  'en',
  'de', 'fr', 'nl',
  'es', 'it', 'pt',
  'sv', 'da', 'no',
  'fi', 'pl', 'cs',
  'ru', 'ja', 'ko',
  'id', 'ar'
];
---

<div class={`lang-picker-wrapper ${variant}`}>
  <button
    class="lang-picker-btn"
    aria-label={t('lang.select') || 'Select Language'}
    aria-haspopup="true"
    aria-expanded="false"
    type="button"
  >
    <svg class="globe-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-code">{currentLangMeta.code.toUpperCase()}</span>
    <svg class="chevron-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-dropdown-menu" role="menu">
    <div class="lang-dropdown-header">
      <span>{t('lang.globalLocales') || 'Global Sourcing Locales'}</span>
      <span class="lang-count">{t('lang.localesCount') || '18 Locales'}</span>
    </div>
    <div class="lang-dropdown-grid">
      {displayLanguages.map((langKey) => {
        const langMeta = languages[langKey];
        if (!langMeta) return null;
        const isActive = langKey === currentLang;
        const isEn = langKey === 'en';
        const targetUrl = getLocalizedPath(currentPath, langKey, currentLang);

        return (
          <a
            href={targetUrl}
            class={`lang-grid-item ${isEn ? 'featured' : ''} ${isActive ? 'active' : ''}`}
            role="menuitem"
            hreflang={langMeta.code}
          >
            <div class="lang-option-text">
              <span class="lang-option-native">{langMeta.nativeName}</span>
              <span class="lang-option-name">{langMeta.name}{isEn ? ' (Global)' : ''}</span>
            </div>
            {isActive && (
              <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .lang-picker-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .lang-picker-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0.32rem 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }

  .lang-picker-btn:hover,
  .lang-picker-wrapper.active .lang-picker-btn {
    background-color: #f0f9ff;
    border-color: #0284c7;
    color: #0284c7;
  }

  .globe-icon {
    flex-shrink: 0;
    color: currentColor;
    opacity: 0.85;
  }

  .lang-code {
    letter-spacing: 0.5px;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
    opacity: 0.75;
  }

  .lang-picker-wrapper.active .chevron-icon {
    transform: rotate(180deg);
  }

  .lang-picker-wrapper.topbar .lang-picker-btn {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    padding: 0.22rem 0.5rem;
    border-radius: 5px;
    font-size: 0.74rem;
    gap: 0.3rem;
  }

  .lang-picker-wrapper.footer .lang-picker-btn {
    border-color: #334155;
    color: #e2e8f0;
    background: #1e293b;
  }

  .lang-picker-wrapper.footer .lang-picker-btn:hover {
    background: #334155;
    border-color: #38bdf8;
  }

  .lang-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 350px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 20px 35px -5px rgba(15, 23, 42, 0.18), 0 10px 15px -3px rgba(15, 23, 42, 0.08);
    z-index: 2500;
    overflow: hidden;
  }

  .lang-picker-wrapper.footer .lang-dropdown-menu {
    top: auto;
    bottom: calc(100% + 8px);
  }

  .lang-picker-wrapper.active .lang-dropdown-menu {
    display: block;
  }

  .lang-dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #64748b;
  }

  .lang-count {
    font-size: 0.68rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.15rem 0.45rem;
    border-radius: 10px;
  }

  .lang-dropdown-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.35rem;
    padding: 0.5rem;
  }

  .lang-grid-item {
    grid-column: span 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    padding: 0.45rem 0.5rem;
    text-decoration: none;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
    color: #334155;
  }

  .lang-grid-item:nth-last-child(-n+2) {
    grid-column: span 3;
  }

  .lang-grid-item:hover {
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #0f172a;
  }

  .lang-grid-item.active {
    background: #f0f9ff;
    border-color: #bae6fd;
    color: #0369a1;
    font-weight: 700;
  }

  .lang-grid-item.featured {
    grid-column: span 6;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    margin-bottom: 0.15rem;
    padding: 0.5rem 0.7rem;
  }

  .lang-option-text {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    line-height: 1.2;
    min-width: 0;
  }

  .lang-option-native {
    font-size: 0.82rem;
    font-weight: 700;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lang-grid-item.active .lang-option-native {
    color: #0369a1;
  }

  .lang-option-name {
    font-size: 0.67rem;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .check-icon {
    color: #0284c7;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .lang-dropdown-menu {
      width: calc(100vw - 1.5rem);
      max-width: 340px;
      right: 0;
    }
  }
</style>
