        if (!card) return;
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            card.hidden = true;
          });
        }
        var shownKey = 'fs_proactive_shown';
        try {
          if (sessionStorage.getItem(shownKey) === '1' || localStorage.getItem('rx_user_email')) return;
        } catch (_) {}

        var triggered = false;
        var enterTs = Date.now();
        var maxScrollPct = 0;
        var baseCumMs = 0;
        var pageViewsCount = 1;
        try {
          baseCumMs = parseInt(sessionStorage.getItem('fs_cum_dwell_ms') || '0', 10) || 0;
          pageViewsCount = (parseInt(sessionStorage.getItem('fs_cum_views') || '0', 10) || 0) + 1;
          sessionStorage.setItem('fs_cum_views', String(pageViewsCount));
        } catch (_) {}

        function saveCumDwell() {
          try {
            sessionStorage.setItem('fs_cum_dwell_ms', String(baseCumMs + Math.max(0, Date.now() - enterTs)));
          } catch (_) {}
        }
        window.addEventListener('pagehide', saveCumDwell);
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') saveCumDwell();
        });

        function getScrollPct() {
          var docH = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
          if (docH <= 0) return 0;
          return (window.scrollY / docH) * 100;
        }

        function showProactive(reason) {
          if (triggered) return;
          try {
            var curSl = JSON.parse(localStorage.getItem('fs_quote_shortlist') || '[]');
            if (Array.isArray(curSl) && curSl.length > 0) return;
          } catch (_) {}
          try {
            if (sessionStorage.getItem(shownKey) === '1' || localStorage.getItem('rx_user_email')) return;
            sessionStorage.setItem(shownKey, '1');
          } catch (_) {}
          triggered = true;
          card.hidden = false;
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'proactive_rfq_prompt', {
                event_category: 'conversion_intent',
                trigger_type: reason,
                page_path: window.location.pathname
              });
            }
          } catch (_) {}
        }

        function evaluateDwellTrigger() {
          if (triggered) return;
          maxScrollPct = Math.max(maxScrollPct, getScrollPct());
          var elapsedSec = (Date.now() - enterTs) / 1000;
          var totalSessionSec = (baseCumMs + (Date.now() - enterTs)) / 1000;
          var isDesktop = window.innerWidth > 768;
          if (isDesktop && ((elapsedSec >= 20 && maxScrollPct >= 25) || (totalSessionSec >= 24 && pageViewsCount >= 2))) {
            showProactive(pageViewsCount >= 2 ? 'desktop_multipages_24s' : 'desktop_20s_scroll25');
          } else if (!isDesktop && ((elapsedSec >= 28 && maxScrollPct >= 45) || (totalSessionSec >= 32 && pageViewsCount >= 2))) {
            showProactive(pageViewsCount >= 2 ? 'mobile_multipages_32s' : 'mobile_28s_scroll45');
          }
        }

        window.addEventListener('scroll', function () {
          maxScrollPct = Math.max(maxScrollPct, getScrollPct());
          evaluateDwellTrigger();
        }, { passive: true });

        setTimeout(evaluateDwellTrigger, 6500);
        setTimeout(evaluateDwellTrigger, 20200);
        setTimeout(evaluateDwellTrigger, 28200);

        document.addEventListener('mouseleave', function (e) {
          if (triggered || window.innerWidth <= 768) return;
          if (e.clientY <= 8 && Date.now() - enterTs >= 12000) {
            showProactive('desktop_exit_intent');
          }
        });
      })();

      // Multi-SKU Wholesale & Paid Sample Quote Shortlist Controller
      (function () {
        var STORAGE_KEY = 'fs_quote_shortlist';
        var QTY_TIERS = [1, 50, 100, 200, 500, 1000];
        var bar = document.getElementById('quote-shortlist-bar');
        var countEl = document.getElementById('shortlist-count');
        var totalPcsEl = document.getElementById('shortlist-total-pcs');
        var itemsEl = document.getElementById('shortlist-items');
        var quoteLink = document.getElementById('shortlist-quote-link');
        var waLink = document.getElementById('shortlist-wa-link');
        var clearBtn = document.getElementById('shortlist-clear-btn');
        var totalLabel = (bar && bar.getAttribute('data-total-label')) || 'Total';
        var pcsLabel = (bar && bar.getAttribute('data-pcs-label')) || 'pcs';

        function normalizeQty(val) {
          var n = parseInt(String(val || '').replace(/,/g, ''), 10);
          return !isNaN(n) && n >= 1 ? Math.min(n, 999999) : 50;
        }

        function stepShortlistQty(curr, dir) {
          var q = normalizeQty(curr);
          if (dir > 0) {
            for (var i = 0; i < QTY_TIERS.length; i++) {
              if (QTY_TIERS[i] > q) return QTY_TIERS[i];
            }
            return q + 500;
          }
          for (var j = QTY_TIERS.length - 1; j >= 0; j--) {
            if (QTY_TIERS[j] < q) return QTY_TIERS[j];
          }
          return 1;
        }

        function readList() {
          try {
            var arr = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            if (!Array.isArray(arr)) return [];
            return arr
              .filter(function (it) { return it && it.sku; })
              .map(function (it) {
                return {
                  sku: String(it.sku),
                  title: it.title ? String(it.title).slice(0, 60) : '',
                  price: it.price ? String(it.price) : '',
                  qty: normalizeQty(it.qty)
                };
              });
          } catch (_) {
            return [];
          }
        }
        function saveList(list) {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, 12)));
          } catch (_) {}
        }

        function syncShortlistUI() {
          var list = readList();
          var skuSet = {};
          list.forEach(function (it) { skuSet[it.sku] = true; });

          document.querySelectorAll('.shortlist-toggle-btn').forEach(function (btn) {
            var sku = btn.getAttribute('data-shortlist-sku') || '';
