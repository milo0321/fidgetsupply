      // GA4 rfq_form_start focus telemetry + Session-Capped Engaged-Reader / Exit-Intent Price-Sheet Prompt
      (function () {
        var rfqStartSent = false;
        document.addEventListener('focusin', function (e) {
          if (rfqStartSent) return;
          var inp = e.target && e.target.closest ? e.target.closest('.inline-qrfq-input, #contact-form input, #contact-form textarea, #contact-form select') : null;
          if (!inp) return;
