            var title = toggleBtn.getAttribute('data-shortlist-title') || '';
            var price = toggleBtn.getAttribute('data-shortlist-price') || '';
            var list = readList();
            var idx = -1;
            for (var i = 0; i < list.length; i++) {
              if (list[i].sku === sku) { idx = i; break; }
