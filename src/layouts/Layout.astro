---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import { getLanguageFromURL, getLocalizedPath, getDirection, getHreflangTags, useTranslations, getMicroHookLabels } from '../i18n/utils';
import { languages, type SupportedLanguage } from '../i18n/config';
import '../styles/global.css';
import '../styles/rtl.css';

interface Props {
  title: string;
  description: string;
  lang?: SupportedLanguage;
  dir?: 'ltr' | 'rtl';
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  preloadImage?: string;
  activePage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  dir,
  keywords = 'metal fidget slider wholesale, custom logo fidget toys, haptic fidget coin bulk, tuning fork fidget slider, CNC stainless steel EDC fidget supply chain, China metal fidget sourcing platform',
  canonical = Astro.url.href,
  ogImage = 'https://fidgetsupply.com/images/hero-metal-edc-showcase.webp',
  preloadImage,
  activePage = '',
  jsonLd,
  noindex = false
} = Astro.props;

const currentLang = (lang || getLanguageFromURL(Astro.url.pathname) || 'en') as SupportedLanguage;
const currentDir = dir || getDirection(currentLang);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const langConfig = languages[currentLang];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || 'G-HHP8CN1M58';
const gtmId = 'GTM-TH9NHVJ4';
const turnstileSiteKey = (
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.TURNSTILE_SITE_KEY ||
  (typeof process !== 'undefined' ? process.env?.PUBLIC_TURNSTILE_SITE_KEY || process.env?.TURNSTILE_SITE_KEY : '') ||
  '0x4AAAAAAF1GTaPVmYSNUcHS'
).trim();

function htmlEncodedLen(s: string): number {
  return (
    s.length +
    (s.match(/&/g) || []).length * 4 +
    (s.match(/[<>]/g) || []).length * 3
  );
}

function calibrateSeoTitle(raw: string, langCode: SupportedLanguage): string {
  let clean = (raw || '').replace(/\s+/g, ' ').trim();
  if (langCode === 'en') {
    if (htmlEncodedLen(clean) > 60) {
      clean = clean.replace(/\s&\s/g, ' + ');
    }
    if (htmlEncodedLen(clean) > 60) {
      clean = clean.replace(/\s*\|\s*FidgetSupply(\.com)?$/i, '').trim();
    }
    return clean;
  }

  // Strip redundant brand suffix and non-price parenthetical notes on localized pages to save character budget
  clean = clean
    .replace(/\s*\|\s*FidgetSupply(\.com)?$/i, '')
    .replace(/\s*\((?!\$)[^)]+\)$/, '')
    .replace(/\s&\s/g, ' + ')
    .trim();

  const suffix = ` · ${langCode.toUpperCase()}`;
  const maxBase = 60 - suffix.length; // 55 chars
  if (htmlEncodedLen(clean) > maxBase) {
    if (clean.includes(' ') && !['ja'].includes(langCode)) {
      const words = clean.split(' ');
      let acc = '';
      for (const w of words) {
        const next = acc ? `${acc} ${w}` : w;
        if (htmlEncodedLen(next) <= maxBase) {
          acc = next;
        } else {
          break;
        }
      }
      clean = (acc || clean.slice(0, maxBase))
        .replace(/[\s:,\-–—/+|&·.]+$/, '')
        .replace(/\s+(vs\.?|y|i|e|et|und|en|og|och|ja|против|dan|및|para|per|pour|für|voor|til|de|del|di|da|do|la|le|les|el|a|à)$/i, '')
        .replace(/\s+(para|per|pour|de|del|di)$/i, '')
        .replace(/[\s:,\-–—/+|&·.]+$/, '');
    } else {
      clean = clean.slice(0, maxBase).replace(/[\s:,\-–—/+|&·、。.]+$/, '');
    }
  }
  let result = `${clean}${suffix}`;
  if (result.length < 35 && htmlEncodedLen(`${clean} | FidgetSupply${suffix}`) <= 60) {
    result = `${clean} | FidgetSupply${suffix}`;
  }
  return result;
}

function calibrateSeoDescription(raw: string, langCode: SupportedLanguage): string {
  let clean = (raw || '').replace(/\s+/g, ' ').trim();
  if (langCode === 'en') {
    if (htmlEncodedLen(clean) > 155) {
      clean = clean.replace(/\s&\s/g, ' + ');
    }
    return clean;
  }

  clean = clean.replace(/\s&\s/g, ' + ');
  const prefix = `[${langCode.toUpperCase()}] `;
  let full = clean.startsWith('[') ? clean : `${prefix}${clean}`;
  if (full.length < 80) {
    full = `${full.replace(/[。.]+$/, '')} · 140 Ready Metal Molds, $0 Tooling, MOQ 50–100 pcs | FidgetSupply.com.`;
  }
  if (htmlEncodedLen(full) <= 154) {
    return full;
  }
  const maxLen = 153;
  if (full.includes(' ') && !['ja'].includes(langCode)) {
    const words = full.split(' ');
    let acc = '';
    for (const w of words) {
      const next = acc ? `${acc} ${w}` : w;
      if (htmlEncodedLen(next) <= maxLen) {
        acc = next;
      } else {
        break;
      }
    }
    clean = (acc || full.slice(0, maxLen)).replace(/[\s:,\-–—/+|&.]+$/, '') + '.';
  } else {
    const endChar = langCode === 'ja' ? '。' : '.';
    clean = full.slice(0, maxLen).replace(/[\s:,\-–—/+|&.、。]+$/, '') + endChar;
  }
  return clean;
}

const localizedTitle = calibrateSeoTitle(title, currentLang);
const localizedDescription = calibrateSeoDescription(description, currentLang);

const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `https://fidgetsupply.com${ogImage}`;

function toCleanCanonical(raw: string): string {
  if (!raw) return 'https://fidgetsupply.com';
  try {
    const parsed = new URL(raw, 'https://fidgetsupply.com');
    parsed.protocol = 'https:';
    parsed.hostname = 'fidgetsupply.com';
    parsed.search = '';
    parsed.hash = '';
    if (parsed.pathname.length > 1 && parsed.pathname.endsWith('/')) {
      parsed.pathname = parsed.pathname.slice(0, -1);
    }
    return parsed.toString().replace(/\/+$/, '');
  } catch {
    return raw.replace(/\/+$/, '');
  }
}

const cleanCanonical = toCleanCanonical(canonical);
const hreflangTags = getHreflangTags(Astro.url);
const defaultCanonical = hreflangTags.find((tag) => tag.lang === 'en')?.href || cleanCanonical;

const waUrl =
  'https://wa.me/8618750126315?text=Hello%20FidgetSupply%2C%20I%20would%20like%20to%20inquire%20about%20wholesale%20metal%20fidgets%20and%20custom%20logo%20pricing.';

const defaultSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://fidgetsupply.com/#organization',
    name: 'FidgetSupply.com',
    alternateName: ['FidgetSupply', 'FidgetSupply by Ruixing Gifts'],
    description:
      "Your integrated sourcing & supply chain platform for China's metal EDC fidget & kinetic desk toy industry.",
    url: 'https://fidgetsupply.com',
    logo: 'https://fidgetsupply.com/logo.svg',
    parentOrganization: {
      '@type': 'Organization',
      name: 'Ruixing Gifts',
      url: 'https://ruixinggifts.com'
    },
    sameAs: [
      'https://ruixinggifts.com',
      'https://carrysourcing.com',
      'https://ecopacksourcing.com',
      'https://cafesupplychain.com',
      'https://medalpinsupply.com'
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Fuzhou Industrial Zone',
      addressLocality: 'Fuzhou',
      addressRegion: 'Fujian',
      addressCountry: 'CN'
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86-187-5012-6315',
      contactType: 'Wholesale & custom branding sourcing desk',
      email: 'sales@fidgetsupply.com',
      availableLanguage: [
        'English', 'German', 'French', 'Dutch', 'Spanish', 'Italian', 'Portuguese',
        'Swedish', 'Danish', 'Norwegian', 'Finnish', 'Polish', 'Czech',
        'Russian', 'Japanese', 'Korean', 'Indonesian', 'Arabic'
      ]
    },
    knowsAbout: [
      'Magnetic Haptic Fidget Sliders Supply Chain',
      'Multi-Action Mechanical EDC Toys',
      'Metal Fidget Spinners & Desktop Gyroscopes',
      'Metal Haptic Clicker Coins',
      'Acoustic Tuning Fork Fidget Sliders',
      'CNC 304/316 Stainless Steel, PEI Ultem & Zirconium Machining',
      'US CPSC 16 CFR 1262 Magnet Retention Safety Compliance'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://fidgetsupply.com/#website',
    url: 'https://fidgetsupply.com',
    name: "FidgetSupply.com — Your Integrated Sourcing & Supply Chain Platform for China's Metal EDC Fidget Industry",
    inLanguage: currentLang,
    publisher: { '@id': 'https://fidgetsupply.com/#organization' }
  }
];

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...defaultSchemas, ...extraSchemas];
---

<!doctype html>
<html lang={currentLang} dir={currentDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{localizedTitle}</title>
    <meta name="description" content={localizedDescription} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={cleanCanonical} />
    {hreflangTags.map((tag) => (
      <link rel="alternate" hreflang={tag.hreflang} href={tag.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt Catalog Summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-Full.txt Complete Knowledge Corpus" />
    <link rel="indexnow" href="/f4a8b9c2d1e07365a9b8c7d6e5f4a3b2.txt" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Factory Metadata -->
    <meta name="geo.region" content="CN-35" />
    <meta name="geo.placename" content="Fuzhou Industrial Zone, Fujian, China" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={localizedTitle} />
    <meta property="og:description" content={localizedDescription} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="FidgetSupply.com" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={localizedTitle} />
    <meta name="twitter:description" content={localizedDescription} />
    <meta name="twitter:image" content={fullOgImageUrl} />
  </head>
  <body>
    <Header activePage={activePage} currentLang={currentLang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer currentLang={currentLang} />

    {activePage !== 'contact' && (
      <aside id="proactive-sheet-card" class="proactive-sheet-card" hidden aria-label={microHooks.getFullSheetPdf}>
        <button type="button" class="proactive-sheet-close" id="proactive-sheet-close" aria-label="Close">&times;</button>
        <form class="inline-quick-sheet-form proactive-inline-form" data-inline-sku="Proactive Engaged Buyer — Full 140-SKU Price Sheet & Sample Quote" novalidate>
          <div class="proactive-sheet-head">
            <strong>{microHooks.getFullSheetPdf}</strong>
            <span>{microHooks.mixMoqBadge}</span>
          </div>
          <div class="proactive-sheet-row">
            <input
              type="email"
              class="inline-qrfq-input proactive-sheet-input"
              placeholder={microHooks.pdpInputPlaceholder}
              aria-label={t('contact.workEmail')}
              required
            />
            <button type="submit" class="inline-qrfq-btn proactive-sheet-btn">
              {microHooks.pdpDirectSendBtn}
            </button>
          </div>
          <div class="inline-qrfq-status" hidden>{microHooks.pdpSentConfirm}</div>
        </form>
      </aside>
    )}

    {activePage !== 'contact' && (
      <aside
        id="quote-shortlist-bar"
        class="quote-shortlist-bar"
        data-total-label={microHooks.totalLabel}
        data-pcs-label={t('unit.pcs')}
        hidden
        aria-live="polite"
      >
        <div class="shortlist-head">
          <div class="shortlist-title">
            <span class="shortlist-count-pill" id="shortlist-count">0</span>
            <span>{microHooks.shortlistTitle}</span>
            <span class="shortlist-total-pcs" id="shortlist-total-pcs"></span>
          </div>
          <button type="button" class="shortlist-clear-btn" id="shortlist-clear-btn">{microHooks.shortlistClear}</button>
        </div>
        <div class="shortlist-items" id="shortlist-items"></div>
        <div class="shortlist-actions">
          <a
            id="shortlist-quote-link"
            href={getLocalizedPath('/contact', currentLang)}
            data-rfq-sku=""
            data-rfq-mode="Blank Stock (MOQ 50 pcs)"
            data-rfq-qty="50"
            class="shortlist-btn-primary"
          >
            {microHooks.shortlistQuoteBtn}
          </a>
          <a
            id="shortlist-wa-link"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shortlist-btn-wa"
          >
            💬 WhatsApp
          </a>
        </div>
      </aside>
    )}

    <!-- Ruixing Gifts Interactive Floating WhatsApp Button & Chat Modal -->
    <WhatsAppWidget currentLang={currentLang} />

    <!-- Structured Data (JSON-LD) placed at end of body for faster Cold-Start HTML head parsing -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Instant Page Navigation Prefetch (Chromium Speculation Rules API) -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/contact*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- GA4 Telemetry (G-HHP8CN1M58) — Strict Production Hostname Guard + Post-LCP Idle Load -->
    <script is:inline define:vars={{ gaMeasurementId }}>
      (function () {
        var isProdHost = /^(www\.)?fidgetsupply\.com$/i.test(window.location.hostname);
        window.dataLayer = window.dataLayer || [];
        function gtag(){
          if (!isProdHost) return;
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        if (!isProdHost) return;
        gtag('js', new Date());
        gtag('config', gaMeasurementId, {
          send_page_view: true,
          anonymize_ip: true
        });
        var loaded = false;
        var startTs = Date.now();
        var triggerEvents = ['pointermove', 'mousemove', 'touchstart', 'pointerdown', 'scroll', 'keydown'];
        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          triggerEvents.forEach(function (ev) {
            window.removeEventListener(ev, loadAnalytics, { passive: true });
          });
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
          document.head.appendChild(gaScript);
        }
        triggerEvents.forEach(function (ev) {
          window.addEventListener(ev, loadAnalytics, { once: true, passive: true });
        });
        function scheduleIdleLoad() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadAnalytics, { timeout: 900 });
          } else {
            setTimeout(loadAnalytics, 800);
          }
        }
        if (document.readyState === 'complete') {
          scheduleIdleLoad();
        } else {
          window.addEventListener('load', scheduleIdleLoad, { once: true });
        }

        // Track scroll milestones (25% & 50%) and active reading dwell so desktop sessions register accurate engagement
        var scrolled25 = false;
        var scrolled50 = false;
        window.addEventListener('scroll', function () {
          var docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
          if (docHeight <= 0) return;
          var pct = (window.scrollY / docHeight) * 100;
          var elapsedMs = Math.max(100, Date.now() - startTs);
          if (!scrolled25 && pct >= 25) {
            scrolled25 = true;
            gtag('event', 'scroll_depth', { percent_scrolled: 25, page_path: window.location.pathname, engagement_time_msec: elapsedMs });
          }
          if (!scrolled50 && pct >= 50) {
            scrolled50 = true;
            gtag('event', 'scroll_depth', { percent_scrolled: 50, page_path: window.location.pathname, engagement_time_msec: elapsedMs });
          }
        }, { passive: true });

        // 8-second & 12-second active reading heartbeats (12s guarantees >10.0s after deferred gtag.js load so GA4 registers engagedSession=1)
        setTimeout(function () {
          if (document.visibilityState !== 'hidden') {
            loadAnalytics();
            gtag('event', 'engaged_read_8s', {
              page_path: window.location.pathname,
              dwell_seconds: 8,
              engagement_time_msec: 8000
            });
          }
        }, 8000);
        setTimeout(function () {
          if (document.visibilityState !== 'hidden') {
            loadAnalytics();
            gtag('event', 'engaged_read_8s', {
              page_path: window.location.pathname,
              dwell_seconds: 12,
              engagement_time_msec: 12000
            });
          }
        }, 12000);

        // Track product / collection / quote CTA clicks
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('/products/') !== -1 || href.indexOf('/collections/') !== -1 || href.indexOf('/contact') !== -1 || href.indexOf('/custom-branding') !== -1 || href.indexOf('wa.me') !== -1) {
            loadAnalytics();
            gtag('event', 'wholesale_navigation_click', {
              link_url: href,
              source_path: window.location.pathname
            });
          }
        }, { passive: true });

        // Flush dwell time when tab hides or navigates away
        var dwellSent = false;
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden' && !dwellSent) {
            var sec = Math.round((Date.now() - startTs) / 1000);
            if (sec >= 4) {
              dwellSent = true;
              gtag('event', 'page_dwell', {
                page_path: window.location.pathname,
                dwell_seconds: sec,
                transport_type: 'beacon'
              });
            }
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        try {
          var storage = window.localStorage || window.sessionStorage;
          if (!storage) return;
          var now = Date.now();
          var currentPath = window.location.pathname + window.location.search;
          var pageId = 'v_' + now + '_' + Math.random().toString(36).slice(2, 6);
          function recordStep(id, path, startTime) {
            try {
              var duration = Math.max(1, Math.round((Date.now() - startTime) / 1000));
              var raw = storage.getItem('rx_journey_history') || '[]';
              var list = JSON.parse(raw);
              if (!Array.isArray(list)) list = [];
              list.push({ id: id, path: path, duration: duration, t: Date.now() });
              if (list.length > 20) list = list.slice(-20);
              storage.setItem('rx_journey_history', JSON.stringify(list));
            } catch (_) {}
          }
          var prevRaw = storage.getItem('rx_active_page');
          if (prevRaw) {
            var prev = JSON.parse(prevRaw);
            if (prev && prev.id && prev.startTime && prev.path !== currentPath) {
              recordStep(prev.id, prev.path, prev.startTime);
            }
          }
          storage.setItem('rx_active_page', JSON.stringify({ id: pageId, path: currentPath, startTime: now }));

          window.getRxBrowsingJourneySnapshot = function () {
            try {
              var rawList = storage.getItem('rx_journey_history') || '[]';
              var journey = JSON.parse(rawList);
              if (!Array.isArray(journey)) journey = [];
              var activeRaw = storage.getItem('rx_active_page');
              if (activeRaw) {
                var active = JSON.parse(activeRaw);
                if (active && active.path) {
                  var liveDur = Math.max(1, Math.round((Date.now() - (active.startTime || now)) / 1000));
                  journey = journey.concat([{ id: active.id || pageId, path: active.path, duration: liveDur, isCurrent: true }]);
                }
              }
              return journey.slice(-20);
            } catch (_) {
              return [];
            }
          };

          window.dispatchWhatsAppLeadTelemetry = function (opts) {
            try {
              opts = opts || {};
              var nowTs = Date.now();
              if (window.__lastWaTrackTs && nowTs - window.__lastWaTrackTs < 1500) {
                return;
              }
              window.__lastWaTrackTs = nowTs;

              var h1Text = (document.querySelector('h1') && document.querySelector('h1').innerText.trim()) || '';
              var titleClean = (document.title || '').split('|')[0].split(' - ')[0].trim();
              var skuEl = document.getElementById('display-sku');
              var skuText = skuEl ? skuEl.innerText.replace('SKU:', '').trim() : '';
              var defaultProd = skuText
                ? skuText + (h1Text ? ' - ' + h1Text : '')
                : (h1Text || titleClean || 'Wholesale Metal EDC Fidgets');

              var savedEmail = '';
              var savedName = '';
              var savedCompany = '';
              try {
                savedEmail = opts.userEmail || storage.getItem('rx_user_email') || '';
                savedName = opts.userName || storage.getItem('rx_user_name') || '';
                savedCompany = opts.userCompany || storage.getItem('rx_user_company') || '';
              } catch (_) {}

              var urlParams = new URLSearchParams(window.location.search);
              var timeSpentSec = Math.max(1, Math.round((nowTs - now) / 1000)) + 's';
              var journeySnapshot = typeof window.getRxBrowsingJourneySnapshot === 'function' ? window.getRxBrowsingJourneySnapshot() : [];

              if (typeof window.gtag === 'function') {
                window.gtag('event', 'generate_lead', {
                  event_category: 'engagement',
                  event_label: 'whatsapp_chat_initiated',
                  page_location: window.location.href,
                  page_title: document.title
                });
              }

              fetch('/api/whatsapp-track', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  event: 'message_sent',
                  triggerSource: opts.triggerSource || 'WhatsApp Direct Click',
                  userEmail: savedEmail,
                  userName: savedName,
                  userCompany: savedCompany,
                  pageUrl: window.location.href,
                  pagePath: window.location.pathname,
                  pageTitle: document.title,
                  productName: opts.productName || defaultProd,
                  messageText: opts.messageText || '',
                  browsingJourney: JSON.stringify(journeySnapshot),
                  pageReferrer: document.referrer || 'Direct Visit',
                  browserLanguage: navigator.language || 'en',
                  screenResolution: window.screen.width + 'x' + window.screen.height + ' (' + (window.devicePixelRatio || 1) + 'x DPR)',
                  clientTimezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
                  clientLocalTime: new Date().toLocaleString(),
                  timeOnPageSeconds: timeSpentSec,
                  utmSource: urlParams.get('utm_source') || '',
                  utmMedium: urlParams.get('utm_medium') || '',
                  utmCampaign: urlParams.get('utm_campaign') || '',
                  utmTerm: urlParams.get('utm_term') || '',
                  utmContent: urlParams.get('utm_content') || ''
                }),
                keepalive: true
              }).catch(function () {});
            } catch (_) {}
          };
        } catch (_) {}
      })();
    </script>

    <!-- Global Accordion, Language Picker & GA4 Full-Funnel Event Delegation -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        function trackGaEvent(eventName, params) {
          try {
