              list.push({ sku: sku, title: title.slice(0, 60), price: price, qty: initQty });
            }
            saveList(list);
            syncShortlistUI();
            try {
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'shortlist_toggle', {
                  event_category: 'conversion_intent',
                  action: action,
                  sku: sku,
                  list_size: list.length,
                  source_path: window.location.pathname
                });
              }
            } catch (_) {}
            return;
          }

          var qtyStepBtn = e.target && e.target.closest ? e.target.closest('.shortlist-qty-btn') : null;
          if (qtyStepBtn) {
            var qSku = qtyStepBtn.getAttribute('data-qty-sku') || '';
            var dir = parseInt(qtyStepBtn.getAttribute('data-qty-dir') || '1', 10);
            var list = readList();
            for (var j = 0; j < list.length; j++) {
              if (list[j].sku === qSku) {
                list[j].qty = stepShortlistQty(list[j].qty, dir);
                break;
              }
            }
            saveList(list);
            syncShortlistUI();
            return;
          }

          var rmBtn = e.target && e.target.closest ? e.target.closest('.shortlist-chip-remove') : null;
          if (rmBtn) {
            var rmSku = rmBtn.getAttribute('data-remove-sku') || '';
            var filtered = readList().filter(function (it) { return it.sku !== rmSku; });
            saveList(filtered);
            syncShortlistUI();
            return;
          }
        });

        document.addEventListener('change', function (e) {
          var qtyIn = e.target && e.target.classList && e.target.classList.contains('shortlist-qty-input') ? e.target : null;
          if (!qtyIn) return;
          var sku = qtyIn.getAttribute('data-qty-input-sku') || '';
          var list = readList();
          for (var i = 0; i < list.length; i++) {
            if (list[i].sku === sku) {
              list[i].qty = normalizeQty(qtyIn.value);
              break;
            }
          }
          saveList(list);
          syncShortlistUI();
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            saveList([]);
            syncShortlistUI();
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncShortlistUI);
        } else {
          syncShortlistUI();
        }
      })();
    </script>
  </body>
</html>
