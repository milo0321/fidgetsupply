---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import { getLanguageFromURL, getDirection, getHreflangTags, useTranslations } from '../i18n/utils';
import { languages, type SupportedLanguage } from '../i18n/config';
import '../styles/global.css';
import '../styles/rtl.css';

interface Props {
  title: string;
  description: string;
  lang?: SupportedLanguage;
  dir?: 'ltr' | 'rtl';
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  preloadImage?: string;
  activePage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  dir,
  keywords = 'metal fidget slider wholesale, custom logo fidget toys, haptic fidget coin bulk, tuning fork fidget slider, CNC stainless steel EDC fidget supply chain, China metal fidget sourcing platform',
  canonical = Astro.url.href,
  ogImage = 'https://fidgetsupply.com/images/hero-metal-edc-showcase.webp',
  preloadImage,
  activePage = '',
  jsonLd,
  noindex = false
} = Astro.props;

const currentLang = (lang || getLanguageFromURL(Astro.url.pathname) || 'en') as SupportedLanguage;
const currentDir = dir || getDirection(currentLang);
const t = useTranslations(currentLang);
const langConfig = languages[currentLang];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || 'G-HHP8CN1M58';
const gtmId = 'GTM-TH9NHVJ4';

function htmlEncodedLen(s: string): number {
  return (
    s.length +
    (s.match(/&/g) || []).length * 4 +
    (s.match(/[<>]/g) || []).length * 3
  );
}

function calibrateSeoTitle(raw: string, langCode: SupportedLanguage): string {
  let clean = (raw || '').replace(/\s+/g, ' ').trim();
  if (langCode === 'en') {
    if (htmlEncodedLen(clean) > 60) {
      clean = clean.replace(/\s&\s/g, ' + ');
    }
    if (htmlEncodedLen(clean) > 60) {
      clean = clean.replace(/\s*\|\s*FidgetSupply(\.com)?$/i, '').trim();
    }
    return clean;
  }

  // Strip redundant brand suffix on localized pages to save character budget
  clean = clean
    .replace(/\s*\|\s*FidgetSupply(\.com)?$/i, '')
    .replace(/\s*\([^)]+\)$/, '')
    .replace(/\s&\s/g, ' + ')
    .trim();

  const suffix = ` · ${langCode.toUpperCase()}`;
  const maxBase = 60 - suffix.length; // 55 chars
  if (htmlEncodedLen(clean) > maxBase) {
    if (clean.includes(' ') && !['ja'].includes(langCode)) {
      const words = clean.split(' ');
      let acc = '';
      for (const w of words) {
        const next = acc ? `${acc} ${w}` : w;
        if (htmlEncodedLen(next) <= maxBase) {
          acc = next;
        } else {
          break;
        }
      }
      clean = (acc || clean.slice(0, maxBase))
        .replace(/[\s:,\-–—/+|&]+$/, '')
        .replace(/\s+(vs\.?|y|i|e|et|und|en|og|och|ja|против|dan|및)$/i, '');
    } else {
      clean = clean.slice(0, maxBase).replace(/[\s:,\-–—/+|&、。]+$/, '');
    }
  }
  let result = `${clean}${suffix}`;
  if (result.length < 35 && htmlEncodedLen(`${clean} | FidgetSupply${suffix}`) <= 60) {
    result = `${clean} | FidgetSupply${suffix}`;
  }
  return result;
}

function calibrateSeoDescription(raw: string, langCode: SupportedLanguage): string {
  let clean = (raw || '').replace(/\s+/g, ' ').trim();
  if (langCode === 'en') {
    if (htmlEncodedLen(clean) > 155) {
      clean = clean.replace(/\s&\s/g, ' + ');
    }
    return clean;
  }

  clean = clean.replace(/\s&\s/g, ' + ');
  const prefix = `[${langCode.toUpperCase()}] `;
  let full = clean.startsWith('[') ? clean : `${prefix}${clean}`;
  if (full.length < 80) {
    full = `${full.replace(/[。.]+$/, '')} · 140 Ready Metal Molds, $0 Tooling, MOQ 50–100 pcs | FidgetSupply.com.`;
  }
  if (htmlEncodedLen(full) <= 154) {
    return full;
  }
  const maxLen = 153;
  if (full.includes(' ') && !['ja'].includes(langCode)) {
    const words = full.split(' ');
    let acc = '';
    for (const w of words) {
      const next = acc ? `${acc} ${w}` : w;
      if (htmlEncodedLen(next) <= maxLen) {
        acc = next;
      } else {
        break;
      }
    }
    clean = (acc || full.slice(0, maxLen)).replace(/[\s:,\-–—/+|&.]+$/, '') + '.';
  } else {
    const endChar = langCode === 'ja' ? '。' : '.';
    clean = full.slice(0, maxLen).replace(/[\s:,\-–—/+|&.、。]+$/, '') + endChar;
  }
  return clean;
}

const localizedTitle = calibrateSeoTitle(title, currentLang);
const localizedDescription = calibrateSeoDescription(description, currentLang);

const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `https://fidgetsupply.com${ogImage}`;

function toCleanCanonical(raw: string): string {
  if (!raw) return 'https://fidgetsupply.com';
  try {
    const parsed = new URL(raw, 'https://fidgetsupply.com');
    parsed.protocol = 'https:';
    parsed.hostname = 'fidgetsupply.com';
    parsed.search = '';
    parsed.hash = '';
    if (parsed.pathname.length > 1 && parsed.pathname.endsWith('/')) {
      parsed.pathname = parsed.pathname.slice(0, -1);
    }
    return parsed.toString();
  } catch {
    return raw.replace(/\/+$/, '');
  }
}

const cleanCanonical = toCleanCanonical(canonical);
const hreflangTags = getHreflangTags(Astro.url);
const defaultCanonical = hreflangTags.find((tag) => tag.lang === 'en')?.href || cleanCanonical;

const waUrl =
  'https://wa.me/8618750126315?text=Hello%20FidgetSupply%2C%20I%20would%20like%20to%20inquire%20about%20wholesale%20metal%20fidgets%20and%20custom%20logo%20pricing.';

const defaultSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://fidgetsupply.com/#organization',
    name: 'FidgetSupply.com',
    description:
      "Your integrated sourcing & supply chain platform for China's metal EDC fidget & kinetic desk toy industry.",
    url: 'https://fidgetsupply.com',
    logo: 'https://fidgetsupply.com/logo.svg',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Fuzhou Industrial Zone',
      addressLocality: 'Fuzhou',
      addressRegion: 'Fujian',
      addressCountry: 'CN'
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86-187-5012-6315',
      contactType: 'Wholesale & custom branding sourcing desk',
      email: 'sales@fidgetsupply.com',
      availableLanguage: [
        'English', 'German', 'French', 'Dutch', 'Spanish', 'Italian', 'Portuguese',
        'Swedish', 'Danish', 'Norwegian', 'Finnish', 'Polish', 'Czech',
        'Russian', 'Japanese', 'Korean', 'Indonesian', 'Arabic'
      ]
    },
    knowsAbout: [
      'Magnetic Haptic Fidget Sliders Supply Chain',
      'Multi-Action Mechanical EDC Toys',
      'Metal Fidget Spinners & Desktop Gyroscopes',
      'Metal Haptic Clicker Coins',
      'Acoustic Tuning Fork Fidget Sliders',
      'CNC 304/316 Stainless Steel, PEI Ultem & Zirconium Machining',
      'US CPSC 16 CFR 1262 Magnet Retention Safety Compliance'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://fidgetsupply.com/#website',
    url: 'https://fidgetsupply.com',
    name: "FidgetSupply.com — Your Integrated Sourcing & Supply Chain Platform for China's Metal EDC Fidget Industry",
    inLanguage: currentLang,
    publisher: { '@id': 'https://fidgetsupply.com/#organization' }
  }
];

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...defaultSchemas, ...extraSchemas];
---

<!doctype html>
<html lang={currentLang} dir={currentDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{localizedTitle}</title>
    <meta name="description" content={localizedDescription} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={cleanCanonical} />
    {hreflangTags.map((tag) => (
      <link rel="alternate" hreflang={tag.hreflang} href={tag.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt Catalog Summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-Full.txt Complete Knowledge Corpus" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <!-- Factory Metadata -->
    <meta name="geo.region" content="CN-35" />
    <meta name="geo.placename" content="Fuzhou Industrial Zone, Fujian, China" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={localizedTitle} />
    <meta property="og:description" content={localizedDescription} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content="FidgetSupply.com" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={localizedTitle} />
    <meta name="twitter:description" content={localizedDescription} />
    <meta name="twitter:image" content={fullOgImageUrl} />
  </head>
  <body>
    <Header activePage={activePage} currentLang={currentLang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer currentLang={currentLang} />

    <!-- Ruixing Gifts Interactive Floating WhatsApp Button & Chat Modal -->
    <WhatsAppWidget currentLang={currentLang} />

    <!-- Structured Data (JSON-LD) placed at end of body for faster Cold-Start HTML head parsing -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Instant Page Navigation Prefetch (Chromium Speculation Rules API) -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/contact*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Google Tag Manager & GA4 (GTM-TH9NHVJ4 / G-HHP8CN1M58) — Deferred until post-LCP / interaction -->
    <script is:inline define:vars={{ gaMeasurementId, gtmId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaMeasurementId);
      (function () {
        var loaded = false;
        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach(function (ev) {
            window.removeEventListener(ev, loadAnalytics, { passive: true });
          });
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var gtmScript = document.createElement('script');
          gtmScript.async = true;
          gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          document.head.appendChild(gtmScript);
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
          document.head.appendChild(gaScript);
        }
        ['touchstart', 'pointerdown', 'scroll', 'keydown'].forEach(function (ev) {
          window.addEventListener(ev, loadAnalytics, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          setTimeout(loadAnalytics, 3200);
        });
      })();
    </script>

    <script is:inline>
      (function () {
        try {
          var storage = window.localStorage || window.sessionStorage;
          if (!storage) return;
          var now = Date.now();
          var currentPath = window.location.pathname + window.location.search;
          var pageId = 'v_' + now + '_' + Math.random().toString(36).slice(2, 6);
          function recordStep(id, path, startTime) {
            try {
              var duration = Math.max(1, Math.round((Date.now() - startTime) / 1000));
              var raw = storage.getItem('rx_journey_history') || '[]';
              var list = JSON.parse(raw);
              if (!Array.isArray(list)) list = [];
              list.push({ id: id, path: path, duration: duration, t: Date.now() });
              if (list.length > 20) list = list.slice(-20);
              storage.setItem('rx_journey_history', JSON.stringify(list));
            } catch (_) {}
          }
          var prevRaw = storage.getItem('rx_active_page');
          if (prevRaw) {
            var prev = JSON.parse(prevRaw);
            if (prev && prev.id && prev.startTime && prev.path !== currentPath) {
              recordStep(prev.id, prev.path, prev.startTime);
            }
          }
          storage.setItem('rx_active_page', JSON.stringify({ id: pageId, path: currentPath, startTime: now }));
        } catch (_) {}
      })();
    </script>

    <!-- Global Accordion, Language Picker & GA4 Full-Funnel Event Delegation -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        function trackGaEvent(eventName, params) {
          try {
            if (typeof window.gtag === 'function') {
              window.gtag('event', eventName, params || {});
            }
          } catch (_) {}
        }

        var waTarget = e.target.closest('a[href*="wa.me"], .wa-float-btn, .wa-send-btn, .wa-quick-chip');
        if (waTarget) {
          trackGaEvent('whatsapp_click', {
            event_category: 'conversion_intent',
            source_page: window.location.pathname,
            trigger_type: waTarget.className || 'wa_link'
          });
        }

        var rfqTarget = e.target.closest('a[href*="/contact"]');
        if (rfqTarget) {
          var rfqSku = rfqTarget.getAttribute('data-rfq-sku') || '';
          var rfqMode = rfqTarget.getAttribute('data-rfq-mode') || '';
          var rfqTopic = rfqTarget.getAttribute('data-rfq-topic') || '';
          var rfqQty = rfqTarget.getAttribute('data-rfq-qty') || '';
          if (rfqSku || rfqMode || rfqTopic || rfqQty) {
            try {
              var payload = JSON.stringify({ sku: rfqSku, mode: rfqMode, topic: rfqTopic, qty: rfqQty, ts: Date.now() });
              sessionStorage.setItem('fs_rfq_prefill', payload);
              localStorage.setItem('fs_rfq_prefill', payload);
            } catch (_) {}
          }
          trackGaEvent('rfq_cta_click', {
            event_category: 'conversion_intent',
            source_page: window.location.pathname,
            cta_text: (rfqTarget.textContent || '').trim().slice(0, 60),
            target_href: rfqTarget.getAttribute('href') || '/contact',
            rfq_sku: rfqSku,
            rfq_qty: rfqQty
          });
        }

        var radioCard = e.target.closest('#custom-radio-group .radio-card');
        if (radioCard) {
          var radioInput = radioCard.querySelector('input[type="radio"]');
          trackGaEvent('customization_select', {
            event_category: 'product_config',
            source_page: window.location.pathname,
            custom_mode: radioInput ? radioInput.value : 'custom'
          });
        }

        var variantBtn = e.target.closest('.variant-btn');
        if (variantBtn) {
          trackGaEvent('material_variant_select', {
            event_category: 'product_config',
            source_page: window.location.pathname,
            variant_sku: variantBtn.getAttribute('data-sku') || ''
          });
        }

        var header = e.target.closest('.accordion-header');
        if (header) {
          var item = header.closest('.accordion-item');
          if (item) {
            var willOpen = !item.classList.contains('active');
            item.classList.toggle('active');
            if (willOpen) {
              trackGaEvent('faq_expand', {
                event_category: 'engagement',
                source_page: window.location.pathname,
                question_text: (header.textContent || '').trim().slice(0, 80)
              });
            }
          }
          return;
        }

        var langBtn = e.target.closest('.lang-picker-btn');
        var allLangWrappers = document.querySelectorAll('.lang-picker-wrapper');
        if (langBtn) {
          var wrapper = langBtn.closest('.lang-picker-wrapper');
          var isOpen = wrapper && wrapper.classList.contains('active');
          allLangWrappers.forEach(function (w) { w.classList.remove('active'); });
          if (wrapper && !isOpen) {
            wrapper.classList.add('active');
          }
          return;
        }
        if (!e.target.closest('.lang-dropdown-menu')) {
          allLangWrappers.forEach(function (w) { w.classList.remove('active'); });
        }
      });
    </script>
  </body>
</html>
