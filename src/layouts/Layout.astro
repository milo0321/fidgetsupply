                statusEl.hidden = false;
              }
              var holder = inlineForm.querySelector('.inline-cf-turnstile-holder');
              if (holder) holder.innerHTML = '';
              try {
                if (typeof window.gtag === 'function') {
                  window.gtag('event', 'generate_lead', {
