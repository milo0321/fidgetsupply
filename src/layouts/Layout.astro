          var totalPcs = list.reduce(function (sum, it) { return sum + normalizeQty(it.qty); }, 0);
          bar.hidden = false;
          countEl.textContent = String(list.length);
          if (totalPcsEl) {
            totalPcsEl.textContent = '· ' + totalLabel + ': ' + totalPcs.toLocaleString() + ' ' + pcsLabel;
          }

          itemsEl.innerHTML = '';
          list.forEach(function (it) {
