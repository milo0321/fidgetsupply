---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { localizeProduct, getRelatedInsightSlugsForProduct } from '../../i18n/productLocalization';
import { localizeInsightMeta } from '../../i18n/insightAndCollectionLocalization';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const allGuides = await getCollection('insights');
  const sorted = products.sort((a, b) => a.data.rowId - b.data.rowId);

  return sorted.map((entry) => {
    const p = entry.data;
    const related = sorted
      .filter((other) => other.data.slug !== p.slug && other.data.primaryCollection === p.primaryCollection)
      .slice(0, 4);

    const targetGuideSlugs = getRelatedInsightSlugsForProduct(p);
    const relatedGuides = targetGuideSlugs
      .map((s) => allGuides.find((g) => g.data.slug === s))
      .filter(Boolean)
      .slice(0, 3);

    return {
      params: { slug: p.slug },
      props: { product: p, relatedProducts: related, relatedGuides }
    };
  });
}

const { product: p, relatedProducts, relatedGuides = [] } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const lp = localizeProduct(p, currentLang);
const rfqBaseUrl = getLocalizedPath('/contact', currentLang);

const allImages = p.galleryImages && p.galleryImages.length > 0 ? p.galleryImages : [p.featuredImage];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.skuDisplay} ${lp.title}`,
  sku: p.sku,
  mpn: p.sku,
  image: allImages.map((img: string) => `https://fidgetsupply.com${img}`),
  description: lp.overview,
  brand: {
    '@type': 'Brand',
    name: 'FidgetSupply.com'
  },
  material: lp.material,
  weight: {
    '@type': 'QuantitativeValue',
    value: parseFloat(p.weight) || 75,
    unitCode: 'GRM'
  },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: p.tier500,
    highPrice: p.tier50,
    offerCount: p.variants.length * 3,
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: 'FidgetSupply.com — Integrated China Metal EDC Supply Chain'
    }
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: lp.faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: 'https://fidgetsupply.com' },
    { '@type': 'ListItem', position: 2, name: t(`col.${p.primaryCollection}.short` as any), item: `https://fidgetsupply.com/collections/${p.primaryCollection}` },
    { '@type': 'ListItem', position: 3, name: `${p.skuDisplay} ${lp.title}`, item: `https://fidgetsupply.com/products/${p.slug}` }
  ]
};
---

<Layout
  title={lp.metaTitle}
  description={lp.metaDescription}
  ogImage={p.featuredImage}
  activePage="products"
  jsonLd={[productSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb Bar -->
  <div class="pdp-breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
        <span>/</span>
        <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
        <span>/</span>
        <a href={getLocalizedPath(`/collections/${p.primaryCollection}`, currentLang)}>{t(`col.${p.primaryCollection}.short` as any)}</a>
        <span>/</span>
        <strong>{p.skuDisplay}</strong>
      </nav>
      <div class="pdp-cross-links">
        {p.logoReady && (
          <a href={getLocalizedPath('/collections/custom-logo-metal-fidgets', currentLang)} class="cross-pill pill-logo">{t('nav.logoReady')}</a>
        )}
        {p.tuningFork && (
          <a href={getLocalizedPath('/collections/tuning-fork-fidget-sliders', currentLang)} class="cross-pill pill-tuning">{t('nav.tuningFork')}</a>
        )}
        {p.cncExotic && (
          <a href={getLocalizedPath('/collections/cnc-stainless-steel-pei-edc', currentLang)} class="cross-pill pill-cnc">{t('nav.cncExotic')}</a>
        )}
      </div>
    </div>
  </div>

  <!-- =====================================================================
       STAGE 1: Hero Gallery + SKU, 3-Tier Wholesale Pricing, Material Switcher & 4 Custom Radio Boxes
       ===================================================================== -->
  <section class="section pdp-stage-1">
    <div class="container pdp-hero-grid">
      <!-- Left: Product Gallery -->
      <div class="pdp-gallery">
        <div class="main-image-frame">
          <img
            id="pdp-main-img"
            src={p.featuredImage}
            alt={`${p.skuDisplay} ${p.title} - ${p.material}`}
            width="800"
            height="600"
          />
          <div class="frame-badges">
            <span class="sku-pill">{p.skuDisplay}</span>
            <span class="badge badge-emerald">{t('pdp.readyMold')} · #{p.rowId}</span>
          </div>
        </div>

        {allImages.length > 1 && (
          <div class="thumb-strip">
            {allImages.map((img: string, idx: number) => (
              <button
                type="button"
                class:list={['thumb-btn', { active: idx === 0 }]}
                data-img={img}
                aria-label={`View angle ${idx + 1}`}
              >
                <img src={img} alt={`${p.sku} view ${idx + 1}`} width="120" height="90" />
              </button>
            ))}
          </div>
        )}

        <!-- Quick Spec Highlights Under Image -->
        <div class="gallery-quick-kpis">
          <div class="qkpi">
            <span>{t('pdp.dimensions')}</span>
            <strong>{p.size}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.netWeight')}</span>
            <strong id="display-weight">{p.weight}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.blankMoq')}</span>
            <strong>50 {t('unit.pcs')}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.logoMoq')}</span>
            <strong>100 {t('unit.pcs')}</strong>
          </div>
        </div>
      </div>

      <!-- Right: Golden Stage-1 Wholesale Configuration & Pricing Panel -->
      <div class="pdp-config-panel">
        <div class="pdp-meta-top">
          <span class="sku-code-large" id="display-sku">SKU: {p.skuDisplay}</span>
          <span class="factory-ref">{t('pdp.prodMold')} #{String(p.rowId).padStart(3, '0')} · {t('pdp.readyMold')}</span>
        </div>

        <h1 class="pdp-title">{lp.title}</h1>

        <p class="pdp-short-overview">{lp.overview}</p>

        <!-- Multi-Material / Multi-Variant Switcher (For merged same-mold models like FS-114/115/132, FS-105/106, FS-107/112, FS-030/031, FS-094/095) -->
        {lp.variants && lp.variants.length > 1 && (
          <div class="variant-selector-box">
            <div class="selector-label">
              <strong>{t('pdp.variantSelectTitle')} ({lp.variants.length}):</strong>
              <span>{t('pdp.variantSelectSub')}</span>
            </div>
            <div class="variant-buttons">
              {lp.variants.map((v: any, idx: number) => (
                <button
                  type="button"
                  class:list={['variant-btn', { active: idx === 0 }]}
                  data-sku={v.sku}
                  data-material={v.materialLocalized}
                  data-weight={v.weight}
                  data-t50={v.tier50}
                  data-t200={v.tier200}
                  data-t500={v.tier500}
                  data-rmb={v.rmb}
                >
                  <span class="v-sku">{v.sku} · {v.materialLocalized.split('(')[0].trim()}</span>
                  <span class="v-price">${v.tier500} – ${v.tier50} ({v.weight})</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- 3-Tier Reference Factory-Direct Wholesale Price Table -->
        <div class="pricing-tiers-box">
          <div class="tiers-header">
            <span>{t('pdp.pricingTitle')}</span>
            <span class="tooling-free-tag">✓ {t('pdp.noMoldFee')}</span>
          </div>
          <div class="tiers-grid">
            <div class="tier-cell">
              <span class="tier-qty">50 – 199 {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-50">${p.tier50}</strong>
              <span class="tier-sub">{t('pdp.trialBatch')}</span>
            </div>
            <div class="tier-cell tier-popular">
              <span class="tier-qty">200 – 499 {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-200">${p.tier200}</strong>
              <span class="tier-sub">{t('pdp.customLogoStd')}</span>
            </div>
            <div class="tier-cell tier-best">
              <span class="tier-qty">500+ {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-500">${p.tier500}</strong>
              <span class="tier-sub">{t('pdp.volumeTier')}</span>
            </div>
          </div>
        </div>

        <!-- 4 Customization Radio Options -->
        <div class="custom-options-box">
          <div class="custom-options-title">
            <strong>{t('pdp.selectBranding')}</strong>
            <span>{t('pdp.readyMold')}</span>
          </div>

          <div class="radio-grid" id="custom-radio-group">
            <label class="radio-card active">
              <input type="radio" name="custom_mode" value="Blank Stock (MOQ 50 pcs)" checked />
              <div class="radio-info">
                <strong>{t('pdp.opt1Title')}</strong>
                <span>{t('pdp.opt1Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Fiber Laser Engraved Logo (MOQ 100 pcs)" />
              <div class="radio-info">
                <strong>{t('pdp.opt2Title')}</strong>
                <span>{t('pdp.opt2Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Deep Laser + Color Fill Logo (+$0.35-$0.60/pc)" />
              <div class="radio-info">
                <strong>{t('pdp.opt3Title')}</strong>
                <span>{t('pdp.opt3Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Custom Logo + Black EVA Zipper Case (MOQ 100 pcs)" />
              <div class="radio-info">
                <strong>{t('pdp.opt4Title')}</strong>
                <span>{t('pdp.opt4Desc')}</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Primary Conversion Buttons -->
        <div class="pdp-cta-row">
          <a
            id="pdp-rfq-btn"
            rel="nofollow"
            data-rfq-base={rfqBaseUrl}
            href={getLocalizedPath(`/contact?sku=${encodeURIComponent(p.sku)}&mode=Blank+Stock`, currentLang)}
            class="btn btn-primary btn-pdp-main"
          >
            {t('pdp.requestQuote')} ({p.sku}) →
          </a>
          <a
            href={`https://wa.me/8618750126315?text=${encodeURIComponent(`Hello FidgetSupply, I would like wholesale pricing & sample info for ${p.sku} (${p.title}).`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-pdp-sample"
          >
            {t('pdp.whatsappInquiry')}
          </a>
        </div>

        <div class="pdp-trust-strip">
          <span>{t('pdp.trust1')}</span>
          <span>{t('pdp.trust2')}</span>
          <span>{t('pdp.trust3')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       STAGE 2: Standard HTML Engineering Parameter Table (Factory Crawler Zone)
       ===================================================================== -->
  <section class="section section-light pdp-stage-2">
    <div class="container">
      <GeoDirectAnswer
        title={`${p.skuDisplay} ${lp.title} — ${t('pdp.specsTitle')}`}
        answer={lp.overview}
        metrics={[
          { label: 'SKU', value: p.skuDisplay },
          { label: t('card.material').replace(':', ''), value: lp.material.split('/')[0].trim() },
          { label: `${t('pdp.dimensions')} / ${t('pdp.netWeight')}`, value: `${p.size} / ${p.weight}` },
          { label: t('card.magnets').replace(':', ''), value: lp.magnets.slice(0, 36) }
        ]}
      />

      <div class="stage-2-grid">
        <div>
          <h2 class="stage-heading">{t('pdp.specsTitle')}</h2>
          <p class="stage-sub">
            {t('pdp.specsSub')}
          </p>
          <div class="geo-table-wrap">
            <table class="geo-table">
              <thead>
                <tr>
                  <th style="width: 34%;">{t('pdp.specColParam')}</th>
                  <th>{t('pdp.specColVal')} ({p.skuDisplay})</th>
                </tr>
              </thead>
              <tbody>
                {lp.specs.map(([key, val]) => (
                  <tr>
                    <td><strong>{key}</strong></td>
                    <td>{val}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {lp.variants && lp.variants.length > 1 && (
            <div style="margin-top: 2rem;">
              <h3 style="margin-bottom: 0.75rem; font-size: 1.15rem;">{t('pdp.variantMatrixTitle')}</h3>
              <div class="geo-table-wrap">
                <table class="geo-table">
                  <thead>
                    <tr>
                      <th>SKU</th>
                      <th>{t('card.material').replace(':', '')}</th>
                      <th>{t('pdp.dimensions')}</th>
                      <th>{t('pdp.netWeight')}</th>
                      <th>50–199</th>
                      <th>200–499</th>
                      <th>500+</th>
                    </tr>
                  </thead>
                  <tbody>
                    {lp.variants.map((v: any) => (
                      <tr>
                        <td><strong>{v.sku}</strong></td>
                        <td>{v.materialLocalized}</td>
                        <td>{v.size}</td>
                        <td>{v.weight}</td>
                        <td>${v.tier50}</td>
                        <td>${v.tier200}</td>
                        <td><strong>${v.tier500}</strong></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>

        <div class="features-column">
          <h2 class="stage-heading">{t('pdp.highlightsTitle')}</h2>
          <p class="stage-sub">{t('pdp.highlightsSub')}</p>
          <div class="feature-cards">
            {lp.features.map((feat: string) => (
              <div class="feat-card">
                <span class="feat-check">✓</span>
                <p>{feat}</p>
              </div>
            ))}
          </div>

          <!-- =====================================================================
               STAGE 3: Anti-Tooling Lock-In Declaration Box
               ===================================================================== -->
          <div class="anti-tooling-declaration">
            <div class="decl-badge">{t('pdp.declBadge')}</div>
            <h3>{t('pdp.declTitle')}</h3>
            <p class="decl-quote">
              "{t('pdp.declQuote')}"
            </p>
            <div class="decl-links">
              <a href={getLocalizedPath('/custom-branding', currentLang)}>{t('pdp.declLink1')}</a>
              <a href={getLocalizedPath('/custom-packaging', currentLang)}>{t('pdp.declLink2')}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Localized Product Technical Deep-Dive & Customization Article Section -->
      <div class="pdp-editorial-card clean-editorial-content" set:html={lp.editorialHtml} />
    </div>
  </section>

  <!-- Product FAQs -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <span class="badge">{t('pdp.faqBadge')}</span>
        <h2 class="section-title">{t('pdp.faqTitle')} — {p.skuDisplay}</h2>
      </div>
      <div class="faq-list">
        {lp.faqs.map((faq: any, idx: number) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Products in Same Collection -->
  {relatedProducts.length > 0 && (
    <section class="section section-light">
      <div class="container">
        <div class="section-header-center">
          <span class="badge">{t('pdp.relatedBadge')}</span>
          <h2 class="section-title">{t('pdp.relatedTitle')}</h2>
        </div>
        <div class="grid-4">
          {relatedProducts.map((rel: any) => (
            <ProductCard product={rel} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Engineering & Sourcing Insights (Bidirectional Mesh) -->
  {relatedGuides.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header-center">
          <span class="badge">{t('guide.continueBadge')}</span>
          <h2 class="section-title">{t('guide.relatedGuidesTitle')}</h2>
        </div>
        <div class="pdp-guides-grid">
          {relatedGuides.map((rg: any) => {
            const rgLoc = localizeInsightMeta(rg.data, currentLang);
            return (
              <a href={getLocalizedPath(`/insights/${rg.data.slug}`, currentLang)} class="pdp-guide-card">
                <img src={rg.data.featuredImage} alt={rgLoc.title} width="400" height="300" loading="lazy" />
                <div class="pdp-guide-body">
                  <span class="pdp-guide-cat">{rgLoc.category}</span>
                  <h3>{rgLoc.title}</h3>
                  <p>{rgLoc.summary}</p>
                  <span class="pdp-guide-cta">{t('guides.readCta')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  (function () {
    // Gallery thumbnail switching
    const mainImg = document.getElementById('pdp-main-img');
    const thumbBtns = document.querySelectorAll('.thumb-btn');
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img');
        if (src && mainImg) mainImg.setAttribute('src', src);
        thumbBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // Multi-material variant switching
    let currentSku = (document.getElementById('display-sku')?.textContent || '').replace('SKU:', '').trim().split('/')[0].trim();
    const variantBtns = document.querySelectorAll('.variant-btn');
    const price50 = document.getElementById('price-tier-50');
    const price200 = document.getElementById('price-tier-200');
    const price500 = document.getElementById('price-tier-500');
    const weightEl = document.getElementById('display-weight');
    const skuEl = document.getElementById('display-sku');
    const rfqBtn = document.getElementById('pdp-rfq-btn');

    function updateRfqHref() {
      if (!rfqBtn) return;
      const base = rfqBtn.getAttribute('data-rfq-base') || '/contact';
      const checkedRadio = document.querySelector('input[name="custom_mode"]:checked');
      const mode = checkedRadio ? checkedRadio.value : 'Blank Stock';
      rfqBtn.setAttribute('href', `${base}?sku=${encodeURIComponent(currentSku)}&mode=${encodeURIComponent(mode)}`);
    }

    variantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        variantBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentSku = btn.getAttribute('data-sku') || currentSku;
        if (price50) price50.textContent = '$' + btn.getAttribute('data-t50');
        if (price200) price200.textContent = '$' + btn.getAttribute('data-t200');
        if (price500) price500.textContent = '$' + btn.getAttribute('data-t500');
        if (weightEl) weightEl.textContent = btn.getAttribute('data-weight') || '';
        if (skuEl) skuEl.textContent = 'SKU: ' + currentSku;
        updateRfqHref();
      });
    });

    // Customization radio cards
    const radioCards = document.querySelectorAll('#custom-radio-group .radio-card');
    radioCards.forEach((card) => {
      card.addEventListener('click', () => {
        radioCards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
        const input = card.querySelector('input[type="radio"]');
        if (input) input.checked = true;
        updateRfqHref();
      });
    });
  })();
</script>

<style>
  .pdp-breadcrumb-bar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 0;
  }
  .breadcrumb-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: #64748b;
  }
  .pdp-breadcrumb strong {
    color: #0f172a;
    font-family: var(--font-mono);
  }
  .pdp-cross-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .cross-pill {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }
  .pill-logo {
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fcd34d;
  }
  .pill-tuning {
    background: #ede9fe;
    color: #6d28d9;
    border: 1px solid #c4b5fd;
  }
  .pill-cnc {
    background: #e0f2fe;
    color: #0369a1;
    border: 1px solid #7dd3fc;
  }
  .pdp-stage-1 {
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .pdp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 3rem;
    align-items: start;
  }
  .pdp-hero-grid > *,
  .stage-2-grid > * {
    min-width: 0;
    max-width: 100%;
  }
  .main-image-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 1rem;
    overflow: hidden;
    margin-bottom: 0.85rem;
  }
  .main-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .frame-badges {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .thumb-strip {
    display: flex;
