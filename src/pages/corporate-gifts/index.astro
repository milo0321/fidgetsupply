---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getCorporateGiftsCopy } from '../../i18n/landing/corporateGifts';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const copy = getCorporateGiftsCopy(currentLang);
const allProducts = await getCollection('products');

const corporateProducts = allProducts
  .filter((p) => p.data.logoReady)
  .sort((a, b) => parseFloat(a.data.tier500) - parseFloat(b.data.tier500))
  .slice(0, 8);

const PAGE_TITLES: Record<string, string> = {
  en: 'Corporate Metal Fidget Gifts & Custom Logo Swag ($0.74+)',
  de: 'Metall-Fidget Werbegeschenke & Firmenlogo Swag ($0.74+)',
  fr: 'Cadeaux d’Entreprise Fidget Métal & Logo Laser ($0.74+)',
  nl: 'Zakelijke Metalen Fidget Relatiegeschenken met Logo ($0.74+)',
  es: 'Regalos Corporativos Fidget Metálico con Logo ($0.74+)',
  it: 'Regali Aziendali Fidget in Metallo con Logo Laser ($0.74+)',
  pt: 'Brindes Corporativos Fidget Metálico com Logo ($0.74+)',
  sv: 'Företagspresenter Metallfidget med Egen Logotyp ($0.74+)',
  da: 'Firmagaver Metalfidget med Eget Logo & Lasergravering ($0.74+)',
  no: 'Firmagaver Metallfidget med Egen Logo & Lasergravering ($0.74+)',
  fi: 'Yrityslahjat Metallifidget Omalla Logolla ($0.74+)',
  pl: 'Gadżety Firmowe Metalowe Fidgety z Logo Laserowym ($0.74+)',
  cs: 'Firemní Dárky Kovové Fidgety s Vlastním Logem ($0.74+)',
  ru: 'Корпоративные подарки металлические фиджеты с лого ($0.74+)',
  ja: '企業ノベルティ・法人ギフト用名入れ金属フィジェット（$0.74〜）',
  ko: '기업 판촉물 & VIP 기프트 로고 각인 메탈 피젯 ($0.74+)',
  id: 'Souvenir Perusahaan & Hadiah Klien Fidget Logam Logo ($0.74+)',
  ar: 'هدايا شركات فاخرة فيدجت معدني بحفر شعار مخصص ($0.74+)'
};

const PAGE_DESCS: Record<string, string> = {
  en: 'Factory-direct custom logo metal fidget spinners & sliders for trade shows, tech onboarding, and VIP swag ($0.74+, $0 mold fee, MOQ 100, 12h proof).',
  de: 'Direkt ab Werk: Metall-Fidget-Spinner & Slider mit Firmenlogo für Messen, Onboarding & VIP-Geschenke ($0.74+, $0 Werkzeugkosten, MOQ 100, 12h Korrektur).',
  fr: 'Fidget spinners et sliders métal avec logo d’entreprise pour salons, onboarding et cadeaux VIP (0,74 $+, 0 $ moule, MOQ 100, BAT gratuit en 12h).',
  nl: 'Metalen fidget spinners & sliders met bedrijfslogo voor beurzen, onboarding en VIP-geschenken ($0.74+, $0 matrijskosten, MOQ 100, 12u drukproef).',
  es: 'Fidget spinners y sliders metálicos con logo de empresa para ferias, eventos y regalos VIP ($0.74+, $0 molde, MOQ 100, prueba digital en 12h).',
  it: 'Fidget spinner e slider in metallo con logo aziendale per fiere, eventi e regali VIP ($0.74+, $0 stampo, MOQ 100, bozza digitale gratis in 12h).',
  pt: 'Fidget spinners e sliders metálicos com logo corporativo para feiras, eventos e brindes VIP ($0.74+, $0 molde, MOQ 100, arte digital em 12h).',
  sv: 'Metallfidgets och sliders med företagslogotyp för mässor, onboarding och VIP-gåvor ($0.74+, $0 verktyg, MOQ 100, digital korrektur inom 12 timmar).',
  da: 'Metalfidgets og sliders med firmalogo til messer, konferencer og VIP-gaver ($0.74+, $0 værktøj, MOQ 100, gratis digital korrektur inden 12 timer).',
  no: 'Metallfidgets og sliders med firmalogo til messer, onboarding og VIP-gaver ($0.74+, $0 verktøy, MOQ 100, gratis digital korrektur innen 12 timer).',
  fi: 'Metallifidgetit ja sliderit yrityksen logolla messuille ja VIP-lahjoiksi ($0.74+, $0 muotti, MOQ 100, maksuton digitaalinen vedos 12 tunnissa).',
  pl: 'Metalowe spinnery i slidery z logo firmy na targi, konferencje i prezenty VIP ($0.74+, $0 za formę, MOQ 100, bezpłatna wizualizacja w 12h).',
  cs: 'Kovové fidget spinnery a slidery s firemním logem na veletrhy a VIP dárky ($0.74+, $0 za formu, MOQ 100 ks, náhled zdarma do 12 hodin).',
  ru: 'Металлические спиннеры и слайдеры с логотипом компании для выставок и VIP-подарков ($0.74+, $0 форма, MOQ 100 шт., макет за 12 часов).',
  ja: '展示会ノベルティ・社員ウェルカムキット・VIPギフト向け名入れ金属フィジェット（$0.74〜・金型代$0・MOQ 100個・12時間データ校正無料）。',
  ko: '전시회 기념품, 임직원 온보딩 키트, VIP 기업 선물용 로고 각인 메탈 피젯 ($0.74+, 금형비 $0, MOQ 100개, 12시간 무료 시안 제공).',
  id: 'Fidget spinner & slider logam dengan logo perusahaan untuk pameran, onboarding & hadiah VIP ($0.74+, $0 cetakan, MOQ 100, bukti desain 12 jam).',
  ar: 'سبينر وسلايدر معدني بشعار الشركة للمعارض وهدايا كبار الشخصيات (0.74$+، قالب 0$، الحد الأدنى 100 قطعة، معاينة تصميم مجانية خلال 12 ساعة).'
};

const corporateFaqs = copy.faqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: corporateFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const corpServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: copy.serviceName,
  provider: { '@type': 'Organization', name: 'FidgetSupply.com', url: 'https://fidgetsupply.com' },
  description: copy.serviceDesc
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: t('nav.customLogo'), item: `https://fidgetsupply.com${getLocalizedPath('/custom-branding', currentLang)}` },
    { '@type': 'ListItem', position: 3, name: copy.bcCurrent, item: `https://fidgetsupply.com${getLocalizedPath('/corporate-gifts', currentLang)}` }
  ]
};
---

<Layout
  title={PAGE_TITLES[currentLang] || PAGE_TITLES.en}
  description={PAGE_DESCS[currentLang] || PAGE_DESCS.en}
  ogImage="/images/insights/corporate-swag-laser-comparison-hero.webp"
  activePage="custom-branding"
  jsonLd={[corpServiceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/custom-branding', currentLang)}>{t('nav.customLogo')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{copy.bcCurrent}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{copy.badge1}</span>
          <span class="badge badge-emerald">{copy.badge2}</span>
        </div>

        <h1 class="grand-hero-title">{PAGE_TITLES[currentLang] || PAGE_TITLES.en}</h1>
        <p class="grand-hero-lead">
          {PAGE_DESCS[currentLang] || PAGE_DESCS.en}
        </p>

        <div class="hero-glass-grid">
          {copy.kpis.map((kpi) => (
            <div class="glass-kpi-card">
              <span class="glass-kpi-label">{kpi.label}</span>
              <strong class="glass-kpi-val">{kpi.val}</strong>
            </div>
          ))}
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {copy.ctaPrimary}
          </a>
          <a href={getLocalizedPath('/collections/custom-logo-metal-fidgets', currentLang)} class="btn btn-secondary-dark btn-hero">
            {copy.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">{copy.showcasePill}</span>
          <span class="hero-showcase-price">{copy.showcasePrice}</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/corporate-swag-laser-comparison-hero.webp"
            alt={copy.showcaseAlt}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>{copy.showcaseMeta[0]}</span>
          <span>{copy.showcaseMeta[1]}</span>
          <span>{copy.showcaseMeta[2]}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={copy.geoTitle}
      answer={copy.geoAnswer}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Corporate Logo Metal Fidget Quote & Free 12h Proof (MOQ 100+)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.matrixBadge}</span>
        <h2 class="section-title">{copy.matrixTitle}</h2>
      </div>
      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>{copy.tableHeaders[0]}</th>
              <th>{copy.tableHeaders[1]}</th>
              <th>{copy.tableHeaders[2]}</th>
              <th>{copy.tableHeaders[3]}</th>
            </tr>
          </thead>
          <tbody>
            {copy.tableRows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-light" style="padding: 2.5rem 1.75rem; border-radius: 1rem;">
      <div class="section-header-center">
        <span class="badge badge-emerald">{copy.picksBadge}</span>
        <h2 class="section-title">{copy.picksTitle}</h2>
      </div>
      <div class="grid-4">
        {corporateProducts.map((p) => (
          <ProductCard product={p.data} lang={currentLang} />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.faqBadge}</span>
        <h2 class="section-title">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {corporateFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
