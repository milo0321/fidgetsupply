---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 Page Not Found | FidgetSupply.com"
  description="Browse our 140 ready-to-produce metal EDC fidget molds or 9 category collections."
  noindex={true}
>
  <section class="section" style="text-align: center; padding: 6rem 0;">
    <div class="container">
      <span class="badge">404 Not Found</span>
      <h1 style="font-size: 2.5rem; margin: 1rem 0;">Page or Mold URL Not Found</h1>
      <p style="color: #475569; max-width: 600px; margin: 0 auto 2rem;">
        Looking for a specific factory SKU (`FS-001` to `FS-150`)? Use our interactive 140-model catalog or browse our 28 Logo-Ready custom branding molds.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/products" class="btn btn-primary">Explore All Products →</a>
        <a href="/collections/custom-logo-metal-fidgets" class="btn btn-accent">★ Browse 28 Logo-Ready Molds</a>
      </div>
    </div>
  </section>
</Layout>
