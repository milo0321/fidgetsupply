---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { getBrandingTableData, getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const brandingTable = getBrandingTableData(currentLang);
const allProducts = await getCollection('products');
const logoReadyModels = allProducts
  .filter((p) => p.data.logoReady)
  .sort((a, b) => a.data.rowId - b.data.rowId)
  .slice(0, 8);

const brandingFaqs = [
  {
    question: 'Why does the factory NOT recommend Silk-Screen or UV surface printing on metal fidgets?',
    answer: 'Polished, electroplated, anodized, and PVD-coated metal surfaces are ultra-smooth and chemically inert. Surface-applied silk-screen or UV ink lacks mechanical adhesion ("bite") on smooth metal and easily peels or flakes off under continuous thumb friction. Therefore, our factory recommends Fiber Laser Engraving for monochrome logos and Deep Laser Engraving + Color Fill for colored logos.'
  },
  {
    question: 'How does Deep Laser Engraving + Color Fill work and what does it cost?',
    answer: 'For colored logos on metal, we first use a 50W fiber laser to deep-carve a recessed cavity (0.15–0.25mm deep) into the metal shell, and then fill the recessed cavity with thermally cured colored enamel. Because the color sits below the metal friction plane, it never peels off. Unit cost is +$0.35 to $0.60 USD per piece (MOQ 100–200 pcs).'
  },
  {
    question: 'What is the custom logo pre-production sample fee and lead time?',
    answer: 'Custom logo sampling is paid and takes 10 to 15 days: Standard Fiber Laser Engraving sample fee is $50 USD, and Deep Laser Engraving + Color Fill sample fee is $80 to $150 USD depending on color count and SKU. A 1:1 digital vector placement proof is provided free within 12 hours prior to sampling.'
  },
  {
    question: 'What is the Minimum Order Quantity (MOQ) and unit cost for standard Fiber Laser Engraving?',
    answer: 'For monochrome Fiber Laser Engraving, our MOQ is 100 pieces per SKU with $0.00 setup fee and a unit branding cost of +$0.15 to $0.30 USD per piece. Blank unbranded stock starts at 50 pieces per SKU.'
  },
  {
    question: 'Why does custom branding on FidgetSupply.com require $0.00 in mold/tooling fees?',
    answer: 'Instead of cutting a bespoke die-casting mold ($3,000–$4,500), you select from our 140 existing ready-to-produce metal molds—specifically our 28 flat-surface Logo-Ready models—and apply your brand via Fiber Laser Engraving or Deep Laser Engraving + Color Fill.'
  },
  {
    question: 'Which metal fidget models have the largest unobstructed flat surface for laser and color-fill branding?',
    answer: 'Top flat-surface models include FS-125 (Smooth Soap-Box Slider, 42×26mm zone), FS-047 (Minimalist 6063 Aluminum Slider, 40×22mm zone), FS-001 (Poker King Slider, 38×25mm zone), FS-026 (Bottle Opener Slider), FS-013 (304 Stainless Coin, Ø28mm zone), and FS-009 (Knurled Twist Top, Ø16mm cap).'
  },
  {
    question: 'What vector artwork file formats do you require for custom branding?',
    answer: 'Please send vector files in Adobe Illustrator (.AI), Encapsulated PostScript (.EPS), vector .PDF, or .SVG format with fonts converted to outlines and Pantone (PMS) color callouts if choosing Deep Laser Engraving + Color Fill.'
  },
  {
    question: 'Can you laser engrave logos onto curved models like EDC Gourds (FS-096), Desk Eggs (FS-064), or Spinner Rings (FS-014)?',
    answer: 'Yes. Our laser workstations are equipped with synchronized 360-degree CNC rotary indexing chucks that engrave distortion-free logos and serial numbers around cylindrical gourds, kinetic eggs, and the inner/outer rims of mechanical rings.'
  },
  {
    question: 'Can you engrave sequential serial numbers (e.g., 001/300 to 300/300) or individual VIP names?',
    answer: 'Yes. Our Galvo fiber laser software supports automated CSV variable-data marking, allowing you to serialize limited-edition drops (001/500) or personalize individual corporate recipient names for just +$0.20/pc.'
  },
  {
    question: 'What if we choose a heavily sculpted 3D relief fidget that has no flat space on the body?',
    answer: 'For 3D sculpted models (such as FS-010, FS-032, or FS-114), we either laser-etch your micro-logo onto the internal sliding track plate / side bezel, or apply your full-size brand logo to the included Black EVA Shockproof Zipper Case or Window Metal Tin Box.'
  }
];

const localizedBrandingFaqs = getLocalizedPageFaqs('branding', brandingFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedBrandingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---

<Layout
  title={currentLang === 'en' ? 'Custom Logo Metal Fidget Branding: Fiber Laser & Deep Laser Color Fill | FidgetSupply' : `${t('brand.heroTitle')} | FidgetSupply`}
  description={currentLang === 'en' ? 'Custom metal fidget branding on 140 ready molds: 50W Fiber Laser (+$0.15–$0.30/pc, $50 sample) & Deep Laser + Color Fill (+$0.35–$0.60/pc, $80–$150 sample).' : t('brand.heroDesc')}
  activePage="custom-branding"
  jsonLd={faqSchema}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t('nav.customBranding')}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{t('brand.heroBadge')}</span>
          <span class="badge badge-dark">{t('home.hero.badge2')}</span>
        </div>

        <h1 class="grand-hero-title">{t('brand.heroTitle')}</h1>
        <p class="grand-hero-lead">
          {t('brand.heroDesc')}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">50W Fiber Laser</span>
            <strong class="glass-kpi-val">+$0.15–$0.30/{t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Deep Laser + Color</span>
            <strong class="glass-kpi-val">+$0.35–$0.60/{t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Laser Sample Fee</span>
            <strong class="glass-kpi-val">$50 USD</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Color Fill Sample</span>
            <strong class="glass-kpi-val">$80–$150 USD</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {t('nav.requestQuote')}
          </a>
          <a href={getLocalizedPath('/collections/custom-logo-metal-fidgets', currentLang)} class="btn btn-secondary-dark btn-hero">
            {t('home.hero.ctaLogo')}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">50W LASER &amp; DEEP COLOR FILL</span>
          <span class="hero-showcase-price">28 Logo-Ready Molds</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/laser-vs-uv-branding-hero.webp"
            alt={t('brand.heroTitle')}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>50W Fiber Laser ($50 Sample)</span>
          <span>Deep Laser + Color (+$0.35–$0.60)</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('brand.geoTitle')}
      answer={t('brand.geoAnswer')}
    />

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{t('brand.compBadge')}</span>
        <h2 class="section-title">{t('brand.compTitle')}</h2>
      </div>

      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              {brandingTable.headers.map((h) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {brandingTable.rows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-light brand-picks-box">
      <div class="section-header-center">
        <span class="badge badge-emerald">{t('brand.topPicksBadge')}</span>
        <h2 class="section-title">{t('brand.topPicksTitle')}</h2>
      </div>
      <div class="grid-4">
        {logoReadyModels.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href={getLocalizedPath('/collections/custom-logo-metal-fidgets', currentLang)} class="btn btn-primary">{t('brand.topPicksCta')}</a>
      </div>
    </section>

    <!-- Custom Branding FAQ Section -->
    <section class="section" style="margin-bottom: 3rem;">
      <div class="section-header-center">
        <span class="badge">{t('brand.faqBadge')}</span>
        <h2 class="section-title">{t('brand.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedBrandingFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
  }
  .page-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    margin: 0.85rem 0;
  }
  .page-hero p {
    color: #cbd5e1;
    max-width: 820px;
    font-size: 1.05rem;
  }
  .brand-picks-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 640px) {
    .brand-picks-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
