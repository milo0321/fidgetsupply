---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getBulkAdultCopy } from '../../i18n/landing/bulkAdultOffice';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const copy = getBulkAdultCopy(currentLang);
const allProducts = await getCollection('products');

const officeSkus = ['FS-125', 'FS-047', 'FS-135', 'FS-014', 'FS-009', 'FS-064', 'FS-013', 'FS-150'];
const officeProducts = officeSkus
  .map((sku) => allProducts.find((p) => p.data.sku === sku))
  .filter(Boolean) as typeof allProducts;

const PAGE_TITLES: Record<string, string> = {
  en: 'Bulk Fidget Toys for Adults & Silent Office EDC ($0.74+)',
  de: 'Metall Fidget Toys für Erwachsene & Büro Großhandel ($0.74+)',
  fr: 'Fidget Toys Métal pour Adultes & Bureau en Gros ($0.74+)',
  nl: 'Metalen Fidget Toys voor Volwassenen Groothandel ($0.74+)',
  es: 'Fidget Toys Metálicos para Adultos y Oficina ($0.74+)',
  it: 'Fidget in Metallo per Adulti e Ufficio Ingrosso ($0.74+)',
  pt: 'Fidget Toys Metálicos para Adultos e Escritório ($0.74+)',
  sv: 'Metallfidgets för Vuxna & Tyst Kontor Grossist ($0.74+)',
  da: 'Metalfidgets til Voksne & Stille Kontor Engros ($0.74+)',
  no: 'Metallfidgets for Voksne & Stille Kontor Engros ($0.74+)',
  fi: 'Metallifidgetit Aikuisille & Toimistoon Tukku ($0.74+)',
  pl: 'Metalowe Fidgety dla Dorosłych i Biura Hurt ($0.74+)',
  cs: 'Kovové Fidgety pro Dospělé & Kancelář Velkoobchod ($0.74+)',
  ru: 'Металлические фиджеты для взрослых и офиса оптом ($0.74+)',
  ja: '大人・オフィス向け静音金属フィジェット卸売（$0.74〜）',
  ko: '성인용 & 무소음 사무실 메탈 피젯 토이 대량 도매 ($0.74+)',
  id: 'Grosir Fidget Logam untuk Dewasa & Kantor ($0.74+)',
  ar: 'ألعاب فيدجت معدنية للكبار والمكتب بالجملة ($0.74+)'
};

const PAGE_DESCS: Record<string, string> = {
  en: 'Bulk fidget toys for adults, silent PTFE desk sliders (<35 dBA), and ADHD sensory metal spinners direct from 140 molds ($0.74+, MOQ 50, 1-pc sample).',
  de: 'Metall-Fidgets für Erwachsene im Großhandel: leise Büro-Slider (<35 dBA), Drehringe & CNC-Kreisel ab Werk ($0.74+, MOQ 50, 1-Stück-Muster).',
  fr: 'Fidgets métal pour adultes en gros : sliders silencieux de bureau (<35 dBA), bagues rotatives et toupies CNC ($0.74+, MOQ 50, échantillon 1 pce).',
  nl: 'Metalen fidgets voor volwassenen in bulk: stille kantoor-sliders (<35 dBA) en roestvrijstalen spinners ($0.74+, MOQ 50, 1-stuk proefmonster).',
  es: 'Fidget toys metálicos para adultos al por mayor: sliders silenciosos de oficina (<35 dBA) y spinners CNC ($0.74+, MOQ 50 uds., muestra 1 ud.).',
  it: 'Fidget in metallo per adulti all’ingrosso: slider silenziosi da ufficio (<35 dBA) e spinner in acciaio inox ($0.74+, MOQ 50 pz., campione 1 pz.).',
  pt: 'Fidgets metálicos para adultos em atacado: sliders silenciosos de escritório (<35 dBA) e spinners CNC ($0.74+, MOQ 50 un., amostra 1 un.).',
  sv: 'Metallfidgets för vuxna i bulk: tysta kontorssliders (<35 dBA) och rostfria spinners ($0.74+, MOQ 50 st, 1-st utvärderingsprov).',
  da: 'Metalfidgets til voksne i bulk: støjsvage kontor-sliders (<35 dBA) og spinnerringe ($0.74+, MOQ 50 stk., 1-stk vareprøve).',
  no: 'Metallfidgets for voksne i bulk: stillegående kontorslidere (<35 dBA) og CNC-spinnere ($0.74+, MOQ 50 stk., 1-stk prøve).',
  fi: 'Metallifidgetit aikuisille tukkuhintaan: hiljaiset toimisto-sliderit (<35 dBA) ja sormukset ($0.74+, MOQ 50 kpl, 1 kpl näyte).',
  pl: 'Metalowe fidgety dla dorosłych w hurcie: ciche slidery biurowe (<35 dBA) i spinnery ze stali ($0.74+, MOQ 50 szt., próbka 1 szt.).',
  cs: 'Kovové fidgety pro dospělé velkoobchodně: tiché kancelářské slidery (<35 dBA) a spinnery ($0.74+, MOQ 50 ks, vzorek 1 ks).',
  ru: 'Металлические фиджеты для взрослых оптом: бесшумные офисные слайдеры (<35 дБА) и спиннеры ($0.74+, MOQ 50 шт., образец от 1 шт.).',
  ja: '大人向け・静音オフィス用金属フィジェット卸売：35dBA以下のPTFEスライダーやスピナーリングなど140金型（$0.74〜、MOQ 50個、1個サンプル）。',
  ko: '성인용 ADHD 집중 및 조용한 사무실용 메탈 피젯 대량 도매: 35dBA 미만 무소음 PTFE 슬라이더 & 스피너 반지 ($0.74+, MOQ 50개, 1개 샘플).',
  id: 'Grosir mainan fidget logam untuk dewasa: slider PTFE senyap kantor (<35 dBA) & spinner CNC ($0.74+, MOQ 50 pcs, sampel 1 pcs).',
  ar: 'أدوات فيدجت معدنية للكبار بالجملة: سلايدرات مكتب صامتة (<35 ديسيبل) وخواتم دوارة ($0.74+، الحد الأدنى 50 قطعة، عينة قطعة واحدة).'
};

const bulkAdultFaqs = copy.faqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: bulkAdultFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: copy.serviceName,
  provider: { '@type': 'Organization', name: 'FidgetSupply.com', url: 'https://fidgetsupply.com' },
  description: copy.serviceDesc
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: t('breadcrumb.allCatalog'), item: `https://fidgetsupply.com${getLocalizedPath('/products', currentLang)}` },
    { '@type': 'ListItem', position: 3, name: copy.bcCurrent, item: `https://fidgetsupply.com${getLocalizedPath('/bulk-adult-office-fidgets', currentLang)}` }
  ]
};
---

<Layout
  title={PAGE_TITLES[currentLang] || PAGE_TITLES.en}
  description={PAGE_DESCS[currentLang] || PAGE_DESCS.en}
  ogImage="/images/insights/quiet-office-decibel-fidgets-hero.webp"
  activePage="products"
  jsonLd={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{copy.bcCurrent}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{copy.badge1}</span>
          <span class="badge badge-emerald">{copy.badge2}</span>
        </div>

        <h1 class="grand-hero-title">{PAGE_TITLES[currentLang] || PAGE_TITLES.en}</h1>
        <p class="grand-hero-lead">
          {PAGE_DESCS[currentLang] || PAGE_DESCS.en}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[0].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[0].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[1].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[1].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[2].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[2].val} {t('unit.pcs')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[3].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[3].val}</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {copy.ctaPrimary}
          </a>
          <a href={getLocalizedPath('/landed-cost-calculator', currentLang)} class="btn btn-secondary-dark btn-hero">
            {copy.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">{copy.showcasePill}</span>
          <span class="hero-showcase-price">MOQ 50 {t('unit.pcs')}</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/quiet-office-decibel-fidgets-hero.webp"
            alt={`${PAGE_TITLES[currentLang] || PAGE_TITLES.en} — FidgetSupply`}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>{copy.showcaseMeta[0]}</span>
          <span>{copy.showcaseMeta[1]}</span>
          <span>{copy.showcaseMeta[2]}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={copy.geoTitle}
      answer={copy.geoAnswer}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Bulk Adult & Office Silent Metal Fidget Quote (MOQ 50+)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.matrixBadge}</span>
        <h2 class="section-title">{copy.matrixTitle}</h2>
      </div>
      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>{copy.tableHeaders[0]}</th>
              <th>{copy.tableHeaders[1]}</th>
              <th>{copy.tableHeaders[2]}</th>
              <th>{copy.tableHeaders[3]}</th>
            </tr>
          </thead>
          <tbody>
            {copy.tableRows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-light" style="padding: 2.5rem 1.75rem; border-radius: 1rem;">
      <div class="section-header-center">
        <span class="badge badge-emerald">{copy.picksBadge}</span>
        <h2 class="section-title">{copy.picksTitle}</h2>
      </div>
      <div class="grid-4">
        {officeProducts.map((p) => (
          <ProductCard product={p.data} lang={currentLang} />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.faqBadge}</span>
        <h2 class="section-title">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {bulkAdultFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
