  ru: `${locColName}${focusTag('ru')}: ${products.length} пресс-форм ($${minColPrice}–$${maxColPrice}, $0 за форму, MOQ 50 шт.). Лазер 50W.`,
  ja: `${locColName}${focusTag('ja')}：既存${products.length}金型（卸売 $${minColPrice}〜$${maxColPrice}、金型代$0、MOQ 50個・50Wレーザー名入れ）。`,
  ko: `${locColName}${focusTag('ko')}: 기성 금형 ${products.length}종 (도매 $${minColPrice}–$${maxColPrice}, 금형비 $0, MOQ 50개). 50W 레이저 로고 각인.`,
  id: `${locColName}${focusTag('id')}: ${products.length} cetakan siap pakai ($${minColPrice}–$${maxColPrice}, $0 biaya cetakan, MOQ 50 pcs). Logo laser 50W.`,
  ar: `${locColName} (سبينر معدن وفيجت مغناطيسي): ${products.length} قالبًا جاهزًا ($${minColPrice}–$${maxColPrice}، قالب 0$، الحد الأدنى 50 قطعة). حفر شعار ليزر 50W.`
};
---

<Layout
  title={currentLang === 'en' ? enTitle : `${locColName} (${products.length} ${t('nav.modelsCount')} · $${minColPrice}+) | FidgetSupply`}
  description={COLLECTION_META_DESC_MAP[currentLang] || locCol.heroSubtitle}
  keywords={collection.targetKeywords}
  ogImage={products[0]?.data.featuredImage ? products[0].data.featuredImage : undefined}
  jsonLd={[itemListSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t(`col.${collection.slug}.short` as any)}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-dark">{t(`col.${collection.slug}.short` as any)} · {products.length} {t('nav.modelsCount')}</span>
          <span class="badge badge-gold">{t('col.heroBadge')}</span>
        </div>

        <h1 class="grand-hero-title">{t(`col.${collection.slug}.name` as any)}</h1>
        <p class="grand-hero-lead">{locCol.heroSubtitle}</p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat1Label')}</span>
            <strong class="glass-kpi-val">{products.length}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat2Label')}</span>
            <strong class="glass-kpi-val">{collection.priceRangeUsd}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat3Label')}</span>
            <strong class="glass-kpi-val">{locCol.moq}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat4Label')}</span>
            <strong class="glass-kpi-val">{locCol.leadTime}</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a
            href={getLocalizedPath('/contact', currentLang)}
            data-rfq-sku={`${products.length} Models in ${cleanShortName} ($${minColPrice}–$${maxColPrice})`}
            data-rfq-mode="Blank Stock (MOQ 50 pcs)"
            data-rfq-qty="50"
            class="btn btn-accent btn-hero"
          >
            ⚡ {t('nav.requestQuote')}
          </a>
          <a
            href={`https://wa.me/8618750126315?text=${encodeURIComponent(`Hello FidgetSupply, I am browsing ${cleanShortName} ($${minColPrice}–$${maxColPrice} USD) and would like the wholesale price sheet & 1-pc sample options.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary-dark btn-hero"
            style="border-color: #10b981; color: #ecfdf5;"
          >
            💬 WhatsApp {t('nav.requestQuote')}
          </a>
          <a href="#collection-catalog" class="btn btn-secondary-dark btn-hero">
            {t('col.gridHeadingPrefix')} ({products.length}) &darr;
          </a>
        </div>

        <div class="hero-fast-sku-strip">
          {products.slice(0, 5).map((fp) => (
            <a href={getLocalizedPath(`/products/${fp.data.slug}`, currentLang)} class="hero-sku-chip">
              <strong>{fp.data.skuDisplay}</strong>
              <span>${fp.data.tier500}+</span>
            </a>
          ))}
          <a
            href={getLocalizedPath('/contact', currentLang)}
            class="hero-sku-chip"
            data-rfq-sku={products.slice(0, 3).map((fp) => fp.data.sku).join(', ')}
            data-rfq-mode="Sample / Prototype Evaluation"
            data-rfq-qty="1"
          >
            <strong>{microHooks.sample1Pc}</strong>
            <span>{microHooks.freeLogoProof}</span>
          </a>
          <a
            href={getLocalizedPath('/contact', currentLang)}
            class="hero-sku-chip"
            data-rfq-sku="All 140 Ready Molds (Full Catalog & Price List)"
            data-rfq-mode="Blank Unbranded Stock"
            data-rfq-qty="50"
          >
            <strong>{microHooks.sheet140}</strong>
            <span>PDF / Excel</span>
          </a>
        </div>
      </div>

      {products[0] && (
        <a href={getLocalizedPath(`/products/${products[0].data.slug}`, currentLang)} class="hero-showcase-card" style="text-decoration: none;">
          <div class="hero-showcase-top">
            <span class="sku-pill">{products[0].data.skuDisplay} · {t('pdp.readyMold')}</span>
            <span class="hero-showcase-price">${products[0].data.tier500} – ${products[0].data.tier50}/{t('unit.pc')}</span>
          </div>
          <div class="hero-showcase-img-wrap">
            <img
              src={products[0].data.featuredImage}
              alt={localizeTitle(products[0].data.title, currentLang)}
              width="480"
              height="360"
              loading="eager"
            />
          </div>
          <div class="hero-showcase-meta">
            <span>{localizeTitle(products[0].data.title, currentLang)}</span>
            <span>{localizeMaterial(products[0].data.material, currentLang).split('(')[0].trim()}</span>
            <span>{products[0].data.weight}</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <div class="container">
    <!-- Product Grid (Above-the-Fold Immediate Catalog Access) -->
    <section class="collection-products-section" id="collection-catalog">
      <div class="grid-header">
        <div>
          <h2>{t('col.gridHeadingPrefix')} {t(`col.${collection.slug}.short` as any)} ({products.length})</h2>
          <p class="grid-trust-strip">
            <span>{microHooks.mixMoqBadge}</span>
            <span>·</span>
            <a href="#engineering-comparison-matrix">{t('col.matrixBadge')} ↓</a>
          </p>
        </div>
        <a
          href={getLocalizedPath('/contact', currentLang)}
          data-rfq-sku={`${products.length} Models in ${cleanShortName} ($${minColPrice}–$${maxColPrice})`}
          data-rfq-mode="Blank Stock (MOQ 50 pcs)"
          data-rfq-qty="50"
          class="btn btn-primary"
        >
          ⚡ {t('nav.requestQuote')}
        </a>
      </div>

      <form class="inline-quick-sheet-form" data-inline-sku={`${cleanShortName} (${products.length} Models · $${minColPrice}–$${maxColPrice})`} novalidate>
        <div class="inline-qrfq-text">
          <strong>{microHooks.getFullSheetPdf}</strong>
          <span>{microHooks.mixMoqBadge}</span>
        </div>
        <div class="inline-qrfq-controls">
          <input
            type="email"
            class="inline-qrfq-input"
            placeholder={`${t('contact.workEmail')} (name@company.com)`}
            aria-label={t('contact.workEmail')}
            required
          />
          <button type="submit" class="inline-qrfq-btn">
            ⚡ {microHooks.sheet140} →
          </button>
        </div>
        <div class="inline-qrfq-status" hidden>✓ Sent! Check your inbox shortly.</div>
      </form>

      <div class="grid-4">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>

    <GeoDirectAnswer
      title={`${t(`col.${collection.slug}.short` as any)} — ${t('geo.defaultTitle')}`}
      answer={locCol.geoDirectAnswer}
    />

    <!-- Engineering Highlights Bar -->
    <div class="highlights-box">
      {locCol.engineeringHighlights.map((h) => (
        <div class="highlight-item">
          <span class="check-icon">✓</span>
          <p>{h}</p>
        </div>
      ))}
    </div>

    <!-- Collection Engineering Comparison Table (Top 15 Models) -->
    <section class="section" id="engineering-comparison-matrix">
      <div class="section-header-center">
        <span class="badge">{t('col.matrixBadge')}</span>
        <h2 class="section-title">{t(`col.${collection.slug}.short` as any)} {t('col.matrixTitleSuffix')}</h2>
        <p class="section-subtitle">
          {t('col.matrixSub')}
        </p>
      </div>

      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>{t('col.thSku')}</th>
              <th>{t('col.thName')}</th>
              <th>{t('col.thMaterial')}</th>
              <th>{t('col.thSizeWeight')}</th>
              <th>{t('col.thMagnet')}</th>
              <th>{t('col.thLogo')}</th>
              <th>{t('col.thPrice')}</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td><a href={getLocalizedPath(`/products/${p.data.slug}`, currentLang)}><strong>{p.data.skuDisplay}</strong></a></td>
                <td><a href={getLocalizedPath(`/products/${p.data.slug}`, currentLang)}>{localizeTitle(p.data.title, currentLang)}</a></td>
                <td>{localizeMaterial(p.data.material.split('/')[0].trim(), currentLang)}</td>
                <td>{p.data.size} · {p.data.weight}</td>
                <td>{localizeHardwareOrMagnets(p.data.magnetsEn, currentLang)}</td>
                <td>{p.data.logoReady ? '✅' : 'EVA'}</td>
                <td><strong>${p.data.tier500}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section section-light col-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('col.faqBadge')}</span>
        <h2 class="section-title">{t('pdp.faqTitle')} — {t(`col.${collection.slug}.short` as any)}</h2>
      </div>
      <div class="faq-list">
        {locCol.faqs.map((faq: any, idx: number) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Engineering & Sourcing Insights (Collection <-> Insight Mesh) -->
    {relatedGuides.length > 0 && (
      <section class="section" style="padding-top: 0; margin-bottom: 3.5rem;">
        <div class="section-header-center">
          <span class="badge">{t('guide.continueBadge')}</span>
          <h2 class="section-title">{t('guide.relatedGuidesTitle')}</h2>
        </div>
        <div class="col-guides-grid">
          {relatedGuides.map((rg: any) => {
            const rgLoc = localizeInsightMeta(rg.data, currentLang);
            return (
              <a href={getLocalizedPath(`/insights/${rg.data.slug}`, currentLang)} class="col-guide-card">
                <img src={rg.data.featuredImage} alt={rgLoc.title} width="400" height="300" loading="lazy" />
                <div class="col-guide-body">
                  <span class="col-guide-cat">{rgLoc.category}</span>
                  <h3>{rgLoc.title}</h3>
                  <p>{rgLoc.summary}</p>
                  <span class="col-guide-cta">{t('guides.readCta')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .collection-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
    border-bottom: 1px solid #334155;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: #38bdf8;
  }
  .hero-badges {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .collection-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
    margin-bottom: 0.85rem;
  }
  .hero-sub {
    color: #cbd5e1;
    max-width: 860px;
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }
  .collection-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
  }
  .stat-pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
  }
  .stat-pill span {
    font-size: 0.72rem;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .stat-pill strong {
    font-size: 1.05rem;
    color: #fbbf24;
    margin-top: 0.15rem;
  }
  .highlights-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .highlight-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.65rem;
    padding: 1rem 1.15rem;
    display: flex;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: #334155;
  }
  .check-icon {
    color: #059669;
    font-weight: 900;
    font-size: 1rem;
  }
  .collection-products-section {
    padding: 2.5rem 0;
  }
  .hero-fast-sku-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .hero-sku-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #f8fafc;
    font-size: 0.78rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .hero-sku-chip strong {
    color: #38bdf8;
    font-weight: 800;
  }
  .hero-sku-chip span {
    color: #fbbf24;
    font-weight: 700;
  }
  .hero-sku-chip:hover {
    background: rgba(2, 132, 199, 0.35);
    border-color: #38bdf8;
    transform: translateY(-1px);
  }
  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .grid-header h2 {
    font-size: 1.45rem;
    margin-bottom: 0.25rem;
  }
  .grid-trust-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: #059669;
    font-weight: 700;
    margin: 0;
  }
  .grid-trust-strip a {
    color: #0284c7;
    text-decoration: underline;
    font-weight: 800;
  }
  .col-guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .col-guide-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.85rem;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    transform: translateZ(0);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .col-guide-card:hover {
    transform: translate3d(0, -3px, 0);
    border-color: #38bdf8;
  }
  .col-guide-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-bottom: 1px solid #e2e8f0;
  }
  .col-guide-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .col-guide-cat {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #0284c7;
    letter-spacing: 0.04em;
    margin-bottom: 0.45rem;
  }
  .col-guide-body h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  .col-guide-body p {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.55;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .col-guide-cta {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 800;
    color: #0284c7;
  }
  @media (max-width: 900px) {
    .col-guides-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .col-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 640px) {
    .highlights-box {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }
    .highlight-item {
      padding: 0.85rem 1rem;
      font-size: 0.84rem;
    }
    .grid-header h2 {
      font-size: 1.25rem;
    }
    .grid-header .btn {
      width: 100%;
      justify-content: center;
    }
    .col-faq-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
