---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { COLLECTIONS, type CollectionMeta } from '../../data/collections';
import { getLanguageFromURL, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { localizeTitle, localizeMaterial, localizeHardwareOrMagnets } from '../../i18n/productLocalization';
import { localizeCollectionContent, localizeInsightMeta } from '../../i18n/insightAndCollectionLocalization';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');
  const allGuides = await getCollection('insights');
  const sortedProducts = allProducts.sort((a, b) => a.data.rowId - b.data.rowId);

  const COLLECTION_INSIGHT_MAP: Record<string, string[]> = {
    'magnetic-fidget-sliders': [
      '2027-tiktok-shop-asmr-amazon-fba-fidget-bestseller-forecast',
      '2027-acoustic-tuning-fork-vs-silent-office-fidget-trends',
      'n35-vs-n52-neodymium-magnet-haptic-feel-guide',
      'unlimited-free-floating-ptfe-vs-mechanical-track-fidget-sliders',
      'triple-layer-stacked-high-density-48-56-magnet-fidget-sliders',
      'poker-card-mahjong-tile-casino-metal-magnetic-fidget-sliders-guide',
      'how-to-launch-private-label-metal-edc-fidget-brand-zero-mold-tooling',
      'metal-edc-fidget-quality-control-checklist-12-pre-shipment-inspection-tests'
    ],
    'metal-fidget-spinners-gyros': [
      '2027-metal-edc-fidget-market-material-trends-report',
      '2027-acoustic-tuning-fork-vs-silent-office-fidget-trends',
      'r188-bearing-metal-fidget-spinners-desktop-gyro-engineering-guide',
      'sprocket-chain-planetary-gear-chaotic-pendulum-metal-fidget-guide',
      'multi-axis-gimbal-gyroscope-spinning-desk-egg-totem-edc-guide',
      'ptfe-teflon-tape-ceramic-beads-r188-bearing-fidget-maintenance-guide',
      'metal-edc-fidget-quality-control-checklist-12-pre-shipment-inspection-tests',
      'china-metal-edc-fidget-sourcing-direct-supply-chain-vs-trading-companies'
    ],
    'mechanical-edc-fidgets': [
      '2027-metal-edc-fidget-market-material-trends-report',
      'multi-action-mechanical-ratchet-bolt-action-edc-fidget-guide',
      'tactical-pistol-slide-spring-sword-katana-shield-metal-edc-guide',
      'sprocket-chain-planetary-gear-chaotic-pendulum-metal-fidget-guide',
      'multi-function-bottle-opener-keychain-luminous-tritium-edc-fidgets',
      'china-metal-edc-fidget-sourcing-direct-supply-chain-vs-trading-companies',
      '3d-mecha-armor-gothic-skull-relief-sculpted-metal-edc-fidget-guide',
      'metal-edc-fidget-quality-control-checklist-12-pre-shipment-inspection-tests'
    ],
    'edc-gourds-hand-pieces': [
      '2027-acoustic-tuning-fork-vs-silent-office-fidget-trends',
      'haptic-fidget-coins-edc-gourds-magnetic-spinner-rings-guide',
      'folding-fan-pivot-sliders-magnetic-capsules-knuckle-roller-begleri-guide',
      'zirconium-zr702-carbon-fiber-abalone-inlay-exotic-metal-edc-fidgets',
      'adult-adhd-focus-sensory-regulation-heavy-metal-fidget-selection-guide',
      'holiday-q4-corporate-multi-piece-metal-edc-fidget-gift-bundle-playbook',
      '2027-corporate-vip-swag-custom-laser-metal-fidget-trends',
      'corporate-executive-gifts-trade-show-vip-swag-metal-fidget-guide'
    ],
    'haptic-fidget-coins': [
      '2027-corporate-vip-swag-custom-laser-metal-fidget-trends',
      'haptic-fidget-coins-edc-gourds-magnetic-spinner-rings-guide',
      'retro-gamepad-arcade-piano-pea-pod-biscuit-novelty-metal-fidgets',
      'automotive-wheel-rim-casino-vip-esports-merch-custom-metal-fidget-guide',
      'n35-vs-n52-neodymium-magnet-haptic-feel-guide',
      'holiday-q4-corporate-multi-piece-metal-edc-fidget-gift-bundle-playbook',
      'how-to-launch-private-label-metal-edc-fidget-brand-zero-mold-tooling',
      'corporate-executive-gifts-trade-show-vip-swag-metal-fidget-guide'
    ],
    'magnetic-fidget-rings': [
      '2027-acoustic-tuning-fork-vs-silent-office-fidget-trends',
      '2027-cpsc-16-cfr-1262-eu-tsr-iata-magnet-fidget-compliance',
      'haptic-fidget-coins-edc-gourds-magnetic-spinner-rings-guide',
      'adult-adhd-focus-sensory-regulation-heavy-metal-fidget-selection-guide',
      'ultralight-6063-aluminum-vs-heavyweight-brass-stainless-edc-fidget-weight-guide',
      'quiet-office-executive-desk-fidget-toys-decibel-acoustic-guide',
      'holiday-q4-corporate-multi-piece-metal-edc-fidget-gift-bundle-playbook',
      'fiber-laser-engraving-vs-uv-printing-metal-fidget-logos'
    ],
    'custom-logo-metal-fidgets': [
      'how-to-launch-private-label-metal-edc-fidget-brand-zero-mold-tooling',
      'holiday-q4-corporate-multi-piece-metal-edc-fidget-gift-bundle-playbook',
      '2027-corporate-vip-swag-custom-laser-metal-fidget-trends',
      'fiber-laser-engraving-vs-uv-printing-metal-fidget-logos',
      'corporate-executive-gifts-trade-show-vip-swag-metal-fidget-guide',
      'zero-tooling-ready-mold-private-label-fidget-sop',
      'custom-eva-zipper-cases-tin-boxes-metal-fidget-packaging-guide',
      'china-metal-edc-fidget-sourcing-direct-supply-chain-vs-trading-companies'
    ],
    'tuning-fork-fidget-sliders': [
      '2027-acoustic-tuning-fork-vs-silent-office-fidget-trends',
      '2027-tiktok-shop-asmr-amazon-fba-fidget-bestseller-forecast',
      'acoustic-tuning-fork-fidget-slider-engineering-trend',
      'tiktok-shop-asmr-amazon-fba-shopify-metal-fidget-reseller-margin-guide',
      'how-to-launch-private-label-metal-edc-fidget-brand-zero-mold-tooling',
      'triple-layer-stacked-high-density-48-56-magnet-fidget-sliders',
      'ptfe-teflon-tape-ceramic-beads-r188-bearing-fidget-maintenance-guide',
      'metal-edc-fidget-quality-control-checklist-12-pre-shipment-inspection-tests'
    ],
    'cnc-stainless-steel-pei-edc': [
      'china-metal-edc-fidget-sourcing-direct-supply-chain-vs-trading-companies',
      'metal-edc-fidget-quality-control-checklist-12-pre-shipment-inspection-tests',
      '2027-metal-edc-fidget-market-material-trends-report',
      'zirconium-zr702-carbon-fiber-abalone-inlay-exotic-metal-edc-fidgets',
      'zinc-alloy-die-casting-vs-cnc-stainless-steel-edc-cost',
      'ultralight-6063-aluminum-vs-heavyweight-brass-stainless-edc-fidget-weight-guide',
      'pvd-coating-hard-anodizing-stonewash-antique-metal-fidget-finishes',
      'holiday-q4-corporate-multi-piece-metal-edc-fidget-gift-bundle-playbook'
    ]
  };

  return COLLECTIONS.map((col) => {
    const matched = sortedProducts.filter((p) => {
      if (col.group === 'primary') {
        return p.data.primaryCollection === col.slug;
      } else {
        return p.data.crossCollections.includes(col.slug);
      }
    });

    const guideSlugs = COLLECTION_INSIGHT_MAP[col.slug] || [
      'zero-tooling-ready-mold-private-label-fidget-sop',
      'fiber-laser-engraving-vs-uv-printing-metal-fidget-logos',
      'custom-eva-zipper-cases-tin-boxes-metal-fidget-packaging-guide'
    ];
    const relatedGuides = guideSlugs
      .map((s) => allGuides.find((g) => g.data.slug === s))
      .filter(Boolean);

    return {
      params: { slug: col.slug },
      props: { collection: col, products: matched, relatedGuides }
    };
  });
}

interface Props {
  collection: CollectionMeta;
  products: any[];
  relatedGuides?: any[];
}

const { collection, products, relatedGuides = [] } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const locCol = localizeCollectionContent(collection, currentLang);

const collectionPrices = products
  .flatMap((p) => [parseFloat(p.data.tier500), parseFloat(p.data.tier50)])
  .filter((n) => !isNaN(n) && n > 0);
const minColPrice = collectionPrices.length ? Math.min(...collectionPrices).toFixed(2) : '1.46';
const maxColPrice = collectionPrices.length ? Math.max(...collectionPrices).toFixed(2) : '52.31';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${t(`col.${collection.slug}.name` as any)} | FidgetSupply.com`,
  description: locCol.heroSubtitle,
  keywords: collection.targetKeywords,
  url: `https://fidgetsupply.com${getLocalizedPath(`/collections/${collection.slug}`, currentLang)}`,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: minColPrice,
    highPrice: maxColPrice,
    offerCount: products.length
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: products.length,
    itemListElement: products.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `https://fidgetsupply.com${getLocalizedPath(`/products/${p.data.slug}`, currentLang)}`,
      name: `${p.data.skuDisplay} ${localizeTitle(p.data.title, currentLang)}`
    }))
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: locCol.faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: t('breadcrumb.allCatalog'), item: `https://fidgetsupply.com${getLocalizedPath('/products', currentLang)}` },
    { '@type': 'ListItem', position: 3, name: t(`col.${collection.slug}.name` as any), item: `https://fidgetsupply.com${getLocalizedPath(`/collections/${collection.slug}`, currentLang)}` }
  ]
};

const COLLECTION_SEO_TITLES: Record<string, string> = {
  'magnetic-fidget-sliders': `Magnetic Fidget Sliders & Adult Fidgets (${products.length} Molds)`,
  'metal-fidget-spinners-gyros': `Heavy Metal Fidget Spinners & Desk Gyros (${products.length} Molds)`,
  'mechanical-edc-fidgets': `Multi-Action Mechanical EDC Fidget Toys (${products.length} Molds)`,
  'edc-gourds-hand-pieces': `Metal EDC Gourds, Capsules & Hand Pieces (${products.length} Molds)`,
  'haptic-fidget-coins': `Metal Haptic Fidget Coins & Pocket Clickers (${products.length} Molds)`,
  'magnetic-fidget-rings': `Magnetic Fidget Rings & Spinner Rings (${products.length} Molds)`,
  'custom-logo-metal-fidgets': `Custom Logo Metal Fidgets: ${products.length} Ready Molds ($0 Fee)`,
  'tuning-fork-fidget-sliders': `Acoustic Tuning Fork Fidget Sliders & EDC (${products.length} Molds)`,
  'cnc-stainless-steel-pei-edc': `5-Axis CNC Stainless Steel, PEI & Zr702 EDC (${products.length} Molds)`
};
const cleanShortName = collection.shortName.replace(/^[^\w]+/, '').trim();
const rawEnTitle = `${collection.name} (${products.length} Molds) | FidgetSupply`;
const medEnTitle = `${collection.name} | FidgetSupply`;
const shortEnTitle = `${cleanShortName} Wholesale | FidgetSupply`;
const enTitle = COLLECTION_SEO_TITLES[collection.slug] || (rawEnTitle.length <= 60 ? rawEnTitle : medEnTitle.length <= 60 ? medEnTitle : shortEnTitle);
const enDesc = `${cleanShortName}: ${products.length} ready metal molds (${collection.priceRangeUsd}). $0 tooling fee, 50 pcs blank MOQ, 100 pcs custom 50W fiber laser & color-fill branding.`;
---

<Layout
  title={currentLang === 'en' ? enTitle : `${t(`col.${collection.slug}.name` as any)} (${products.length} ${t('nav.modelsCount')}) | FidgetSupply`}
  description={currentLang === 'en' ? enDesc : locCol.heroSubtitle}
  keywords={collection.targetKeywords}
  ogImage={products[0]?.data.featuredImage}
  jsonLd={[itemListSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t(`col.${collection.slug}.short` as any)}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-dark">{t(`col.${collection.slug}.short` as any)} · {products.length} {t('nav.modelsCount')}</span>
          <span class="badge badge-gold">{t('col.heroBadge')}</span>
        </div>

        <h1 class="grand-hero-title">{t(`col.${collection.slug}.name` as any)}</h1>
        <p class="grand-hero-lead">{locCol.heroSubtitle}</p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat1Label')}</span>
            <strong class="glass-kpi-val">{products.length}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat2Label')}</span>
            <strong class="glass-kpi-val">{collection.priceRangeUsd}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat3Label')}</span>
            <strong class="glass-kpi-val">{locCol.moq}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('col.stat4Label')}</span>
            <strong class="glass-kpi-val">{locCol.leadTime}</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {t('nav.requestQuote')}
          </a>
          <a href={getLocalizedPath('/custom-branding', currentLang)} class="btn btn-secondary-dark btn-hero">
            {t('nav.customBranding')} &rarr;
          </a>
        </div>
      </div>

      {products[0] && (
        <a href={getLocalizedPath(`/products/${products[0].data.slug}`, currentLang)} class="hero-showcase-card" style="text-decoration: none;">
          <div class="hero-showcase-top">
            <span class="sku-pill">{products[0].data.skuDisplay} · {t('pdp.readyMold')}</span>
            <span class="hero-showcase-price">${products[0].data.tier500} – ${products[0].data.tier50}/{t('unit.pc')}</span>
          </div>
          <div class="hero-showcase-img-wrap">
            <img
              src={products[0].data.featuredImage}
              alt={localizeTitle(products[0].data.title, currentLang)}
              width="480"
              height="360"
              loading="eager"
            />
          </div>
          <div class="hero-showcase-meta">
            <span>{localizeTitle(products[0].data.title, currentLang)}</span>
            <span>{localizeMaterial(products[0].data.material, currentLang).split('(')[0].trim()}</span>
            <span>{products[0].data.weight}</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={`${t(`col.${collection.slug}.short` as any)} — ${t('geo.defaultTitle')}`}
      answer={locCol.geoDirectAnswer}
    />

    <!-- Engineering Highlights Bar -->
    <div class="highlights-box">
      {locCol.engineeringHighlights.map((h) => (
        <div class="highlight-item">
          <span class="check-icon">✓</span>
          <p>{h}</p>
        </div>
      ))}
    </div>

    <!-- Product Grid -->
    <section class="collection-products-section">
      <div class="grid-header">
        <h2>{t('col.gridHeadingPrefix')} {t(`col.${collection.slug}.short` as any)} ({products.length})</h2>
        <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-primary">{t('nav.requestQuote')}</a>
      </div>

      <div class="grid-4">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>

    <!-- Collection Engineering Comparison Table (Top 15 Models) -->
    <section class="section">
      <div class="section-header-center">
        <span class="badge">{t('col.matrixBadge')}</span>
        <h2 class="section-title">{t(`col.${collection.slug}.short` as any)} {t('col.matrixTitleSuffix')}</h2>
        <p class="section-subtitle">
          {t('col.matrixSub')}
        </p>
      </div>

      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>{t('col.thSku')}</th>
              <th>{t('col.thName')}</th>
              <th>{t('col.thMaterial')}</th>
              <th>{t('col.thSizeWeight')}</th>
              <th>{t('col.thMagnet')}</th>
              <th>{t('col.thLogo')}</th>
              <th>{t('col.thPrice')}</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr>
                <td><a href={getLocalizedPath(`/products/${p.data.slug}`, currentLang)}><strong>{p.data.skuDisplay}</strong></a></td>
                <td><a href={getLocalizedPath(`/products/${p.data.slug}`, currentLang)}>{localizeTitle(p.data.title, currentLang)}</a></td>
                <td>{localizeMaterial(p.data.material.split('/')[0].trim(), currentLang)}</td>
                <td>{p.data.size} · {p.data.weight}</td>
                <td>{localizeHardwareOrMagnets(p.data.magnetsEn, currentLang)}</td>
                <td>{p.data.logoReady ? '✅' : 'EVA'}</td>
                <td><strong>${p.data.tier500}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="section section-light col-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('col.faqBadge')}</span>
        <h2 class="section-title">{t('pdp.faqTitle')} — {t(`col.${collection.slug}.short` as any)}</h2>
      </div>
      <div class="faq-list">
        {locCol.faqs.map((faq: any, idx: number) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Engineering & Sourcing Insights (Collection <-> Insight Mesh) -->
    {relatedGuides.length > 0 && (
      <section class="section" style="padding-top: 0; margin-bottom: 3.5rem;">
        <div class="section-header-center">
          <span class="badge">{t('guide.continueBadge')}</span>
          <h2 class="section-title">{t('guide.relatedGuidesTitle')}</h2>
        </div>
        <div class="col-guides-grid">
          {relatedGuides.map((rg: any) => {
            const rgLoc = localizeInsightMeta(rg.data, currentLang);
            return (
              <a href={getLocalizedPath(`/insights/${rg.data.slug}`, currentLang)} class="col-guide-card">
                <img src={rg.data.featuredImage} alt={rgLoc.title} width="400" height="300" loading="lazy" />
                <div class="col-guide-body">
                  <span class="col-guide-cat">{rgLoc.category}</span>
                  <h3>{rgLoc.title}</h3>
                  <p>{rgLoc.summary}</p>
                  <span class="col-guide-cta">{t('guides.readCta')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .collection-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
    border-bottom: 1px solid #334155;
  }
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: #38bdf8;
  }
  .hero-badges {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .collection-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
    margin-bottom: 0.85rem;
  }
  .hero-sub {
    color: #cbd5e1;
    max-width: 860px;
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }
  .collection-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
  }
  .stat-pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.6rem;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
  }
  .stat-pill span {
    font-size: 0.72rem;
    color: #94a3b8;
    text-transform: uppercase;
  }
  .stat-pill strong {
    font-size: 1.05rem;
    color: #fbbf24;
    margin-top: 0.15rem;
  }
  .highlights-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .highlight-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.65rem;
    padding: 1rem 1.15rem;
    display: flex;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: #334155;
  }
  .check-icon {
    color: #059669;
    font-weight: 900;
    font-size: 1rem;
  }
  .collection-products-section {
    padding: 2.5rem 0;
  }
  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .grid-header h2 {
    font-size: 1.45rem;
  }
  .col-guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .col-guide-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
