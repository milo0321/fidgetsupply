---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { localizeTitle } from '../../i18n/productLocalization';
import { getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url.pathname);
const t = useTranslations(currentLang);
const allProducts = (await getCollection('products')).sort((a, b) => a.data.rowId - b.data.rowId);
const turnstileSiteKey = (
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.TURNSTILE_SITE_KEY ||
  (typeof process !== 'undefined' ? process.env?.PUBLIC_TURNSTILE_SITE_KEY || process.env?.TURNSTILE_SITE_KEY : '') ||
  '0x4AAAAAAF1GTaPVmYSNUcHS'
).trim();

const waNumber = '+86 187 5012 6315';
const cleanWhatsApp = '8618750126315';
const waBaseUrl =
  'https://wa.me/8618750126315?text=Hello%20FidgetSupply%2C%20I%20would%20like%20to%20inquire%20about%20wholesale%20metal%20fidgets%20and%20custom%20logo%20pricing.';

const contactFaqs = [
  {
    question: 'What is your typical Minimum Order Quantity (MOQ)?',
    answer: 'Blank unbranded wholesale stock starts at <strong>50 pieces per SKU</strong>. Custom logo orders via <strong>50W Fiber Laser Engraving</strong> or <strong>Deep Laser Engraving + Color Fill</strong> start at <strong>100 pieces per SKU</strong> using our existing production molds (<strong>$0.00 mold fee</strong>).'
  },
  {
    question: 'How fast can I receive a wholesale quotation and digital logo proof?',
    answer: 'Our sourcing desk responds within <strong>2 to 12 hours</strong> by email, or within <strong>15 minutes on WhatsApp</strong> during working hours (Mon – Sat: 8:00 AM – 10:00 PM GMT+8). Digital mockups showing your logo placement on selected models are provided free of charge within <strong>24 hours</strong>.'
  },
  {
    question: 'Why should I select exact FS-001 to FS-150 SKU codes in the form?',
    answer: 'Every SKU code (<strong>FS-001 through FS-150</strong>) maps directly to our production mold specifications, material options, unit weight, and carton packing dimensions—allowing us to calculate exact unit pricing and shipping costs immediately.'
  },
  {
    question: 'Can I request custom logo samples before placing a bulk order?',
    answer: 'Yes. Custom logo pre-production sampling is paid and takes <strong>10 to 15 days</strong>: <strong>Standard Fiber Laser Engraving sample fee is $50 USD</strong>, and <strong>Deep Laser Engraving + Color Fill sample fee is $80 to $150 USD</strong>. Simply select <strong>Sample / Prototype Evaluation</strong> in the quantity field above.'
  },
  {
    question: 'Can I combine multiple SKUs in a single wholesale inquiry?',
    answer: 'Yes. You can type multiple SKU codes or click several category pills in the form above (for example, FS-001, FS-047, and FS-125) to request a single consolidated quotation.'
  },
  {
    question: 'What logo file formats do you accept for Fiber Laser or Deep Laser + Color Fill branding?',
    answer: 'We prefer vector files (<strong>.AI, .EPS, .PDF, .SVG, or .CDR</strong>) with Pantone (PMS) color callouts for the sharpest Fiber Laser Engraving and Deep Laser + Color Fill (+$0.35–$0.60/pc) results. Note: we do not recommend surface silk-screen or UV ink on metal because smooth, chemically inert metal surfaces lack ink adhesion and peel under thumb friction.'
  },
  {
    question: 'Can we sign a Non-Disclosure Agreement (NDA) before sharing artwork?',
    answer: 'Yes. We routinely sign mutual NDAs with private-label brands, corporate buyers, and distributors to protect your brand logos and confidential product plans.'
  },
  {
    question: 'What international shipping and delivery options do you offer?',
    answer: 'From our Export Logistics Hub in <strong>Fuzhou Industrial Zone, Fujian, China</strong>, we arrange <strong>Door-to-Door (DDP) duty-paid delivery</strong> as well as standard air express (DHL/FedEx/UPS in 5–7 days), air cargo, and sea/rail freight worldwide.'
  },
  {
    question: 'What packaging options are included or available?',
    answer: 'Most models include a standard protective polybag or <strong>black EVA zipper pouch</strong>. We also supply custom-debossed EVA cases, window tin boxes, rigid magnetic gift boxes, and retail barcode labels upon request.'
  },
  {
    question: 'What payment methods and commercial terms do you support?',
    answer: 'We issue formal invoices in USD, EUR, GBP, or RMB and accept <strong>T/T Bank Wire, PayPal, and Wise</strong>. Standard bulk production terms are 30% deposit and 70% balance after pre-shipment inspection confirmation.'
  }
];

const localizedContactFaqs = getLocalizedPageFaqs('contact', contactFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedContactFaqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]+>/g, '')
    }
  }))
};
---

<Layout
  title={currentLang === 'en' ? 'Contact Us & Request a Wholesale Quote | FidgetSupply' : `${t('contact.title')} | FidgetSupply`}
  description={currentLang === 'en' ? 'Request a 12-hour wholesale quote for 140+ ready metal EDC fidget molds (FS-001 to FS-150), custom fiber laser & color-fill branding, and global shipping.' : t('contact.subtitle')}
  activePage="contact"
  jsonLd={faqSchema}
>
  <section class="grand-hero">
    <div class="container grand-hero-centered">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{t('nav.contact')}</span>
      </nav>

      <div class="hero-badges-row">
        <span class="badge badge-dark">{t('contact.badge')}</span>
        <span class="badge badge-gold">{t('home.hero.badge2')}</span>
      </div>

      <h1 class="grand-hero-title">{t('contact.title')}</h1>
      <p class="grand-hero-lead">
        {t('contact.subtitle')}
      </p>

      <div class="hero-glass-grid cols-3" style="margin-bottom: 0;">
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('contact.stat1')}</span>
          <strong class="glass-kpi-val">140+ Molds</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('contact.stat2')}</span>
          <strong class="glass-kpi-val">50 / 100 {t('unit.pcs')}</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('contact.stat3')}</span>
          <strong class="glass-kpi-val">&lt; 12 Hours</strong>
        </div>
      </div>
    </div>
  </section>

  <div class="contact-page-wrapper">

    <!-- MAIN CONTAINED SPLIT CARD (LEFT DARK INFO PANEL + RIGHT FORM PANEL) -->
    <div class="contact-card-container">
      <!-- LEFT PANEL: Brand, Direct Chat & Contact Info -->
      <div class="contact-info-panel">
        <div class="info-content-wrap">
          <span class="info-badge">{t('contact.badge')}</span>

          <h2 class="info-title">{t('contact.infoTitle')}</h2>
          <p class="info-desc">
            {t('contact.infoDesc')}
          </p>

          <div class="contact-details-list">
            <div class="contact-detail-item">
              <div class="detail-icon">📧</div>
              <div class="detail-text">
                <span class="detail-label">{t('contact.emailLabel')}</span>
                <div class="email-copy-row">
                  <a href="mailto:sales@fidgetsupply.com" class="detail-value">sales@fidgetsupply.com</a>
                  <button
                    type="button"
                    id="copyEmailBtn"
                    class="copy-email-btn"
                    data-email="sales@fidgetsupply.com"
                    aria-label="Copy sales@fidgetsupply.com"
                  >
                    📋 Copy
                  </button>
                </div>
                <span class="detail-sub">{t('contact.emailSub')}</span>
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="detail-icon">💬</div>
              <div class="detail-text">
                <span class="detail-label">{t('contact.waLabel')}</span>
                <a
                  href={waBaseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="detail-value whatsapp-link"
                >
                  {waNumber} <span class="online-tag">{t('top.chatOnline')}</span>
                </a>
                <span class="detail-sub">{t('contact.waSub')}</span>
              </div>
            </div>

            <div class="contact-detail-item">
              <div class="detail-icon">🏢</div>
              <div class="detail-text">
                <span class="detail-label">{t('contact.hubLabel')}</span>
                <span class="detail-value location-text">{t('contact.hubVal')}</span>
              </div>
            </div>
          </div>

          <div class="trust-indicators">
            <div class="trust-stat">
              <span class="stat-num">140+</span>
              <span class="stat-text">{t('contact.stat1')}</span>
            </div>
            <div class="trust-stat">
              <span class="stat-num">50 / 100</span>
              <span class="stat-text">{t('contact.stat2')}</span>
            </div>
            <div class="trust-stat">
              <span class="stat-num">24h</span>
              <span class="stat-text">{t('contact.stat3')}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT PANEL: Primary Quote Submission Form -->
      <div class="contact-form-panel">
        <div class="contact-card">
          <div id="formFieldsContainer">
            <h3 class="form-title">{t('contact.formTitle')}</h3>
            <p class="form-desc">
              {t('contact.formDesc')}
            </p>

            <form id="rfqForm" class="rfq-form" action="/api/contact" method="POST" enctype="multipart/form-data" novalidate>
              <!-- Anti-bot Honeypot Field -->
              <div style="position: absolute; left: -9999px; top: -9999px; opacity: 0; height: 0; width: 0; overflow: hidden; pointer-events: none;" aria-hidden="true">
                <label for="rx_bot_trap_hp9">Do not fill this field</label>
                <input type="text" id="rx_bot_trap_hp9" name="rx_bot_trap_hp9" tabindex="-1" autocomplete="new-password" data-lpignore="true" data-1p-ignore="true" data-form-type="other" value="" />
              </div>
              <!-- ROW 1: Identity (Required *) -->
              <div class="form-row">
                <div class="form-group half">
                  <label class="form-label" for="fullName">{t('contact.fullName')}</label>
                  <input
                    type="text"
                    id="fullName"
                    name="fullName"
                    class="form-input"
                    placeholder={t('contact.phName')}
                    required
                  />
                </div>

                <div class="form-group half">
                  <label class="form-label" for="workEmail">{t('contact.workEmail')}</label>
                  <input
                    type="email"
                    id="workEmail"
                    name="workEmail"
                    class="form-input"
                    placeholder={t('contact.phEmail')}
                    required
                  />
                </div>
              </div>

              <!-- ROW 2: Organization & Destination -->
              <div class="form-row">
                <div class="form-group half">
                  <label class="form-label" for="companyName">
                    {t('contact.company')} <span class="optional-badge">{t('contact.optional')}</span>
                  </label>
                  <input
                    type="text"
                    id="companyName"
                    name="companyName"
                    class="form-input"
                    placeholder={t('contact.phCompany')}
                  />
                </div>

                <div class="form-group half">
                  <label class="form-label" for="destinationCountry">
                    {t('contact.country')} <span class="optional-badge">{t('contact.optional')}</span>
                  </label>
                  <input
                    type="text"
                    id="destinationCountry"
                    name="destinationCountry"
                    class="form-input"
                    placeholder={t('contact.phCountry')}
                  />
                </div>
              </div>

              <!-- ROW 3: Target Product / SKU Selector -->
              <div class="form-group">
                <div class="label-with-hint">
                  <label class="form-label" for="productName">{t('contact.targetProduct')}</label>
                  <span class="field-micro-badge">{t('top.moldsCount')}</span>
                </div>
                <input
                  type="text"
                  id="productName"
                  name="productName"
                  list="skuCatalogDatalist"
                  class="form-input"
                  placeholder={t('contact.phProduct')}
                  required
                />
                <datalist id="skuCatalogDatalist">
                  {allProducts.map((p) => (
                    <option value={`${p.data.skuDisplay} — ${localizeTitle(p.data.title, currentLang)}`} />
                  ))}
                </datalist>

                <div class="quick-product-pills" role="group" aria-label="Popular categories">
                  <span class="pills-label">{t('contact.quickSelect')}</span>
                  <button type="button" class="prod-pill" data-name="All 140 Ready Molds (Full Catalog & Price List)">★ {t('top.moldsCount')}</button>
                  <button type="button" class="prod-pill" data-name="Logo-Ready Custom Branding Fidgets">{t('card.logoReady')}</button>
                  <button type="button" class="prod-pill" data-name="Magnetic Haptic Sliders">{t('col.magnetic-fidget-sliders.short')}</button>
                  <button type="button" class="prod-pill" data-name="Acoustic Tuning Fork Sliders">{t('card.tuningFork')}</button>
                  <button type="button" class="prod-pill" data-name="CNC Stainless Steel & PEI EDC">{t('card.cncExotic')}</button>
                  <button type="button" class="prod-pill" data-name="Metal Fidget Spinners & Gyros">{t('col.metal-fidget-spinners-gyros.short')}</button>
                  <button type="button" class="prod-pill" data-name="Metal Haptic Clicker Coins">{t('col.haptic-fidget-coins.short')}</button>
                </div>
              </div>

              <!-- ROW 4: Target Quantity & Branding Mode -->
              <div class="form-row">
                <div class="form-group half">
                  <div class="label-with-hint">
                    <label class="form-label" for="estimatedQuantity">{t('contact.quantity')}</label>
                    <span class="field-micro-badge">{t('top.moqCount')}</span>
                  </div>
                  <select id="estimatedQuantity" name="estimatedQuantity" class="form-input form-select" required>
                    <option value="Sample / Prototype Evaluation">{t('pdp.orderSample')}</option>
                    <option value="50 - 99 pcs (Blank Stock)">50 – 99 {t('unit.pcs')} ({t('pdp.blankMoq')})</option>
                    <option value="100 - 199 pcs (Custom Logo MOQ)" selected>100 – 199 {t('unit.pcs')} ({t('pdp.logoMoq')})</option>
                    <option value="200 - 499 pcs">200 – 499 {t('unit.pcs')}</option>
                    <option value="500 - 1,999 pcs">500 – 1,999 {t('unit.pcs')}</option>
                    <option value="2,000+ pcs">2,000+ {t('unit.pcs')}</option>
                  </select>
                </div>

                <div class="form-group half">
                  <label class="form-label" for="brandingMode">{t('contact.brandingMode')}</label>
                  <select id="brandingMode" name="brandingMode" class="form-input form-select">
                    <option value="Blank Unbranded Stock">{t('pdp.opt1Title')}</option>
                    <option value="Fiber Laser Engraved Logo" selected>{t('pdp.opt2Title')}</option>
                    <option value="Deep Laser + Color Fill (+$0.35-$0.60/pc)">{t('pdp.opt3Title')}</option>
                    <option value="Custom Logo + Black EVA Zipper Case">{t('pdp.opt4Title')}</option>
                  </select>
                </div>
              </div>

              <!-- ROW 5: Detailed Specifications -->
              <div class="form-group">
                <label class="form-label" for="inquiryDetails">
                  {t('contact.notes')} <span class="optional-badge">{t('contact.optional')}</span>
                </label>
                <div class="quick-product-pills" role="group" aria-label="Quick inquiry templates" style="margin-bottom: 0.5rem;">
                  <button type="button" class="prod-pill rfq-preset-btn" data-qty="50 - 99 pcs (Blank Stock)" data-mode="Blank Unbranded Stock" data-note="Please send the wholesale price sheet for 50 pcs blank trial stock ($0 mold fee) and DDP shipping cost.">50 {t('unit.pcs')} ({t('pdp.blankMoq')})</button>
                  <button type="button" class="prod-pill rfq-preset-btn" data-qty="100 - 199 pcs (Custom Logo MOQ)" data-mode="Fiber Laser Engraved Logo" data-note="We want to customize 100 pcs with 50W Fiber Laser Engraving (+$0.15-$0.30/pc) and order a $50 pre-production laser sample.">100 {t('unit.pcs')} · 50W Laser ($50 Sample)</button>
                  <button type="button" class="prod-pill rfq-preset-btn" data-qty="100 - 199 pcs (Custom Logo MOQ)" data-mode="Deep Laser + Color Fill (+$0.35-$0.60/pc)" data-note="We want to customize 100-200 pcs with Deep Laser Engraving + Enamel Color Fill (+$0.35-$0.60/pc) and request a color-fill sample ($80-$150).">100 {t('unit.pcs')} · Deep Color-Fill</button>
                  <button type="button" class="prod-pill rfq-preset-btn" data-qty="100 - 199 pcs (Custom Logo MOQ)" data-mode="Custom Logo + Black EVA Zipper Case" data-note="We need 100 pcs with custom logo plus custom-branded Black EVA Zipper Cases (+$0.75/pc) and DDP delivery.">100 {t('unit.pcs')} + EVA Case</button>
                </div>
                <textarea
                  id="inquiryDetails"
                  name="inquiryDetails"
                  rows="3"
                  class="form-input form-textarea"
                  placeholder={t('contact.phNotes')}
                ></textarea>
              </div>

              <!-- ROW 6: Logo Artwork / Tech Pack Attachment (Optional, max 15MB) -->
              <div class="form-group">
                <label class="form-label" for="artworkFile">
                  {t('contact.fileLabel')} <span class="optional-badge">{t('contact.fileOptional')}</span>
                </label>

                <div class="file-dropzone" id="fileDropzone" tabindex="0" role="button" aria-label={t('contact.fileLabel')}>
                  <input
                    type="file"
                    id="artworkFile"
                    name="artworkFile"
                    class="file-input-hidden"
                    accept=".ai,.eps,.pdf,.svg,.cdr,.psd,.png,.jpg,.jpeg,.webp,.zip,.rar,.7z"
                  />
                  <div class="dropzone-empty" id="dropzoneEmpty">
                    <svg class="upload-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="17 8 12 3 7 8"></polyline>
                      <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span class="dropzone-text">{t('contact.fileHint')}</span>
                  </div>

                  <div class="dropzone-selected hidden" id="dropzoneSelected">
                    <div class="selected-file-info">
                      <span class="file-type-icon">📎</span>
                      <div class="file-meta">
                        <span class="file-label-prefix">{t('contact.fileSelected')}</span>
                        <span class="file-name" id="selectedFileName"></span>
                        <span class="file-size" id="selectedFileSize"></span>
                      </div>
                    </div>
                    <button type="button" class="btn-remove-file" id="btnRemoveFile" title={t('contact.fileRemove')}>
                      ✕
                    </button>
                  </div>
                </div>

                <div class="file-error-msg hidden" id="fileErrorMsg"></div>
              </div>

              <!-- Cloudflare Turnstile Anti-Bot Widget -->
              <div id="turnstileWidgetContainer" class="turnstile-widget-wrap" data-build-sitekey={turnstileSiteKey}>
                {turnstileSiteKey && (
                  <div
                    class="cf-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-action="contact"
                    data-theme="light"
                    data-callback="onTurnstileSuccess"
                    data-expired-callback="onTurnstileExpired"
                    data-error-callback="onTurnstileError"
                  ></div>
                )}
              </div>

              <!-- Submit Actions -->
              <div class="submit-actions-stack">
                <button
                  type="submit"
                  id="submitBtn"
                  class="btn btn-primary form-submit-btn"
                  data-submit-text={`${t('contact.submitBtn')} →`}
                  data-sending-text={t('contact.sending')}
                  data-verifying-text={t('contact.verifying')}
                >
                  {t('contact.submitBtn')} &rarr;
                </button>
                <button type="button" id="waInstantSubmitBtn" class="btn-wa-secondary">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                  <span>{t('contact.waBtn')} ({waNumber})</span>
                </button>
              </div>

              <!-- Upload & Submission Progress Bar -->
              <div
                id="submitProgressContainer"
                class="submit-progress-container hidden"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-uploading-text={t('contact.uploadingProgress')}
                data-processing-text={t('contact.processingInquiry')}
              >
                <div class="progress-header">
                  <div class="progress-status-wrap">
                    <span class="progress-spinner"></span>
                    <span class="progress-label" id="progressLabel">{t('contact.uploadingProgress')}</span>
                  </div>
                  <span class="progress-percent" id="progressPercent">0%</span>
                </div>
                <div class="progress-track">
                  <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
                </div>
                <div class="progress-footer">
                  <span class="progress-bytes" id="progressBytes"></span>
                  <span class="progress-note">{t('contact.progressNote')}</span>
                </div>
              </div>
            </form>

            <div
              id="formStatus"
              class="form-status-msg hidden"
              data-file-error-size={t('contact.fileErrorSize')}
              data-file-error-type={t('contact.fileErrorType')}
            ></div>
          </div>

          <!-- THANK YOU CONFIRMATION STATE -->
          <div id="formSuccessCard" class="success-card hidden">
            <div class="success-icon-wrap">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3 class="success-title">{t('contact.successTitle')}</h3>
            <p class="success-subtitle">
              {t('contact.successSub')}
            </p>
            <div class="success-actions">
              <a id="successWaLink" href={waBaseUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp" style="width: 100%;">
                {t('contact.successWaBtn')}
              </a>
              <button type="button" id="resetFormBtn" class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">
                {t('contact.resetFormBtn')}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ SECTION (RUIXING GIFTS ACCORDION STYLE) -->
    <section class="contact-faq-section">
      <div class="faq-container">
        <div class="faq-header text-center">
          <span class="sub-badge">{t('contact.faqBadge')}</span>
          <h2 class="section-title">{t('contact.faqTitle')}</h2>
          <p class="section-subtitle">{t('contact.faqSub')}</p>
        </div>

        <div class="faq-accordion-grid">
          {localizedContactFaqs.map((faq, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-question">
                <span>{faq.question}</span>
                <svg class="chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq-answer">
                <p set:html={faq.answer} />
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline>
  (function () {
    var formInitTime = Date.now();
    var productInput = document.getElementById('productName');
    var quickSelect = document.getElementById('quickSkuSelect');
    var brandingSelect = document.getElementById('brandingMode');
    var pills = document.querySelectorAll('.prod-pill');
    var form = document.getElementById('rfqForm');
    var waInstantBtn = document.getElementById('waInstantSubmitBtn');
    var formFieldsContainer = document.getElementById('formFieldsContainer');
    var formSuccessCard = document.getElementById('formSuccessCard');
    var successWaLink = document.getElementById('successWaLink');
    var resetFormBtn = document.getElementById('resetFormBtn');
    var submitBtn = document.getElementById('submitBtn');
    var statusMsg = document.getElementById('formStatus');

    // File upload elements
    var fileInput = document.getElementById('artworkFile');
    var fileDropzone = document.getElementById('fileDropzone');
    var dropzoneEmpty = document.getElementById('dropzoneEmpty');
    var dropzoneSelected = document.getElementById('dropzoneSelected');
    var selectedFileName = document.getElementById('selectedFileName');
    var selectedFileSize = document.getElementById('selectedFileSize');
    var btnRemoveFile = document.getElementById('btnRemoveFile');
    var fileErrorMsg = document.getElementById('fileErrorMsg');

    // Progress bar elements
    var submitProgressContainer = document.getElementById('submitProgressContainer');
    var progressLabel = document.getElementById('progressLabel');
    var progressPercent = document.getElementById('progressPercent');
    var progressFill = document.getElementById('progressFill');
    var progressBytes = document.getElementById('progressBytes');

    // Turnstile state & global callbacks
    var turnstileToken = null;
    var isWaitingForTurnstile = false;
    var turnstileTimer = null;

    window.onTurnstileSuccess = function (token) {
      turnstileToken = token;
      if (isWaitingForTurnstile) {
        if (turnstileTimer) clearTimeout(turnstileTimer);
        isWaitingForTurnstile = false;
        executeSubmit(token);
      }
    };

    window.onTurnstileExpired = function () {
      turnstileToken = null;
    };

    window.onTurnstileError = function () {
      if (isWaitingForTurnstile) {
        if (turnstileTimer) clearTimeout(turnstileTimer);
        isWaitingForTurnstile = false;
        executeSubmit(null);
      }
    };

    // Runtime Turnstile SiteKey fallback (if configured in Cloudflare Worker runtime vars rather than build-time vars)
    var turnstileContainer = document.getElementById('turnstileWidgetContainer');
    if (turnstileContainer && !turnstileContainer.getAttribute('data-build-sitekey')) {
      fetch('/api/contact')
        .then(function (r) { return r.json(); })
        .then(function (info) {
          if (info && info.turnstileSiteKey && turnstileContainer && !turnstileContainer.querySelector('.cf-turnstile')) {
            var widgetDiv = document.createElement('div');
            widgetDiv.className = 'cf-turnstile';
            widgetDiv.setAttribute('data-sitekey', info.turnstileSiteKey);
            widgetDiv.setAttribute('data-theme', 'light');
            turnstileContainer.appendChild(widgetDiv);
            var tryRender = function (attempts) {
              if (window.turnstile && typeof window.turnstile.render === 'function') {
                try {
                  window.turnstile.render(widgetDiv, {
                    sitekey: info.turnstileSiteKey,
                    theme: 'light',
                    callback: window.onTurnstileSuccess,
                    'expired-callback': window.onTurnstileExpired,
                    'error-callback': window.onTurnstileError
                  });
                } catch (_) {}
              } else if (attempts > 0) {
                setTimeout(function () { tryRender(attempts - 1); }, 300);
              }
            };
            tryRender(15);
          }
        })
        .catch(function () {});
    }

    var MAX_FILE_SIZE = 15 * 1024 * 1024; // 15MB
    var ALLOWED_EXTS = ['.pdf', '.ai', '.eps', '.svg', '.cdr', '.psd', '.png', '.jpg', '.jpeg', '.webp', '.zip', '.rar', '.7z'];

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    function handleFileSelection(file) {
      if (!file) {
        if (fileInput) fileInput.value = '';
        if (dropzoneEmpty) dropzoneEmpty.classList.remove('hidden');
        if (dropzoneSelected) dropzoneSelected.classList.add('hidden');
        if (fileErrorMsg) fileErrorMsg.classList.add('hidden');
        return;
      }

      if (file.size > MAX_FILE_SIZE) {
        if (fileInput) fileInput.value = '';
        if (dropzoneEmpty) dropzoneEmpty.classList.remove('hidden');
        if (dropzoneSelected) dropzoneSelected.classList.add('hidden');
        if (fileErrorMsg) {
          fileErrorMsg.textContent = (statusMsg && statusMsg.getAttribute('data-file-error-size')) || '⚠️ File exceeds 15MB limit. Please select a file under 15MB.';
          fileErrorMsg.classList.remove('hidden');
        }
        return;
      }

      var extMatch = file.name.match(/\.[^.]+$/);
      var ext = extMatch ? extMatch[0].toLowerCase() : '';
      if (ALLOWED_EXTS.indexOf(ext) === -1) {
        if (fileInput) fileInput.value = '';
        if (dropzoneEmpty) dropzoneEmpty.classList.remove('hidden');
        if (dropzoneSelected) dropzoneSelected.classList.add('hidden');
        if (fileErrorMsg) {
          fileErrorMsg.textContent = (statusMsg && statusMsg.getAttribute('data-file-error-type')) || '⚠️ Unsupported file format.';
          fileErrorMsg.classList.remove('hidden');
        }
        return;
      }

      if (fileErrorMsg) fileErrorMsg.classList.add('hidden');
      if (dropzoneEmpty) dropzoneEmpty.classList.add('hidden');
      if (selectedFileName) selectedFileName.textContent = file.name;
      if (selectedFileSize) selectedFileSize.textContent = '(' + formatFileSize(file.size) + ')';
      if (dropzoneSelected) dropzoneSelected.classList.remove('hidden');
    }

    if (fileInput) {
      fileInput.addEventListener('change', function () {
        if (fileInput.files && fileInput.files.length > 0) {
          handleFileSelection(fileInput.files[0]);
        } else {
          handleFileSelection(null);
        }
      });
    }

    if (btnRemoveFile) {
      btnRemoveFile.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        handleFileSelection(null);
      });
    }

    if (fileDropzone) {
      ['dragenter', 'dragover'].forEach(function (eventName) {
        fileDropzone.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          fileDropzone.classList.add('drag-active');
        });
      });

      ['dragleave', 'dragend', 'drop'].forEach(function (eventName) {
        fileDropzone.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
          fileDropzone.classList.remove('drag-active');
        });
      });

      fileDropzone.addEventListener('drop', function (e) {
        var dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          if (fileInput) fileInput.files = dt.files;
          handleFileSelection(dt.files[0]);
        }
      });
    }

    // 1. Pre-fill from URL query parameters (?sku=FS-125&mode=...) or data-rfq-* sessionStorage/localStorage
    try {
      var params = new URLSearchParams(window.location.search);
      var skuParam = params.get('sku') || params.get('topic') || '';
      var modeParam = params.get('mode') || '';
      var qtyParam = params.get('qty') || '';
      if (window.location.search && (skuParam || modeParam || qtyParam) && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', window.location.pathname);
      }
      if (!skuParam && !modeParam && !qtyParam) {
        var rawPrefill = sessionStorage.getItem('fs_rfq_prefill') || localStorage.getItem('fs_rfq_prefill');
        if (rawPrefill) {
          var parsedPrefill = JSON.parse(rawPrefill);
          if (parsedPrefill && (!parsedPrefill.ts || Date.now() - parsedPrefill.ts < 300000)) {
            skuParam = parsedPrefill.sku || parsedPrefill.topic || '';
            modeParam = parsedPrefill.mode || '';
            qtyParam = parsedPrefill.qty || '';
          }
          sessionStorage.removeItem('fs_rfq_prefill');
          localStorage.removeItem('fs_rfq_prefill');
        }
      }
      if (skuParam && productInput && !productInput.value) {
        productInput.value = skuParam;
      }
      if (modeParam && brandingSelect) {
        for (var i = 0; i < brandingSelect.options.length; i++) {
          if (brandingSelect.options[i].value.toLowerCase().indexOf(modeParam.toLowerCase()) !== -1) {
            brandingSelect.selectedIndex = i;
            break;
          }
        }
      }
      var qtySelect = document.getElementById('estimatedQuantity');
      if (qtyParam && qtySelect) {
        var qNum = parseInt(qtyParam, 10);
        var targetVal = qNum >= 2000 ? '2,000+' : qNum >= 500 ? '500 - 1,999' : qNum >= 200 ? '200 - 499' : qNum >= 100 ? '100 - 199' : '50 - 99';
        for (var j = 0; j < qtySelect.options.length; j++) {
          if (qtySelect.options[j].value.indexOf(targetVal) !== -1) {
            qtySelect.selectedIndex = j;
            break;
          }
        }
      }
    } catch (e) {}

    // 2. Quick SKU Dropdown appends to productInput
    if (quickSelect && productInput) {
      quickSelect.addEventListener('change', function () {
        if (!quickSelect.value) return;
        var curr = productInput.value.trim();
        productInput.value = curr ? curr + ', ' + quickSelect.value : quickSelect.value;
        quickSelect.value = '';
      });
    }

    // 3. Popular Category Pills & Scenario Presets append to productInput / inquiryDetails
    var formStartedTracked = false;
    if (form) {
      form.addEventListener('focusin', function () {
        if (!formStartedTracked) {
          formStartedTracked = true;
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'rfq_form_start', { page_path: window.location.pathname });
          }
        }
      });
    }

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        if (pill.classList.contains('rfq-preset-btn')) {
          var presetQty = pill.getAttribute('data-qty') || '';
          var presetMode = pill.getAttribute('data-mode') || '';
          var presetNote = pill.getAttribute('data-note') || '';
          var qtyEl = document.getElementById('estimatedQuantity');
          var detailsEl = document.getElementById('inquiryDetails');
          if (presetQty && qtyEl) qtyEl.value = presetQty;
          if (presetMode && brandingSelect) brandingSelect.value = presetMode;
          if (presetNote && detailsEl) detailsEl.value = presetNote;
          if (productInput && !productInput.value.trim()) {
            productInput.value = 'All 140 Ready Molds (Full Catalog & Price List)';
          }
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'rfq_preset_click', { preset_mode: presetMode, preset_qty: presetQty });
          }
          return;
        }
        var name = pill.getAttribute('data-name') || '';
        if (!name || !productInput) return;
        var curr = productInput.value.trim();
        if (curr.indexOf(name) === -1) {
          productInput.value = curr ? curr + ', ' + name : name;
        }
        pill.classList.toggle('active');
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'rfq_pill_select', { category_name: name });
        }
      });
    });

    function buildInquiryMessage() {
      var name = (document.getElementById('fullName')?.value || '').trim();
      var email = (document.getElementById('workEmail')?.value || '').trim();
      var company = (document.getElementById('companyName')?.value || '').trim();
      var country = (document.getElementById('destinationCountry')?.value || '').trim();
      var products = (document.getElementById('productName')?.value || '').trim();
      var qty = document.getElementById('estimatedQuantity')?.value || '';
      var mode = document.getElementById('brandingMode')?.value || '';
      var details = (document.getElementById('inquiryDetails')?.value || '').trim();
      var hasAttached = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0].name : '';

      return [
        'Hello FidgetSupply Sourcing Desk,',
        '',
        '• Target Product / SKU(s): ' + (products || 'Wholesale Metal EDC Fidgets'),
        '• Estimated Quantity: ' + (qty || '100 - 199 pcs'),
        '• Customization Mode: ' + (mode || 'Custom Logo'),
        '• Contact Name: ' + (name || 'Buyer') + (company ? ' (' + company + ')' : ''),
        '• Email: ' + (email || 'Not provided'),
        country ? '• Destination Country: ' + country : null,
        hasAttached ? '• Attached File: ' + hasAttached : null,
        details ? '• Project Notes: ' + details : null
      ]
        .filter(Boolean)
        .join('\n');
    }

    function executeSubmit(verifiedToken) {
      if (!form || !submitBtn) return;

      var msg = buildInquiryMessage();
      var nameEl = document.getElementById('fullName');
      var company = document.getElementById('companyName')?.value || nameEl?.value || 'Wholesale Buyer';
      var subject = 'Wholesale Quote Inquiry - ' + company + ' | FidgetSupply.com';
      var waUrl = 'https://wa.me/8618750126315?text=' + encodeURIComponent(msg);
      if (successWaLink) successWaLink.setAttribute('href', waUrl);

      var defaultBtnText = submitBtn.getAttribute('data-submit-text') || submitBtn.innerHTML;
      var sendingText = submitBtn.getAttribute('data-sending-text') || 'Sending...';
      submitBtn.disabled = true;
      submitBtn.textContent = sendingText;
      if (statusMsg) statusMsg.classList.add('hidden');

      var formData = new FormData(form);
      var attachedFile = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
      if (attachedFile && attachedFile.size > MAX_FILE_SIZE) {
        if (fileErrorMsg) {
          fileErrorMsg.textContent = (statusMsg && statusMsg.getAttribute('data-file-error-size')) || '⚠️ File exceeds 15MB limit.';
          fileErrorMsg.classList.remove('hidden');
        }
        submitBtn.disabled = false;
        submitBtn.innerHTML = defaultBtnText;
        return;
      }

      var existingTurnstileInput = form.querySelector('[name="cf-turnstile-response"]');
      var tokenToUse = verifiedToken || turnstileToken || (existingTurnstileInput ? existingTurnstileInput.value : '');
      if (tokenToUse) {
        formData.set('cf-turnstile-response', tokenToUse);
        formData.set('turnstileToken', tokenToUse);
      }

      // Attach visitor telemetry & browsing journey
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var timeSpentSec = Math.max(1, Math.round((Date.now() - formInitTime) / 1000));
        var detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'N/A';

        formData.set('pageUrl', window.location.href);
        formData.set('pageReferrer', document.referrer || 'Direct Visit');
        formData.set('browserLanguage', navigator.language || 'N/A');
        formData.set('screenResolution', window.screen.width + 'x' + window.screen.height + ' (' + (window.devicePixelRatio || 1) + 'x DPR)');
        formData.set('clientTimezone', detectedTimezone);
        formData.set('clientLocalTime', new Date().toLocaleString());
        formData.set('timeOnPageSeconds', timeSpentSec + 's');
        formData.set('utmSource', urlParams.get('utm_source') || '');
        formData.set('utmMedium', urlParams.get('utm_medium') || '');
        formData.set('utmCampaign', urlParams.get('utm_campaign') || '');
        formData.set('utmTerm', urlParams.get('utm_term') || '');
        formData.set('utmContent', urlParams.get('utm_content') || '');

        var storage = window.localStorage || window.sessionStorage;
        if (storage) {
          var typedEmail = (document.getElementById('workEmail')?.value || '').trim();
          var typedName = (document.getElementById('fullName')?.value || '').trim();
          var typedCompany = (document.getElementById('companyName')?.value || '').trim();
          if (typedEmail) storage.setItem('rx_user_email', typedEmail);
          if (typedName) storage.setItem('rx_user_name', typedName);
          if (typedCompany) storage.setItem('rx_user_company', typedCompany);
          var journey = typeof window.getRxBrowsingJourneySnapshot === 'function'
            ? window.getRxBrowsingJourneySnapshot()
            : JSON.parse(storage.getItem('rx_journey_history') || '[]');
          formData.set('browsingJourney', JSON.stringify(journey));
        }
      } catch (_) {}

      var hasFile = Boolean(attachedFile && attachedFile.size > 0);
      if (submitProgressContainer) {
        submitProgressContainer.classList.remove('hidden');
        if (progressFill) progressFill.style.width = '5%';
        if (progressPercent) progressPercent.textContent = '0%';
        if (progressLabel) {
          progressLabel.textContent = submitProgressContainer.getAttribute('data-uploading-text') || 'Uploading...';
        }
        if (progressBytes) {
          progressBytes.textContent = hasFile ? '0 B / ' + formatFileSize(attachedFile.size) : '';
        }
      }

      var xhr = new XMLHttpRequest();
      xhr.open('POST', '/api/contact', true);
      xhr.setRequestHeader('Accept', 'application/json');

      if (xhr.upload) {
        xhr.upload.onprogress = function (e) {
          if (e.lengthComputable && e.total > 0) {
            var pct = Math.min(95, Math.max(5, Math.round((e.loaded / e.total) * 100)));
            if (progressFill) progressFill.style.width = pct + '%';
            if (progressPercent) progressPercent.textContent = pct + '%';
            if (progressBytes && hasFile) {
              progressBytes.textContent = formatFileSize(e.loaded) + ' / ' + formatFileSize(e.total);
            }
          }
        };
        xhr.upload.onload = function () {
          if (progressFill) progressFill.style.width = '96%';
          if (progressPercent) progressPercent.textContent = '96%';
          if (progressLabel && submitProgressContainer) {
            progressLabel.textContent = submitProgressContainer.getAttribute('data-processing-text') || 'Processing inquiry...';
          }
          if (progressBytes) progressBytes.textContent = '';
        };
      }

      xhr.onload = function () {
        var resData = {};
        try {
          resData = JSON.parse(xhr.responseText);
        } catch (_) {}

        if (xhr.status >= 200 && xhr.status < 300 && resData.success !== false) {
          if (progressFill) progressFill.style.width = '100%';
          if (progressPercent) progressPercent.textContent = '100%';
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', {
              event_category: 'form_submission',
              event_label: 'contact_form',
              currency: 'USD',
              value: 100
            });
          }
          setTimeout(function () {
            if (submitProgressContainer) submitProgressContainer.classList.add('hidden');
            submitBtn.disabled = false;
            submitBtn.innerHTML = defaultBtnText;
            if (formFieldsContainer && formSuccessCard) {
              formFieldsContainer.classList.add('hidden');
              formSuccessCard.classList.remove('hidden');
              formSuccessCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 200);
        } else {
          if (submitProgressContainer) submitProgressContainer.classList.add('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = defaultBtnText;
          turnstileToken = null;
          if (window.turnstile && typeof window.turnstile.reset === 'function') {
            try { window.turnstile.reset(); } catch (_) {}
          }
          if (statusMsg) {
            statusMsg.textContent = resData.error || resData.message || '⚠️ Submission error. Please try again or send via WhatsApp.';
            statusMsg.classList.remove('hidden');
          }
        }
      };

      xhr.onerror = function () {
        if (submitProgressContainer) submitProgressContainer.classList.add('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = defaultBtnText;
        window.location.href = 'mailto:sales@fidgetsupply.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(msg);
      };

      xhr.send(formData);
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nameEl = document.getElementById('fullName');
        var emailEl = document.getElementById('workEmail');
        var prodEl = document.getElementById('productName');
        if (nameEl && !nameEl.value.trim()) {
          nameEl.focus();
          return;
        }
        if (emailEl && !emailEl.value.trim()) {
          emailEl.focus();
          return;
        }
        if (prodEl && !prodEl.value.trim()) {
          prodEl.value = 'All 140 Ready Molds (Full Catalog & Price List)';
        }

        var turnstileWidget = form.querySelector('.cf-turnstile');
        var existingTurnstileInput = form.querySelector('[name="cf-turnstile-response"]');
        var currentToken = turnstileToken || (existingTurnstileInput ? existingTurnstileInput.value : null);

        if (turnstileWidget && !currentToken) {
          isWaitingForTurnstile = true;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = submitBtn.getAttribute('data-verifying-text') || 'Verifying Security...';
          }
          if (turnstileTimer) clearTimeout(turnstileTimer);
          turnstileTimer = setTimeout(function () {
            if (isWaitingForTurnstile) {
              isWaitingForTurnstile = false;
              executeSubmit(null);
            }
          }, 2000);
          return;
        }

        executeSubmit(currentToken);
      });
    }

    if (waInstantBtn) {
      waInstantBtn.addEventListener('click', function () {
        var msg = buildInquiryMessage();
        var typedEmail = (document.getElementById('workEmail')?.value || '').trim();
        var typedName = (document.getElementById('fullName')?.value || '').trim();
        var typedCompany = (document.getElementById('companyName')?.value || '').trim();
        var typedProd = (document.getElementById('productName')?.value || '').trim() || 'Wholesale Metal EDC Fidgets';
        if (typeof window.dispatchWhatsAppLeadTelemetry === 'function') {
          window.dispatchWhatsAppLeadTelemetry({
            triggerSource: 'Contact Form WhatsApp Button',
            userEmail: typedEmail,
            userName: typedName,
            userCompany: typedCompany,
            productName: typedProd,
            messageText: msg
          });
        }
        window.open('https://wa.me/8618750126315?text=' + encodeURIComponent(msg), '_blank');
      });
    }

    var copyEmailBtn = document.getElementById('copyEmailBtn');
    if (copyEmailBtn) {
      copyEmailBtn.addEventListener('click', function () {
        var emailToCopy = copyEmailBtn.getAttribute('data-email') || 'sales@fidgetsupply.com';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(emailToCopy).catch(function () {});
        }
        var origLabel = copyEmailBtn.textContent;
        copyEmailBtn.textContent = '✓ Copied';
        copyEmailBtn.classList.add('copied');
        setTimeout(function () {
          copyEmailBtn.textContent = origLabel;
          copyEmailBtn.classList.remove('copied');
        }, 2200);
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'direct_email_copy', {
            email_address: emailToCopy,
            page_path: window.location.pathname
          });
        }
      });
    }

    if (resetFormBtn) {
      resetFormBtn.addEventListener('click', function () {
        if (formSuccessCard && formFieldsContainer) {
          if (form) form.reset();
          handleFileSelection(null);
          pills.forEach(function (p) { p.classList.remove('active'); });
          turnstileToken = null;
          if (window.turnstile && typeof window.turnstile.reset === 'function') {
            try { window.turnstile.reset(); } catch (_) {}
          }
          formSuccessCard.classList.add('hidden');
          formFieldsContainer.classList.remove('hidden');
        }
      });
    }
  })();
</script>

<style>
  .contact-page-wrapper {
    background-color: #f8fafc;
    padding: 3.5rem 1.5rem 5rem;
  }

  .text-center {
    text-align: center;
  }

  .contact-header {
    max-width: 800px;
    margin: 0 auto 2.75rem;
  }

  .pill-badge {
    display: inline-block;
    background: rgba(14, 116, 144, 0.1);
    color: #0891b2;
    border: 1px solid rgba(14, 116, 144, 0.25);
    font-weight: 700;
