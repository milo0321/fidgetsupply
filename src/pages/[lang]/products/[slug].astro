---
import { getCollection } from 'astro:content';
import { nonDefaultLanguages } from '../../../i18n/config';
import { getRelatedInsightSlugsForProduct } from '../../../i18n/productLocalization';
import ProductDetailPage from '../../products/[slug].astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const allGuides = await getCollection('insights');
  const sorted = products.sort((a, b) => a.data.rowId - b.data.rowId);

  return nonDefaultLanguages.flatMap((lang) =>
    sorted.map((entry) => {
      const p = entry.data;
      const sameCol = sorted.filter((other) => other.data.primaryCollection === p.primaryCollection);
      const selfIdx = sameCol.findIndex((other) => other.data.slug === p.slug);
      const related: typeof sorted = [];
      if (sameCol.length > 1) {
        const count = Math.min(4, sameCol.length - 1);
        for (let offset = 1; offset <= count; offset++) {
          related.push(sameCol[(selfIdx + offset) % sameCol.length]);
        }
      }

      const targetGuideSlugs = getRelatedInsightSlugsForProduct(p);
      const relatedGuides = targetGuideSlugs
        .map((s) => allGuides.find((g) => g.data.slug === s))
        .filter(Boolean)
        .slice(0, 4);

      return {
        params: { lang, slug: p.slug },
        props: { product: p, relatedProducts: related, relatedGuides }
      };
    })
  );
}
---

<ProductDetailPage {...Astro.props} />
