---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, useTranslations, getLocalizedPath } from '../../i18n/utils';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const allProducts = await getCollection('products');

  return guides.map((guide) => {
    const relatedSkus = guide.data.relatedSkus || [];
    const relatedProducts = allProducts.filter((p) => relatedSkus.includes(p.data.sku)).slice(0, 4);
    const relatedGuides = guides.filter((g) => g.data.slug !== guide.data.slug).slice(0, 3);
    return {
      params: { slug: guide.data.slug },
      props: { guide, relatedProducts, relatedGuides }
    };
  });
}

const { guide, relatedProducts, relatedGuides = [] } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
await render(guide);
const rawGuideHtml = guide.rendered?.html || guide.body || '';
const localizedGuideHtml =
  currentLang === 'en'
    ? rawGuideHtml
    : rawGuideHtml.replace(
        /href="(\/(?:products|collections|guides|custom-branding|custom-packaging|compliance-safety|about|contact)[^"]*)"/g,
        (_m: string, p1: string) => `href="${getLocalizedPath(p1, currentLang)}"`
      );

const GUIDE_FAQS_BY_SLUG: Record<string, { question: string; answer: string }[]> = {
  'acoustic-tuning-fork-fidget-slider-engineering-trend': [
