---
import Layout from '../../layouts/Layout.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { getPackagingBullets, getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const pkgBullets = getPackagingBullets(currentLang);

const packagingFaqs = [
  {
    question: 'What standard packaging is included in the base wholesale price of your metal fidgets?',
    answer: 'Every unit ships in a scratch-preventive OPP polybag, and over 85% of our sliders, coins, and rings already include a standard unbranded black EVA zipper pouch or acrylic storage box at no extra charge (see the Packaging specification on each product page).'
  },
  {
    question: 'What is the Minimum Order Quantity (MOQ) for custom-branded Black EVA Zipper Cases?',
    answer: 'Our MOQ for custom-branded Black EVA Shockproof Zipper Cases (95×65×32mm) is just 100 pieces (+$0.75/pc), which matches our 100-piece custom logo MOQ for metal fidgets.'
  },
  {
    question: 'How is our logo applied to the Black EVA Shockproof Zipper Case?',
    answer: 'We offer three durable branding methods on EVA cases: (1) Silk-screen printing in white, gold, silver, or Pantone spot colors directly onto the top shell, (2) Hot-debossed custom PVC/silicone rubber badges stitched or heat-welded to the center lid, and (3) Custom-molded metal zipper pulls.'
  },
  {
    question: 'Can you die-cut custom EVA foam inserts to fit our exact fidget model inside a Tin Box or Gift Box?',
    answer: 'Yes. We maintain exact 2D CAD contours for all 140 catalog molds (FS-001 to FS-150). Our CNC oscillating-knife foam routers cut precision 45-shore black EVA foam cavities (including velvet-flocked tops) with zero die-cutting blade fee on orders of 200+ boxes.'
  },
  {
    question: 'Do you apply Amazon FBA FNSKU barcode stickers and CPSC 14+ warning labels?',
    answer: 'Yes! We print and apply thermal-transfer Amazon FNSKU barcode labels, "Made in China" country-of-origin stickers, and mandatory US CPSC 16 CFR 1262 / 14+ Adult EDC safety warning labels to every outer box or polybag free of charge.'
  },
  {
    question: 'Can you include a custom printed instruction card, QR code warranty card, and spare hardware bag inside each case?',
    answer: 'Yes. Most private-label brands insert a 350gsm matte-laminated instruction/story card (+$0.08/pc) alongside a mini zip-bag containing 2 spare PTFE Teflon wear pads, 2 stainless/ceramic detent balls, and 1 hex screwdriver inside the internal mesh pocket of the EVA case.'
  },
  {
    question: 'What is the difference between the Window Metal Tin Box and the Two-Piece Rigid Gift Box?',
    answer: 'The Matte Window Metal Tin Box (+$0.85/pc, MOQ 200) features a clear PET top window so retail customers can see the metal fidget inside without opening the lid. The Two-Piece Rigid Cardboard Gift Box (+$1.10/pc, MOQ 300) uses 1200gsm greyboard with soft-touch film and metallic foil stamping for luxury unboxing.'
  },
  {
    question: 'Can we bundle 2 or 3 different fidgets into a single multi-piece collector gift box?',
    answer: 'Absolutely. We regularly engineer dual-cavity and triple-cavity EVA foam trays (e.g., 1 Magnetic Slider + 1 Haptic Coin + 1 Spinner Ring) inside an oversized 160×110×40mm magnetic book box for holiday gift bundles and VIP corporate onboarding kits.'
  },
  {
    question: 'Do your packaging boxes pass Amazon FBA 3-foot drop tests without dented corners?',
    answer: 'Yes. All export master cartons use double-wall 5-ply K=K corrugated board with corner edge protectors, and individual rigid/tin boxes are heat-shrunk in POF film or protective bubble sleeves so retail packaging arrives pristine at Amazon FBA warehouses.'
  },
  {
    question: 'Do you provide dieline templates (.EPS / .PDF) so our graphic designer can lay out the box artwork?',
    answer: 'Yes. Message our sourcing desk on WhatsApp (+86 187 5012 6315) or submit an RFQ with your chosen SKU code, and we will send you the exact 1:1 Adobe Illustrator (.EPS) dieline template for the EVA case, tin box, or rigid gift box within 2 hours.'
  }
];

const localizedPackagingFaqs = getLocalizedPageFaqs('packaging', packagingFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedPackagingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const packagingServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: currentLang === 'en' ? 'Custom Fidget Packaging: EVA Zipper Cases, Window Tin Boxes & FBA Prep' : `${t('pkg.heroTitle')} | FidgetSupply`,
  provider: {
    '@type': 'Organization',
    name: 'FidgetSupply.com',
    url: 'https://fidgetsupply.com'
  },
  serviceType: 'Custom EVA Shockproof Zipper Cases, Window Metal Tin Boxes, Rigid Gift Boxes & Free Amazon FNSKU Labeling',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Wholesale Custom Fidget Packaging Tiers',
    itemListElement: [
      { '@type': 'Offer', name: 'Custom Debossed Black EVA Zipper Case (MOQ 100 pcs)', price: '0.75', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Matte Window Metal Tin Box + CNC Foam Insert (MOQ 200 pcs)', price: '0.85', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Two-Piece Rigid Luxury Gift Box (MOQ 300 pcs)', price: '1.10', priceCurrency: 'USD' }
    ]
  }
};

const PACKAGING_META_DESC_MAP: Record<string, string> = {
  en: 'Turnkey wholesale metal fidget packaging: custom Black EVA Zipper Cases (+$0.75, MOQ 100), Window Tin Boxes (+$0.85), Rigid Gift Boxes (+$1.10) & FNSKU labels.',
  es: 'Embalaje mayorista para fidgets metálicos: estuches EVA con cremallera (+$0.75, MOQ 100), cajas de hojalata (+$0.85), cajas rígidas (+$1.10) y etiquetas FNSKU.',
  de: 'Großhandel-Fidget-Verpackungen nach Maß: EVA-Reißverschlussetuis (+$0.75, MOQ 100), Sichtfenster-Blechdosen (+$0.85), Geschenkboxen (+$1.10) & gratis FNSKU.',
  fr: 'Packaging grossiste pour fidgets métal : étuis zippés EVA (+$0.75, MOQ 100), boîtes métal à fenêtre (+$0.85), coffrets rigides (+$1.10) et étiquettes FNSKU.',
  ja: '金属フィジェット用OEMパッケージ：カスタムEVAジッパーケース（+$0.75・MOQ 100個）、窓付きブリキ缶（+$0.85）、高級化粧箱（+$1.10）、Amazon FNSKU無料貼付。',
  ko: '금속 피젯 맞춤형 도매 패키징: 커스텀 EVA 지퍼 케이스(+$0.75, MOQ 100개), 투명창 틴케이스(+$0.85), 고급 하드 기프트 박스(+$1.10) 및 무료 FNSKU 라벨 부착.',
  ar: 'تغليف فيدجت معدني مخصص بالجملة: حقائب EVA بسحاب (+0.75$، MOQ 100)، علب صفيح بنافذة (+0.85$)، صناديق هدايا صلبة (+1.10$) وملصقات أمازون FNSKU مجاناً.',
  pt: 'Embalagens por atacado para fidgets metálicos: estojos EVA com zíper (+$0.75, MOQ 100), latas com visor (+$0.85), caixas rígidas (+$1.10) e etiquetas FNSKU.',
  ru: 'Индивидуальная упаковка для металлических фиджетов: чехлы EVA на молнии (+$0.75, от 100 шт.), жестяные коробки (+$0.85), подарочные боксы (+$1.10) и FNSKU.',
  it: 'Packaging ingrosso per fidget in metallo: custodie zip in EVA (+$0.75, MOQ 100), scatole in latta (+$0.85), cofanetti rigidi (+$1.10) ed etichette FNSKU.',
  nl: 'Groothandel-verpakkingen voor metalen fidgets: bedrukte EVA-ritsetuis (+$0.75, MOQ 100), vensterblikken (+$0.85), geschenkdozen (+$1.10) & gratis FNSKU-labels.',
  pl: 'Opakowania hurtowe do metalowych fidgetów: etui EVA na zamek (+$0.75, MOQ 100), puszki z okienkiem (+$0.85), pudełka prezentowe (+$1.10) i etykiety FNSKU.',
  id: 'Kemasan grosir fidget logam: kotak resleting EVA (+$0,75, MOQ 100), kotak kaleng jendela (+$0,85), kotak hadiah kaku (+$1,10) & label Amazon FNSKU gratis.',
  sv: 'Grossistförpackningar för metallfidgets: EVA-fodral med dragkedja (+$0.75, MOQ 100), plåtaskar med fönster (+$0.85), presentaskar (+$1.10) & FNSKU-etiketter.',
  no: 'Grossistemballasje for metallfidgets: EVA-etuier med glidelås (+$0.75, MOQ 100), metallbokser med vindu (+$0.85), gaveesker (+$1.10) og gratis FNSKU-etiketter.',
  da: 'Engrosemballage til metalfidgets: EVA-lynlåsetuier (+$0.75, MOQ 100), metalæsker med vindue (+$0.85), eksklusive gaveæsker (+$1.10) og gratis FNSKU-mærkning.',
  fi: 'Tukkupakkaukset metallifidgeteille: EVA-vetoketjukotelot (+$0.75, MOQ 100), ikkunalliset peltirasiat (+$0.85), lahjalaatikot (+$1.10) ja FNSKU-tarrojen kiinnitys.',
  cs: 'Velkoobchodní balení pro kovové fidgety: pouzdra EVA na zip (+$0.75, MOQ 100 ks), plechové krabičky s okénkem (+$0.85), dárkové boxy (+$1.10) a FNSKU štítky.'
};
const pageDescription = PACKAGING_META_DESC_MAP[currentLang] || PACKAGING_META_DESC_MAP.en;
---

<Layout
  title={currentLang === 'en' ? 'Custom Fidget Packaging: EVA Cases & Tin Boxes (+$0.75)' : `${t('pkg.heroTitle')} (+$0.75) | FidgetSupply`}
  description={pageDescription}
  activePage="custom-packaging"
  jsonLd={[packagingServiceSchema, faqSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t('nav.customPackaging')}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{t('pkg.heroBadge')}</span>
          <span class="badge badge-emerald">{t('pkg.card1Badge')}</span>
        </div>

        <h1 class="grand-hero-title">{t('pkg.heroTitle')}</h1>
        <p class="grand-hero-lead">
          {t('pkg.heroDesc')}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('pkg.card1Title')}</span>
            <strong class="glass-kpi-val">+$0.75 / {t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('pkg.card2Title')}</span>
            <strong class="glass-kpi-val">+$0.85 / {t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{t('pkg.card3Title')}</span>
            <strong class="glass-kpi-val">+$1.10 / {t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Amazon FNSKU</span>
            <strong class="glass-kpi-val">$0.00 Free</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a
            href={getLocalizedPath('/contact', currentLang)}
            data-rfq-sku="Custom Fidget Packaging (Black EVA Zipper Case / Window Tin Box / Gift Box)"
            data-rfq-mode="Custom Logo + Black EVA Zipper Case (MOQ 100 pcs)"
            data-rfq-qty="100"
            class="btn btn-accent btn-hero"
          >
            ⚡ {t('pkg.ctaBtn')}
          </a>
          <a href={getLocalizedPath('/insights/custom-eva-zipper-cases-tin-boxes-metal-fidget-packaging-guide', currentLang)} class="btn btn-secondary-dark btn-hero">
            {t('guides.readCta')}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">EVA CASE · TIN BOX · RIGID GIFT BOX</span>
          <span class="hero-showcase-price">MOQ 100 {t('unit.pcs')}</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/eva-tin-packaging-hero.webp"
            alt={t('pkg.heroTitle')}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>75-Shore-C EVA Foam</span>
          <span>FNSKU &amp; 14+ Labels</span>
          <span>IATA PI-953 Shielded</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('pkg.geoTitle')}
      answer={t('pkg.geoAnswer')}
    />

    <section class="section">
      <div class="grid-3">
        <div class="pkg-card">
          <span class="badge badge-emerald">{t('pkg.card1Badge')}</span>
          <h3>{t('pkg.card1Title')}</h3>
          <p class="pkg-price">{pkgBullets.price1}</p>
          <p>
            {t('pkg.card1Desc')}
          </p>
          <ul>
            {pkgBullets.bullets1.map((b) => <li>{b}</li>)}
          </ul>
        </div>

        <div class="pkg-card">
          <span class="badge">{t('pkg.card2Badge')}</span>
          <h3>{t('pkg.card2Title')}</h3>
          <p class="pkg-price">{pkgBullets.price2}</p>
          <p>
            {t('pkg.card2Desc')}
          </p>
          <ul>
            {pkgBullets.bullets2.map((b) => <li>{b}</li>)}
          </ul>
        </div>

        <div class="pkg-card">
          <span class="badge badge-gold">{t('pkg.card3Badge')}</span>
          <h3>{t('pkg.card3Title')}</h3>
          <p class="pkg-price">{pkgBullets.price3}</p>
          <p>
            {t('pkg.card3Desc')}
          </p>
          <ul>
            {pkgBullets.bullets3.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>

      <div style="text-align: center; margin-top: 3rem;">
        <a href={getLocalizedPath('/contact', currentLang)} data-rfq-mode="Custom EVA Case" class="btn btn-primary">{t('pkg.ctaBtn')}</a>
      </div>
    </section>

    <!-- Custom Packaging FAQ Section -->
    <section class="section section-light pkg-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('pkg.faqBadge')}</span>
        <h2 class="section-title">{t('pkg.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedPackagingFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
  }
  .page-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    margin: 0.85rem 0;
  }
  .page-hero p {
    color: #cbd5e1;
    max-width: 820px;
    font-size: 1.05rem;
  }
  .pkg-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-top: 4px solid #0284c7;
    border-radius: 0.9rem;
    padding: 2rem 1.85rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .pkg-card:nth-child(1) {
    border-top-color: #059669;
  }
  .pkg-card:nth-child(3) {
    border-top-color: #f59e0b;
  }
  .pkg-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .pkg-card h3 {
    font-size: 1.28rem;
    line-height: 1.3;
    color: #0f172a;
  }
  .pkg-price {
    font-size: 1.12rem;
    font-weight: 800;
    color: #059669;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.25rem 0.7rem;
    border-radius: 0.4rem;
  }
  .pkg-card p:not(.pkg-price) {
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.68;
  }
  .pkg-card ul {
    width: 100%;
    list-style: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: #1e293b;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }
  .pkg-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 640px) {
    .pkg-card {
      padding: 1.25rem;
    }
    .pkg-faq-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
