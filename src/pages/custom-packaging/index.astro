---
import Layout from '../../layouts/Layout.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getPackagingBullets, getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const pkgBullets = getPackagingBullets(currentLang);

const packagingFaqs = [
  {
    question: 'What standard packaging is included in the base wholesale price of your metal fidgets?',
    answer: 'Every metal fidget unit is individually sealed in a textured anti-oxidation vacuum-sealed pouch before export to block ocean/air humidity, prevent surface oxidation on brass/alloy finishes, and protect R188 bearings from moisture and micro-scratches—included at $0.00 extra charge.'
  },
  {
    question: 'What is the Minimum Order Quantity (MOQ) for custom-branded Black EVA Zipper Cases?',
    answer: 'Our MOQ for custom-branded Black EVA Shockproof Zipper Cases (95×65×32mm) is just 100 pieces (+$0.75/pc), which matches our 100-piece custom logo MOQ for metal fidgets.'
  },
  {
    question: 'How is our logo applied to the Black EVA Shockproof Zipper Case?',
    answer: 'We offer three durable branding methods on EVA cases: (1) Silk-screen printing in white, gold, silver, or Pantone spot colors directly onto the top shell, (2) Hot-debossed custom PVC/silicone rubber badges stitched or heat-welded to the center lid, and (3) Custom-molded metal zipper pulls.'
  },
  {
    question: 'Can you die-cut custom EVA foam inserts to fit our exact fidget model inside a Tin Box or Gift Box?',
    answer: 'Yes. We maintain exact 2D CAD contours for all 140 catalog molds (FS-001 to FS-150). Our CNC oscillating-knife foam routers cut precision 45-shore black EVA foam cavities (including velvet-flocked tops) with zero die-cutting blade fee on orders of 200+ boxes.'
  },
  {
    question: 'Do you apply Amazon FBA FNSKU barcode stickers and CPSC 14+ warning labels?',
    answer: 'Yes! We print and apply thermal-transfer Amazon FNSKU barcode labels, "Made in China" country-of-origin stickers, and mandatory US CPSC 16 CFR 1262 / 14+ Adult EDC safety warning labels to every outer box or polybag free of charge.'
  },
  {
    question: 'Can you include a custom printed instruction card, QR code warranty card, and spare hardware bag inside each case?',
    answer: 'Yes. Most private-label brands insert a 350gsm matte-laminated instruction/story card (+$0.08/pc) alongside a mini zip-bag containing 2 spare PTFE Teflon wear pads, 2 stainless/ceramic detent balls, and 1 hex screwdriver inside the internal mesh pocket of the EVA case.'
  },
  {
    question: 'What is the difference between the Stock-Mold EVA Zipper Case, Custom Rigid Gift Box, and Custom Window Tin Box?',
    answer: 'After individual vacuum-sealing, our Stock-Mold Black EVA Shockproof Zipper Case (+$0.75+/pc, MOQ 100, $0 EVA mold fee) is the fastest low-MOQ branded upgrade. For luxury retail unboxing, our Custom Two-Piece Rigid Cardboard Gift Box (+$1.45+/pc, MOQ 500) includes 1200gsm greyboard, foil stamping, and custom foam trays. Bespoke Window Metal Tin Boxes or custom-dimension molds are produced Made-to-Order starting at 1,000+ pcs.'
  },
  {
    question: 'Can we bundle 2 or 3 different fidgets into a single multi-piece collector gift box?',
    answer: 'Absolutely. We regularly engineer dual-cavity and triple-cavity EVA foam trays (e.g., 1 Magnetic Slider + 1 Haptic Coin + 1 Spinner Ring) inside an oversized 160×110×40mm magnetic book box for holiday gift bundles and VIP corporate onboarding kits.'
  },
  {
    question: 'Do your packaging boxes pass Amazon FBA 3-foot drop tests without dented corners?',
    answer: 'Yes. All export master cartons use double-wall 5-ply K=K corrugated board with corner edge protectors, and individual rigid/tin boxes are heat-shrunk in POF film or protective bubble sleeves so retail packaging arrives pristine at Amazon FBA warehouses.'
  },
  {
    question: 'Do you provide dieline templates (.EPS / .PDF) so our graphic designer can lay out the box artwork?',
    answer: 'Yes. Message our sourcing desk on WhatsApp (+86 187 5012 6315) or submit an RFQ with your chosen SKU code, and we will send you the exact 1:1 Adobe Illustrator (.EPS) dieline template for the EVA case, tin box, or rigid gift box within 2 hours.'
  }
];

const localizedPackagingFaqs = getLocalizedPageFaqs('packaging', packagingFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedPackagingFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const packagingServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: currentLang === 'en' ? 'Custom Fidget Packaging: EVA Zipper Cases, Window Tin Boxes & FBA Prep' : `${t('pkg.heroTitle')} | FidgetSupply`,
  provider: {
    '@type': 'Organization',
    name: 'FidgetSupply.com',
    url: 'https://fidgetsupply.com'
  },
  serviceType: 'Custom EVA Shockproof Zipper Cases, Window Metal Tin Boxes, Rigid Gift Boxes & Free Amazon FNSKU Labeling',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Wholesale Custom Fidget Packaging Tiers',
    itemListElement: [
      { '@type': 'Offer', name: 'Anti-Oxidation Vacuum-Sealed Inner Pouch (Included, MOQ 50 pcs)', price: '0.00', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Stock-Mold Black EVA Zipper Case + Custom Logo (MOQ 100 pcs)', price: '0.75', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Custom Two-Piece Rigid Luxury Gift Box + Foil Stamping (MOQ 500 pcs)', price: '1.45', priceCurrency: 'USD' }
    ]
  }
};

const PACKAGING_META_DESC_MAP: Record<string, string> = {
  en: 'Metal fidget packaging: anti-oxidation vacuum-sealed pouch (included), stock-mold EVA zipper case (+$0.75+, MOQ 100), rigid gift box (MOQ 500) & FNSKU.',
  es: 'Embalaje para fidgets metálicos: bolsa al vacío antioxidante (incluida), estuche EVA molde stock (+$0.75+, MOQ 100), caja rígida (MOQ 500) y FNSKU.',
  de: 'Metall-Fidget-Verpackung: Vakuum-Schutzbeutel (inkl.), Serienform-EVA-Etui (+$0.75+, MOQ 100), Stülpdeckelbox (MOQ 500) & gratis Amazon FNSKU.',
  fr: 'Packaging fidgets métal : sachet sous vide antioxydant (inclus), étui EVA moule stock (+$0.75+, MOQ 100), coffret rigide (MOQ 500) & FNSKU gratuit.',
  ja: '金属フィジェット梱包：防酸化真空パック（標準同梱）、公模ブラックEVAジッパーケース（+$0.75〜・MOQ 100）、高級化粧箱（MOQ 500）＆FNSKU無料貼付。',
  ko: '금속 피젯 패키징: 산화 방지 진공 밀봉 파우치(기본 포함), 공용 금형 블랙 EVA 케이스(+$0.75+, MOQ 100), 고급 하드박스(MOQ 500) 및 무료 FNSKU 라벨.',
  ar: 'تغليف الفيدجت المعدني: كيس تفريغ هواء مضاد للأكسدة (مشمول)، حقيبة EVA بسحاب قالب جاهز (+0.75$+، MOQ 100)، علبة هدايا صلبة (MOQ 500) وملصقات FNSKU.',
  pt: 'Embalagem para fidgets metálicos: saco a vácuo antioxidante (incluso), estojo EVA molde pronto (+$0.75+, MOQ 100), caixa rígida (MOQ 500) e FNSKU.',
  ru: 'Упаковка для металлических фиджетов: антиокислительный вакуумный пакет (включен), чехол EVA (+$0.75+, MOQ 100), жесткая коробка (MOQ 500) и FNSKU.',
  it: 'Packaging fidget in metallo: busta sottovuoto antiossidante (inclusa), custodia EVA stampo stock (+$0.75+, MOQ 100), cofanetto rigido (MOQ 500) e FNSKU.',
  nl: 'Metalen fidget verpakking: anti-oxidatie vacuümzak (inbegrepen), standaard EVA-etui (+$0.75+, MOQ 100), luxe geschenkdoos (MOQ 500) & gratis FNSKU.',
  pl: 'Opakowania do metalowych fidgetów: worek próżniowy antyoksydacyjny (w cenie), etui EVA z logo (+$0.75+, MOQ 100), pudełko sztywne (MOQ 500) i FNSKU.',
  id: 'Kemasan fidget logam: kantong vakum anti-oksidasi (termasuk), case EVA cetakan stok (+$0,75+, MOQ 100), kotak hadiah kaku (MOQ 500) & FNSKU gratis.',
  sv: 'Metallfidget-förpackning: vakuumpåse mot oxidation (ingår), standard EVA-fodral (+$0.75+, MOQ 100), exklusiv presentask (MOQ 500) & FNSKU-etiketter.',
  no: 'Metallfidget-emballasje: vakuumpose mot oksidasjon (inkludert), standard EVA-etui (+$0.75+, MOQ 100), stiv gaveeske (MOQ 500) & gratis FNSKU-etiketter.',
  da: 'Metalfidget-emballage: vakuumpose mod oxidation (inkl.), standard EVA-etui (+$0.75+, MOQ 100), eksklusiv gaveæske (MOQ 500) & gratis FNSKU-mærkning.',
  fi: 'Metallifidget-pakkaukset: hapettumista estävä tyhjiöpussi (sis.), vakiomuotti EVA-kotelo (+$0.75+, MOQ 100), lahjalaatikko (MOQ 500) & FNSKU-tarrat.',
  cs: 'Balení kovových fidgetů: antioxidační vakuový sáček (v ceně), pouzdro EVA (+$0.75+, MOQ 100), dárkový box (MOQ 500) a FNSKU štítky zdarma.'
};
const pageDescription = PACKAGING_META_DESC_MAP[currentLang] || PACKAGING_META_DESC_MAP.en;
---

<Layout
  title={currentLang === 'en' ? 'Custom Fidget Packaging: EVA Cases & Tin Boxes (+$0.75)' : `${t('pkg.heroTitle')} (+$0.75) | FidgetSupply`}
  description={pageDescription}
  activePage="custom-packaging"
  jsonLd={[packagingServiceSchema, faqSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t('nav.customPackaging')}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{t('pkg.heroBadge')}</span>
          <span class="badge badge-emerald">{t('pkg.card1Badge')}</span>
        </div>

        <h1 class="grand-hero-title">{t('pkg.heroTitle')}</h1>
        <p class="grand-hero-lead">
          {t('pkg.heroDesc')}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Vacuum-Sealed Pouch</span>
            <strong class="glass-kpi-val">$0.00 Included</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Stock-Mold EVA Case</span>
            <strong class="glass-kpi-val">+$0.75+ / {t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Rigid Gift Box (500+)</span>
            <strong class="glass-kpi-val">+$1.45+ / {t('unit.pc')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Amazon FNSKU</span>
            <strong class="glass-kpi-val">$0.00 Free</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a
            href={getLocalizedPath('/contact', currentLang)}
            data-rfq-sku="Custom Fidget Packaging (Black EVA Zipper Case / Window Tin Box / Gift Box)"
            data-rfq-mode="Custom Logo + Black EVA Zipper Case (MOQ 100 pcs)"
            data-rfq-qty="100"
            class="btn btn-accent btn-hero"
          >
            ⚡ {t('pkg.ctaBtn')}
          </a>
          <a href={getLocalizedPath('/insights/custom-eva-zipper-cases-tin-boxes-metal-fidget-packaging-guide', currentLang)} class="btn btn-secondary-dark btn-hero">
            {t('guides.readCta')}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">EVA CASE · TIN BOX · RIGID GIFT BOX</span>
          <span class="hero-showcase-price">MOQ 100 {t('unit.pcs')}</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/eva-tin-packaging-hero.webp"
            alt={t('pkg.heroTitle')}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>75-Shore-C EVA Foam</span>
          <span>FNSKU &amp; 14+ Labels</span>
          <span>IATA PI-953 Shielded</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('pkg.geoTitle')}
      answer={t('pkg.geoAnswer')}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Custom Packaging (EVA Zipper Case / Window Tin Box / Rigid Gift Box + FNSKU)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <div class="section-header-center">
        <span class="badge badge-emerald">REAL FACTORY PACKING LINE PROOF</span>
        <h2 class="section-title">Step-by-Step Anti-Oxidation Vacuum Sealing &amp; EVA Case Packing</h2>
      </div>
      <div class="packing-proof-grid">
        <figure class="packing-proof-card">
          <img
            src="/images/factory/packing-vacuum-sealed.webp"
            alt="Real factory photo of precision metal fidget spinners individually vacuum-sealed in textured anti-oxidation pouches"
            width="800"
            height="600"
            loading="lazy"
          />
          <figcaption>
            <strong>Step 1 — Individual Anti-Oxidation Vacuum Sealing (Included):</strong> Every metal fidget is vacuum-sealed in a heavy-duty textured barrier pouch prior to export, protecting R188 bearings and plated/CNC surfaces from ocean &amp; air humidity.
          </figcaption>
        </figure>
        <figure class="packing-proof-card">
          <img
            src="/images/factory/packing-eva-zipper-case.webp"
            alt="Real factory photo of a vacuum-sealed metal fidget placed inside a black shockproof felt-lined EVA zipper case"
            width="800"
            height="600"
            loading="lazy"
          />
          <figcaption>
            <strong>Step 2 — Stock-Mold Shockproof EVA Zipper Case (MOQ 100 Logo):</strong> Vacuum-sealed units seat snugly inside felt-lined black EVA zipper cases ($0 EVA mold fee) for dual impact + moisture protection.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="grid-3">
        <div class="pkg-card">
          <span class="badge badge-emerald">{t('pkg.card1Badge')}</span>
          <h3>{t('pkg.card1Title')}</h3>
          <p class="pkg-price">{pkgBullets.price1}</p>
          <p>
            {t('pkg.card1Desc')}
          </p>
          <ul>
            {pkgBullets.bullets1.map((b) => <li>{b}</li>)}
          </ul>
        </div>

        <div class="pkg-card">
          <span class="badge">{t('pkg.card2Badge')}</span>
          <h3>{t('pkg.card2Title')}</h3>
          <p class="pkg-price">{pkgBullets.price2}</p>
          <p>
            {t('pkg.card2Desc')}
          </p>
          <ul>
            {pkgBullets.bullets2.map((b) => <li>{b}</li>)}
          </ul>
        </div>

        <div class="pkg-card">
          <span class="badge badge-gold">{t('pkg.card3Badge')}</span>
          <h3>{t('pkg.card3Title')}</h3>
          <p class="pkg-price">{pkgBullets.price3}</p>
          <p>
            {t('pkg.card3Desc')}
          </p>
          <ul>
            {pkgBullets.bullets3.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>

      <div style="text-align: center; margin-top: 3rem;">
        <a href={getLocalizedPath('/contact', currentLang)} data-rfq-mode="Custom EVA Case" class="btn btn-primary">{t('pkg.ctaBtn')}</a>
      </div>
    </section>

    <!-- Custom Packaging FAQ Section -->
    <section class="section section-light pkg-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('pkg.faqBadge')}</span>
        <h2 class="section-title">{t('pkg.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedPackagingFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .packing-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .packing-proof-card {
    margin: 0;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .packing-proof-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: #0f172a;
  }
  .packing-proof-card figcaption {
    padding: 1.1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #334155;
  }
  .packing-proof-card figcaption strong {
    color: #0f172a;
  }
  @media (max-width: 768px) {
    .packing-proof-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .page-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
  }
  .page-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    margin: 0.85rem 0;
  }
  .page-hero p {
    color: #cbd5e1;
    max-width: 820px;
    font-size: 1.05rem;
  }
  .pkg-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-top: 4px solid #0284c7;
    border-radius: 0.9rem;
    padding: 2rem 1.85rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .pkg-card:nth-child(1) {
    border-top-color: #059669;
  }
  .pkg-card:nth-child(3) {
    border-top-color: #f59e0b;
  }
  .pkg-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .pkg-card h3 {
    font-size: 1.28rem;
    line-height: 1.3;
    color: #0f172a;
  }
  .pkg-price {
    font-size: 1.12rem;
    font-weight: 800;
    color: #059669;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.25rem 0.7rem;
    border-radius: 0.4rem;
  }
  .pkg-card p:not(.pkg-price) {
    font-size: 0.94rem;
    color: #475569;
    line-height: 1.68;
  }
  .pkg-card ul {
    width: 100%;
    list-style: none;
    font-size: 0.88rem;
    font-weight: 600;
    color: #1e293b;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }
  .pkg-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 640px) {
    .pkg-card {
      padding: 1.25rem;
    }
    .pkg-faq-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
