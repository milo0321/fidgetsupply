---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const allProducts = (await getCollection('products')).sort((a, b) => a.data.rowId - b.data.rowId);

const tierBudget = allProducts.filter((p) => parseFloat(p.data.tier500) <= 3.5);
const tierMid = allProducts.filter((p) => parseFloat(p.data.tier500) > 3.5 && parseFloat(p.data.tier500) <= 10.0);
const tierPremium = allProducts.filter((p) => parseFloat(p.data.tier500) > 10.0 && parseFloat(p.data.tier500) <= 45.0);
const tierExotic = allProducts.filter((p) => parseFloat(p.data.tier500) > 45.0);

const showcaseMatrix = [
  ...tierBudget.slice(0, 2),
  ...tierMid.slice(0, 2),
  ...tierPremium.slice(0, 2),
  ...tierExotic.slice(0, 2)
];

const PAGE_TITLES: Record<string, string> = {
  en: 'Wholesale Metal Fidget Catalog & 140-SKU Factory Price List',
  de: 'Metall-Fidget Großhandel Katalog & 140-SKU Fabrikpreisliste',
  fr: 'Catalogue Grossiste Fidget Métal & Liste de Prix 140 SKU',
  nl: 'Groothandel Metalen Fidget Catalogus & 140-SKU Prijslijst',
  es: 'Catálogo Mayorista Fidget Metálico y Lista de Precios 140 SKU',
  it: 'Catalogo Ingrosso Fidget Metallo e Listino Prezzi 140 SKU',
  pt: 'Catálogo Atacado Fidget Metálico e Tabela de Preços 140 SKU',
  sv: 'Grossistkatalog Metallfidgets & 140-SKU Fabriksprislista',
  da: 'Engroskatalog Metalfidgets & 140-SKU Fabriksprisliste',
  no: 'Grossistkatalog Metallfidgets & 140-SKU Fabrikkprisliste',
  fi: 'Metallifidget Tukkuluettelo & 140-SKU Tehdashinnasto',
  pl: 'Katalog Hurtowy Metalowych Fidgetów i Cennik 140 SKU',
  cs: 'Velkoobchodní Katalog Kovových Fidgetů a Ceník 140 SKU',
  ru: 'Оптовый каталог металлических фиджетов и прайс-лист 140 SKU',
  ja: '金属フィジェット卸売カタログ＆140品番工場価格表',
  ko: '메탈 피젯 도매 카탈로그 & 140종 공장 직판 가격표',
  id: 'Katalog Grosir Fidget Logam & Daftar Harga Pabrik 140 SKU',
  ar: 'كتالوج الجملة للفيدجت المعدني وقائمة أسعار 140 منتجاً'
};

const PAGE_DESCS: Record<string, string> = {
  en: 'Factory-direct wholesale metal fidget spinner & slider price list: 140 ready molds ($0.74–$470.77, $0 mold fee), 50-pc blank MOQ, 100-pc laser logo.',
  de: 'Direkte Fabrikpreisliste für Metall-Fidget-Spinner & Slider: 140 Serienformen ($0.74–$470.77, $0 Werkzeugkosten), MOQ 50 blanko, 100 mit 50W-Laser.',
  fr: 'Tarif usine direct fidgets métal (spinners, sliders, pièces) : 140 moules prêts (0,74 $–470,77 $, 0 $ moule), MOQ 50 neutres, 100 avec logo laser.',
  nl: 'Fabrieksprijslijst metalen fidget spinners & sliders: 140 mallen ($0.74–$470.77, $0 matrijskosten), MOQ 50 blanco of 100 met 50W fiberlaserlogo.',
  es: 'Lista de precios de fábrica para fidget spinners y sliders metálicos: 140 moldes ($0.74–$470.77, $0 molde), MOQ 50 sin logo, 100 con láser 50W.',
  it: 'Listino prezzi fabbrica fidget spinner e slider in metallo: 140 stampi ($0.74–$470.77, $0 stampo), MOQ 50 neutri o 100 con logo laser 50W.',
  pt: 'Tabela de preços de fábrica para fidget spinners e sliders metálicos: 140 moldes ($0.74–$470.77, $0 molde), MOQ 50 lisos, 100 com logo a laser.',
  sv: 'Fabriksprislista för metallfidgets, spinners och sliders: 140 formar ($0.74–$470.77, $0 verktyg), MOQ 50 blanka, 100 med 50W fiberlaserlogo.',
  da: 'Fabriksprisliste på metal fidget spinners & sliders: 140 færdige forme ($0.74–$470.77, $0 værktøj), MOQ 50 blanke eller 100 med 50W laserlogo.',
  no: 'Fabrikkprisliste for metall fidget spinners og sliders: 140 former ($0.74–$470.77, $0 verktøy), MOQ 50 blanke, 100 med 50W fiberlaserlogo.',
  fi: 'Tehdashinnasto metallifidgeteille, spinnereille ja slidereille: 140 muottia ($0.74–$470.77, $0 muotti), MOQ 50 ilman logoa, 100 laserlogolla.',
  pl: 'Cennik fabryczny metalowych spinnerów i sliderów: 140 gotowych form ($0.74–$470.77, $0 za formę), MOQ 50 bez logo, 100 z grawerem laserowym 50W.',
  cs: 'Tovární ceník kovových fidget spinnerů a sliderů: 140 hotových forem ($0.74–$470.77, $0 za formu), MOQ 50 bez loga, 100 ks s 50W laserem.',
  ru: 'Заводской оптовый прайс-лист металлических спиннеров и слайдеров: 140 форм ($0.74–$470.77, $0 пресс-форма), MOQ 50 без лого, 100 с лазером.',
  ja: '金属フィジェットスピナー＆スライダー工場直販価格表：既存140金型（$0.74〜$470.77・金型代$0）、無地MOQ 50個、50Wレーザー名入れ100個〜。',
  ko: '메탈 피젯 스피너 & 슬라이더 공장 직판 가격표: 140종 기성 금형($0.74–$470.77, 금형비 $0), 무지 MOQ 50개, 50W 레이저 로고 100개부터.',
  id: 'Daftar harga pabrik grosir fidget spinner & slider logam: 140 cetakan ($0.74–$470.77, $0 cetakan), MOQ 50 polos, 100 dengan logo laser 50W.',
  ar: 'قائمة أسعار المصنع المباشرة للفيدجت المعدني: 140 قالباً جاهزاً (0.74$–470.77$، قالب 0$)، الحد الأدنى 50 قطعة بدون شعار و100 قطعة بالليزر.'
};

const catalogFaqs = [
  {
    question: 'What is the full EXW factory wholesale price range across FidgetSupply’s 140 ready molds?',
    answer: 'Across our 140 active molds (FS-001 to FS-150), 500-piece tier EXW prices span from $0.74/pc for compact Zamak-3 pocket spinners (FS-009) up to $470.77/pc for multi-metal CNC Zirconium & Titanium collector editions. Over 85 models fall in the high-velocity $1.70–$12.50 wholesale band.'
  },
  {
    question: 'How are volume price tiers structured (50 pcs vs. 200 pcs vs. 500+ pcs)?',
    answer: 'Every product page displays transparent 3-tier factory pricing: Tier 1 (50–199 pcs), Tier 2 (200–499 pcs), and Tier 3 (500+ pcs). Moving from 50 pcs to 500 pcs typically lowers unit factory cost by 15%–22%, with additional discounts available for 1,000+ piece runs.'
  },
  {
    question: 'Do we have to pay mold or tooling fees when sourcing from the 140-SKU wholesale catalog?',
    answer: 'No. All 140 catalog SKUs use existing hardened die-casting molds and CNC fixtures maintained across our integrated partner workshops, so your mold tooling cost is $0.00.'
  },
  {
    question: 'Can we order a 50-piece Mix-SKU starter assortment instead of 50 pieces of one single model?',
    answer: 'Yes. For ready-stock blank models, we support Mix-SKU starter batches so retail shops, e-commerce sellers, and distributors can test 5 to 10 models in their first shipment before scaling winning SKUs.'
  },
  {
    question: 'What is the difference in wholesale cost between Zamak-3 zinc alloy, 6063 aluminum, and CNC 304 stainless steel?',
    answer: 'High-pressure die-cast Zamak-3 zinc alloy sits in the $0.74–$6.80 wholesale tier, CNC 6063 anodized aluminum ranges from $4.50–$12.55, and 5-axis CNC 304/316 stainless steel ranges from $8.49–$43.94.'
  },
  {
    question: 'How much does custom 50W fiber laser engraving or deep color-fill logo branding add to the catalog unit price?',
    answer: 'Standard monochrome 50W MOPA fiber laser engraving adds +$0.15 to $0.30/pc (MOQ 100 pcs, $0 setup fee), while Deep Laser Engraving + Pantone Enamel Color Fill adds +$0.35 to $0.60/pc (MOQ 100–200 pcs).'
  },
  {
    question: 'What packaging options are available and how much do they add per unit?',
    answer: 'Every unit includes standard scratch-protective packaging. Custom logo Black EVA Zipper Cases add +$0.75/pc (MOQ 100), Matte Window Metal Tin Boxes add +$0.85/pc (MOQ 200), and Two-Piece Rigid Luxury Gift Boxes add +$1.10/pc (MOQ 300).'
  },
  {
    question: 'Can I receive the complete 140-SKU catalog as a downloadable Excel / PDF price sheet?',
    answer: 'Yes. Enter your work email or WhatsApp in the inline bar above (or message +86 187 5012 6315 on WhatsApp) and our Fuzhou export desk will send the complete 140-SKU spreadsheet with exact 50/200/500-pc EXW pricing, weights, dimensions, and magnet specs.'
  },
  {
    question: 'Can we order paid 1-piece samples from the catalog before placing a bulk order?',
    answer: 'Yes. Paid 1-piece evaluation samples are available across all 140 models; sample unit fees and international courier shipping are paid by the buyer and are non-refundable.'
  },
  {
    question: 'Do you handle IATA PI953 magnetic shielding and DDP door-to-door shipping for bulk orders?',
    answer: 'Yes. Our Fuzhou Export Hub packs bulk magnetic shipments with ferromagnetic shielding sheets to comply with IATA DGR Packing Instruction 953 (PI953 / PI-953) and arranges EXW, FOB, or DDP Air/Sea logistics.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: catalogFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'FidgetSupply 140-SKU Wholesale Metal EDC Fidget Price List',
  numberOfItems: allProducts.length,
  url: `https://fidgetsupply.com${getLocalizedPath('/wholesale-catalog', currentLang)}`
};
---

<Layout
  title={PAGE_TITLES[currentLang] || PAGE_TITLES.en}
  description={PAGE_DESCS[currentLang] || PAGE_DESCS.en}
  ogImage="/images/factory/showcase-2.webp"
  activePage="products"
  jsonLd={[catalogSchema, faqSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">140-SKU Price List</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">FACTORY-DIRECT EXW MATRIX</span>
          <span class="badge badge-emerald">140 Active Molds · $0.00 Tooling</span>
        </div>

        <h1 class="grand-hero-title">{PAGE_TITLES[currentLang] || PAGE_TITLES.en}</h1>
        <p class="grand-hero-lead">
          {PAGE_DESCS[currentLang] || PAGE_DESCS.en}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Entry Tier (&le;$3.50)</span>
            <strong class="glass-kpi-val">{tierBudget.length} Molds</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Core Retail ($3.51–$10)</span>
            <strong class="glass-kpi-val">{tierMid.length} Molds</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">CNC Pro ($10.01–$45)</span>
            <strong class="glass-kpi-val">{tierPremium.length} Molds</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Exotic / Zr ($45+)</span>
            <strong class="glass-kpi-val">{tierExotic.length} Molds</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/products', currentLang)} class="btn btn-accent btn-hero">
            Browse All {allProducts.length} SKUs →
          </a>
          <a href={getLocalizedPath('/sample-kit', currentLang)} class="btn btn-secondary-dark btn-hero">
            1-{t('unit.pc')} Sample Program →
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">3-TIER VOLUME PRICING</span>
          <span class="hero-showcase-price">$0.74 – $470.77</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/factory/showcase-2.webp"
            alt="FidgetSupply 140-SKU wholesale metal fidget price list across zinc alloy, aluminum, stainless steel, and zirconium"
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>MOQ 50 Blank</span>
          <span>MOQ 100 Laser Logo</span>
          <span>50-Pc Mix-SKU OK</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title="Direct Answer: 140-SKU Wholesale Metal Fidget Price Tiers & MOQs"
      answer="FidgetSupply's wholesale catalog covers 140 ready-to-produce metal EDC molds (FS-001 to FS-150) organized into four factory price bands: Entry Promo ($0.74–$3.50), Core E-Commerce ($3.51–$10.00), Precision CNC Stainless & Brass ($10.01–$45.00), and Collector Zirconium/Exotic ($45.01–$470.77). Every SKU requires $0.00 mold fees, starts at 50 pcs blank (or Mix-SKU starter batch) and 100 pcs for 50W fiber laser engraving (+$0.15–$0.30/pc), with paid 1-piece physical evaluation samples available."
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Full 140-SKU Wholesale Price Sheet (Excel/PDF · 50/200/500 Tiers)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="text"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} / WhatsApp`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">FACTORY PRICE BAND ARCHITECTURE</span>
        <h2 class="section-title">140 Ready Molds Grouped by Wholesale EXW Price Band</h2>
      </div>
      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>Price Band (500-Pc EXW)</th>
              <th>Active Molds</th>
              <th>Primary Materials &amp; Process</th>
              <th>Best-Fit Buyer Channels</th>
              <th>Typical Retail Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>$0.74 – $3.50 / pc</strong></td>
              <td>{tierBudget.length} SKUs</td>
              <td>Zamak-3 High-Pressure Die Casting, Electroplated / Antique Finish</td>
              <td>Corporate trade-show giveaways, promotional swag, high-volume gift bundles</td>
              <td>$12 – $24</td>
            </tr>
            <tr>
              <td><strong>$3.51 – $10.00 / pc</strong></td>
              <td>{tierMid.length} SKUs</td>
              <td>Zamak-3 Multi-Layer, 6063 Anodized Aluminum, Brass Hybrid, PTFE Sliders</td>
              <td>Amazon FBA private label, TikTok Shop ASMR, Shopify EDC brands</td>
              <td>$25 – $59</td>
            </tr>
            <tr>
              <td><strong>$10.01 – $45.00 / pc</strong></td>
              <td>{tierPremium.length} SKUs</td>
              <td>5-Axis CNC 304/316 Stainless Steel, Ceramic Detents, Acoustic Tuning Forks</td>
              <td>Boutique EDC stores, Kickstarter/Indiegogo drops, VIP executive gifts</td>
              <td>$65 – $180</td>
            </tr>
            <tr>
              <td><strong>$45.01 – $470.77 / pc</strong></td>
              <td>{tierExotic.length} SKUs</td>
              <td>CNC Zirconium (Zr702), Titanium, Damascus, Abalone Inlay, Multi-Metal</td>
              <td>Collector EDC clubs, limited serialized editions (001/100)</td>
              <td>$190 – $850+</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-light" style="padding: 2.5rem 1.75rem; border-radius: 1rem;">
      <div class="section-header-center">
        <span class="badge badge-emerald">REPRESENTATIVE BENCHMARKS ACROSS ALL 4 TIERS</span>
        <h2 class="section-title">Flagship Models From $0.74 Entry to Collector CNC</h2>
      </div>
      <div class="grid-4">
        {showcaseMatrix.map((p) => (
          <ProductCard product={p.data} lang={currentLang} />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">WHOLESALE CATALOG FAQ</span>
        <h2 class="section-title">Pricing Tiers, MOQ &amp; Factory Sourcing Questions</h2>
      </div>
      <div class="faq-list">
        {catalogFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
