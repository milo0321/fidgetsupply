---
import Layout from '../../layouts/Layout.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getComplianceTableData, getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const compTable = getComplianceTableData(currentLang);

const complianceFaqs = [
  {
    question: 'What is US CPSC 16 CFR Part 1262 (16 CFR 1262) and how does it apply to magnetic fidget sliders & spinners?',
    answer: 'US CPSC 16 CFR Part 1262 (16 CFR 1262 Safety Standard for Magnets) requires that entertainment and stress-relief products containing magnets either not consist of loose small magnets that fit within the CPSC small-parts cylinder (Ø31.7mm × 57.1mm) with a Flux Index >= 50 kG²mm², or ensure embedded magnets never liberate during drop, torque, and tension abuse testing. For US retail and Amazon FBA, we also supply factory CPSIA tracking labels and General Certificates of Conformity (GCC) for metal fidget spinners and sliders.'
  },
  {
    question: 'How does FidgetSupply.com prevent embedded neodymium magnets from coming loose?',
    answer: 'Every magnetic model across our 140 molds utilizes a 3-layer retention architecture: (1) precision CNC/die-cast blind pockets covered by screw-locked stainless or PTFE plates, (2) automated pneumatic dispensing of two-part modified structural epoxy (>22 MPa shear strength), and (3) medium-strength anaerobic threadlocker on all M2/M2.5 fasteners.'
  },
  {
    question: 'What drop and abuse tests do you perform before shipping bulk magnetic orders?',
    answer: 'Under our standard pre-shipment quality protocol, random production units undergo a 48-hour thermal shock cycle (-20°C to +80°C) followed by 10 consecutive drops from 1.5 meters onto a steel-backed concrete plate across 6 orientations, plus 0.45 Nm torque and 70 N tension testing with zero magnet liberation.'
  },
  {
    question: 'What age grade should Amazon FBA and retail sellers use for metal EDC fidgets?',
    answer: 'All metal EDC sliders, haptic coins, spinners, and mechanical rings should be marketed and labeled as Adult Everyday Carry (EDC) Desk Toys graded for Ages 14+ (or 15+). They are not children’s toys (under 14) and every custom packaging order includes mandatory 14+ & magnet safety warning labels.'
  },
  {
    question: 'Do you provide documentation required for Amazon US/EU safety compliance reviews?',
    answer: 'Yes. For confirmed wholesale buyers, we supply factory General Certificates of Conformity (GCC), 16 CFR Part 1262 magnet retention abuse test reports, XRF RoHS 3 / REACH heavy-metal compliance sheets, and compliant packaging artwork proofs required by Amazon Seller Central.'
  },
  {
    question: 'Are your zinc alloy, brass, and stainless steel finishes compliant with EU RoHS 3 and REACH SVHC?',
    answer: 'Yes. We use virgin Zamak #3 zinc alloy, SUS304/316 stainless steel, 6063-T6 aluminum, and RoHS-compliant lead-free brass. All electroplated and PVD finishes pass EU Directive 2015/863 (RoHS 3) for Lead, Cadmium, Mercury, and Hexavalent Chromium, as well as EN 1811 nickel-release limits.'
  },
  {
    question: 'How are neodymium magnetic fidgets cleared for international air freight (IATA DGR PI-953)?',
    answer: 'International air transport (IATA Packing Instruction 953) requires that magnetic packages produce a stray magnetic field strength below 0.00525 gauss at 4.6 meters (15 feet). Our Fuzhou Export Logistics Hub lines master cartons with high-permeability iron shielding sheets and provides DGM/IATA magnetic inspection certificates.'
  },
  {
    question: 'Do you offer 100% magnet-free metal fidgets for buyers who want zero magnet compliance requirements?',
    answer: 'Yes! We manufacture over 30 pure mechanical and rotational models that contain zero magnets—including FS-005 (304 Stainless Knuckle Roller), FS-009 (Knurled Twist Top), FS-043 & FS-066 (Multi-Axis Gimbal Gyros), FS-061 & FS-079 (Chain Sprocket Spinners), FS-063 (316 Stainless Goose Spinner), FS-067 (Bolt-Action Slider), and FS-085 / FS-092 (Mechanical Spring Ratchets).'
  },
  {
    question: 'Are California Proposition 65 compliant finishes available for US corporate gifting orders?',
    answer: 'Yes. All stainless steel, anodized aluminum, PEI Ultem, zirconium, and PVD/electroplated zinc alloy models meet California Prop 65 phthalate and heavy-metal thresholds, and we can print Prop 65 informational labels on outer packaging upon request.'
  },
  {
    question: 'Can we arrange a third-party inspection (SGS, Bureau Veritas, Intertek, or QIMA) before final payment?',
    answer: 'Absolutely. We welcome SGS, TUV, Intertek, Bureau Veritas, or QIMA inspectors at our Fuzhou Industrial Zone Export Logistics Hub prior to balance payment and shipment dispatch.'
  }
];

const localizedComplianceFaqs = getLocalizedPageFaqs('compliance', complianceFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedComplianceFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
const complianceWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'US CPSC 16 CFR 1262 Magnet Fidget Safety & EU RoHS 3 / IATA PI-953 Compliance',
  description: 'Engineering verification of US CPSC 16 CFR Part 1262 captive magnet retention (<50 kG²mm² flux index, 10x 1.5m concrete drop tests), EU RoHS 3 / REACH XRF screening, and IATA DGR PI-953 magnetic air-cargo shielding.',
  url: `https://fidgetsupply.com${getLocalizedPath('/compliance-safety', currentLang)}`
};

const COMPLIANCE_META_DESC_MAP: Record<string, string> = {
  en: 'US CPSC 16 CFR Part 1262 (16 CFR 1262) magnet safety, CPSIA GCC & tracking labels, EU RoHS 3 / EN71-3 & IATA PI953 air freight compliance for 140 molds.',
  es: 'Seguridad magnética US CPSC 16 CFR 1262 (<50 kG²mm²), retención con tornillos, cumplimiento UE RoHS 3 / REACH e IATA PI-953 para 140 moldes metálicos EDC.',
  de: 'US CPSC 16 CFR 1262 Magnetsicherheit (<50 kG²mm²), 3-fach verschraubte Magnetfixierung, EU RoHS 3 / REACH & IATA PI-953 Luftfracht-Konformität für 140 Formen.',
  fr: 'Sécurité magnétique US CPSC 16 CFR 1262 (<50 kG²mm²), rétention verrouillée par vis, conformité UE RoHS 3 / REACH et fret aérien IATA PI-953 sur 140 moules.',
  ja: '米国CPSC 16 CFR 1262磁石安全基準（<50 kG²mm²・3重ネジ固定構造）、EU RoHS 3 / REACH重金属検査、IATA PI-953航空磁気遮蔽に準拠した140種の金属EDC。',
  ko: '미국 CPSC 16 CFR 1262 자석 안전 기준(<50 kG²mm², 3중 나사 잠금 설계), EU RoHS 3 / REACH 중금속 검사 및 IATA PI-953 항공 자기 차폐를 충족하는 140종 금형.',
  ar: 'معايير سلامة المغناطيس الأمريكية CPSC 16 CFR 1262 (<50 kG²mm²)، تثبيت ثلاثي الطبقات بالبراغي، ومطابقة EU RoHS 3 / REACH والشحن الجوي IATA PI-953 لـ 140 قالباً.',
  pt: 'Segurança magnética US CPSC 16 CFR 1262 (<50 kG²mm²), retenção tripla parafusada, conformidade UE RoHS 3 / REACH e frete aéreo IATA PI-953 em 140 moldes EDC.',
  ru: 'Сертификация безопасности магнитов US CPSC 16 CFR 1262 (<50 kG²mm²), 3-слойная винтовая фиксация, соответствие EU RoHS 3 / REACH и авиаперевозкам IATA PI-953.',
  it: '16 CFR 1262 sicurezza magnetica US CPSC (<50 kG²mm²), ritenzione a 3 strati avvitata, conformità UE RoHS 3 / REACH e trasporto aereo IATA PI-953 su 140 stampi.',
  nl: 'US CPSC 16 CFR 1262 magneetveiligheid (<50 kG²mm²), 3-laags geschroefde borging, EU RoHS 3 / REACH en IATA PI-953 luchtvrachtconformiteit voor 140 EDC-mallen.',
  pl: 'Bezpieczeństwo magnesów US CPSC 16 CFR 1262 (<50 kG²mm²), 3-warstwowa blokada śrubowa, zgodność z EU RoHS 3 / REACH oraz transportem lotniczym IATA PI-953.',
  id: 'Standar keamanan magnet US CPSC 16 CFR 1262 (<50 kG²mm²), kunci sekrup 3-lapis, kepatuhan EU RoHS 3 / REACH & kargo udara IATA PI-953 untuk 140 cetakan logam.',
  sv: 'US CPSC 16 CFR 1262 magnetsäkerhet (<50 kG²mm²), 3-lagers skruvlåst infästning, EU RoHS 3 / REACH och IATA PI-953 flygfraktskompatibilitet för 140 EDC-formar.',
  no: 'US CPSC 16 CFR 1262 magnetsikkerhet (<50 kG²mm²), 3-lags skrulåst innfesting, EU RoHS 3 / REACH og IATA PI-953 flyfraktkompatibilitet for 140 metallformer.',
  da: 'US CPSC 16 CFR 1262 magnetsikkerhed (<50 kG²mm²), 3-lags skruelåst fastholdelse, EU RoHS 3 / REACH og IATA PI-953 luftfragtkompatibilitet på 140 metalforme.',
  fi: 'US CPSC 16 CFR 1262 -magneettiturvallisuus (<50 kG²mm²), 3-kerroksinen ruuvilukitus, EU RoHS 3 / REACH ja IATA PI-953 -lentorahtivaatimustenmukaisuus.',
  cs: 'Bezpečnost magnetů US CPSC 16 CFR 1262 (<50 kG²mm²), 3vrstvé šroubované uchycení, shoda s EU RoHS 3 / REACH a leteckou přepravou IATA PI-953 u 140 forem.'
};
const pageDescription = COMPLIANCE_META_DESC_MAP[currentLang] || COMPLIANCE_META_DESC_MAP.en;
---

<Layout
  title={currentLang === 'en' ? '16 CFR 1262 Magnet Safety (US CPSC), RoHS 3 & IATA PI-953' : `16 CFR 1262 · ${t('comp.heroTitle')} | FidgetSupply`}
  description={pageDescription}
  activePage="insights"
  jsonLd={[complianceWebPageSchema, faqSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{t('nav.compliance')}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-emerald">{t('comp.heroBadge')}</span>
          <span class="badge badge-dark">US CPSC · EU RoHS 3 · IATA PI-953</span>
        </div>

        <h1 class="grand-hero-title">{t('comp.heroTitle')}</h1>
        <p class="grand-hero-lead">
          {t('comp.heroDesc')}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">16 CFR 1262</span>
            <strong class="glass-kpi-val">&lt; 50 kG²mm²</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">RoHS 3 / Prop 65</span>
            <strong class="glass-kpi-val">Pb &lt; 90 ppm</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">IATA PI-953</span>
            <strong class="glass-kpi-val">&lt; 0.00525 G</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">Age Grading</span>
            <strong class="glass-kpi-val">14+ Adult EDC</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {t('nav.requestQuote')}
          </a>
          <a href={getLocalizedPath('/insights/us-cpsc-16-cfr-1262-magnet-fidget-safety-compliance', currentLang)} class="btn btn-secondary-dark btn-hero">
            {t('guides.readCta')}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">CAPTIVE MAGNET &amp; XRF AUDIT</span>
          <span class="hero-showcase-price">100% Lab Verified</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/cpsc-1262-compliance-hero.webp"
            alt={t('comp.heroTitle')}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>3-Layer Magnet Lock</span>
          <span>XRF Alloy Screening</span>
          <span>Amazon GCC Ready</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('comp.geoTitle')}
      answer={t('comp.geoAnswer')}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="16 CFR 1262 / RoHS 3 / IATA PI-953 Compliance Pack & 140-SKU Price Sheet" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <h2 style="margin-bottom: 1rem;">{t('comp.matrixTitle')}</h2>
      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              {compTable.headers.map((h) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compTable.rows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Compliance & Safety FAQ Section -->
    <section class="section section-light comp-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('comp.faqBadge')}</span>
        <h2 class="section-title">{t('comp.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedComplianceFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 0;
  }
  .page-hero h1 {
    color: #ffffff;
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    margin: 0.85rem 0;
  }
  .page-hero p {
    color: #cbd5e1;
    max-width: 820px;
    font-size: 1.05rem;
  }
  .comp-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 640px) {
    .comp-faq-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
