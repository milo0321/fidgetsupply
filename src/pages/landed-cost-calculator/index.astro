---
import Layout from '../../layouts/Layout.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getCalculatorCopy } from '../../i18n/landing/landedCostCalculator';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const copy = getCalculatorCopy(currentLang);

const PAGE_TITLES: Record<string, string> = {
  en: 'Metal Fidget Wholesale & Logo Cost Calculator (MOQ 50+)',
  de: 'Metall-Fidget Großhandel & Laser-Kalkulator (MOQ 50+)',
  fr: 'Calculateur de Coût Fidget Métal & Logo OEM (MOQ 50+)',
  nl: 'Metalen Fidget Groothandel & Logo Calculator (MOQ 50+)',
  es: 'Calculadora de Costos Fidget Metálico OEM (MOQ 50+)',
  it: 'Calcolatore Costi Fidget Metallo & Logo OEM (MOQ 50+)',
  pt: 'Calculadora de Custo Fidget Metálico & Logo (MOQ 50+)',
  sv: 'Kostnadskalkylator för Metallfidgets & Logotyp (MOQ 50+)',
  da: 'Prisberegner for Metalfidgets & Logogravering (MOQ 50+)',
  no: 'Kostnadskalkulator for Metallfidgets & Logo (MOQ 50+)',
  fi: 'Metallifidget Tukku- & Logolaskuri (MOQ 50+)',
  pl: 'Kalkulator Kosztów Metalowych Fidgetów i Logo (MOQ 50+)',
  cs: 'Kalkulačka Nákladů Kovových Fidgetů a Loga (MOQ 50+)',
  ru: 'Калькулятор стоимости опта и логотипа фиджетов (MOQ 50+)',
  ja: '金属フィジェット卸売・レーザー刻印・包装コスト計算ツール',
  ko: '메탈 피젯 도매 · 레이저 각인 · 패키징 단가 계산기',
  id: 'Kalkulator Biaya Grosir & Logo Fidget Logam (MOQ 50+)',
  ar: 'حاسبة تكلفة الجملة والليزر لأدوات الفيدجت (MOQ 50+)'
};

const PAGE_DESCS: Record<string, string> = {
  en: 'Interactive cost & margin estimator for 140 ready-mold metal fidgets: calculate 50/200/500+ tiers, 50W laser logo, EVA/gift packaging & paid sample fees.',
  de: 'Interaktiver Großhandels- & Margenrechner für 140 Metall-Fidget-Formen: Staffelpreise (50/200/500+), 50W-Laser, EVA/Geschenkbox-Verpackung & Musterkosten.',
  fr: 'Calculateur interactif de coûts OEM et marges pour 140 moules métal : paliers 50/200/500+, gravure laser 50W, étuis EVA/coffrets et frais d’échantillon.',
  nl: 'Interactieve groothandels- en margecalculator voor 140 metalen mallen: 50/200/500+ staffels, 50W laserlogo, EVA/geschenkverpakking en monsterkosten.',
  es: 'Calculadora interactiva de costos mayoristas y margen para 140 moldes metálicos: escalas 50/200/500+, láser 50W, empaque EVA/regalo y muestras.',
  it: 'Calcolatore interattivo costi all’ingrosso e margine per 140 stampi: scaglioni 50/200/500+, laser 50W, packaging EVA/regalo e campioni.',
  pt: 'Calculadora interativa de custo atacado e margem para 140 moldes: faixas 50/200/500+, laser 50W, estojos EVA/caixas e taxas de amostra.',
  sv: 'Interaktiv kalkylator för grossistkostnad och marginal på 140 metallformar: volymsteg 50/200/500+, 50W laser, EVA/presentförpackning & provkostnad.',
  da: 'Interaktiv engrospris- og avanceberegner til 140 metalforme: mængderabatter 50/200/500+, 50W laser, EVA/gaveæske og prøveomkostninger.',
  no: 'Interaktiv engros- og marginkalkulator for 140 metallformer: volumtrinn 50/200/500+, 50W laser, EVA/gaveeske og prøvegebyr.',
  fi: 'Interaktiivinen tukkuhinta- ja katelaskuri 140 metallimuotille: 50/200/500+ portaat, 50W laserlogo, EVA/lahjapakkaus ja näytekulut.',
  pl: 'Interaktywny kalkulator kosztów hurtowych i marży dla 140 form metalowych: progi 50/200/500+, grawer 50W, opakowania EVA/prezentowe i próbki.',
  cs: 'Interaktivní kalkulačka velkoobchodní ceny a marže pro 140 kovových forem: stupně 50/200/500+, 50W laser, obaly EVA/dárkové boxy a vzorky.',
  ru: 'Интерактивный калькулятор оптовой цены и маржи для 140 металлических форм: объемы 50/200/500+, лазер 50 Вт, упаковка EVA/коробки и образцы.',
  ja: '既存140金型の金属フィジェット卸売・利益率シミュレーター：数量別単価・50Wレーザー刻印・EVA/化粧箱パッケージ・サンプル費用を即時試算。',
  ko: '140종 기성 금형 메탈 피젯 도매 단가 및 마진 계산기: 수량별(50/200/500+) 단가, 50W 레이저 각인, EVA/선물박스 패키징 비용 즉시 산출.',
  id: 'Kalkulator biaya grosir & margin ritel untuk 140 cetakan fidget logam: hitung harga 50/200/500+, laser 50W, kemasan EVA/kado & sampel.',
  ar: 'حاسبة تفاعلية لتكلفة الجملة وهامش الربح عبر 140 قالباً: شرائح 50/200/500+ قطعة، حفر ليزر 50W، تغليف EVA وصناديق الهدايا وتكلفة العينة.'
};

const calcFaqs = copy.faqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: calcFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: copy.appName,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  url: `https://fidgetsupply.com${getLocalizedPath('/landed-cost-calculator', currentLang)}`,
  description: copy.appDesc
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: copy.bcParent, item: `https://fidgetsupply.com${getLocalizedPath('/wholesale-catalog', currentLang)}` },
    { '@type': 'ListItem', position: 3, name: copy.bcCurrent, item: `https://fidgetsupply.com${getLocalizedPath('/landed-cost-calculator', currentLang)}` }
  ]
};
---

<Layout
  title={PAGE_TITLES[currentLang] || PAGE_TITLES.en}
  description={PAGE_DESCS[currentLang] || PAGE_DESCS.en}
  ogImage="/images/insights/zinc-vs-cnc-metallurgy-hero.webp"
  activePage="wholesale-catalog"
  jsonLd={[appSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/wholesale-catalog', currentLang)}>{copy.bcParent}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{copy.bcCurrent}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{copy.badge1}</span>
          <span class="badge badge-emerald">{copy.badge2}</span>
        </div>

        <h1 class="grand-hero-title">{PAGE_TITLES[currentLang] || PAGE_TITLES.en}</h1>
        <p class="grand-hero-lead">
          {PAGE_DESCS[currentLang] || PAGE_DESCS.en}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[0].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[0].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[1].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[1].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[2].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[2].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[3].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[3].val}</strong>
          </div>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">{copy.showcasePill}</span>
          <span class="hero-showcase-price">MOQ 50+</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/zinc-vs-cnc-metallurgy-hero.webp"
            alt={`${PAGE_TITLES[currentLang] || PAGE_TITLES.en} — FidgetSupply`}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>{copy.showcaseMeta[0]}</span>
          <span>{copy.showcaseMeta[1]}</span>
          <span>{copy.showcaseMeta[2]}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={copy.geoTitle}
      answer={copy.geoAnswer}
    />

    <section class="section" id="calculator-workspace" data-calc-i18n={JSON.stringify(copy.runtime)}>
      <div class="section-header-center">
        <span class="badge">{copy.wsBadge}</span>
        <h2 class="section-title">{copy.wsTitle}</h2>
      </div>

      <div class="calc-grid">
        <div class="calc-controls-card">
          <div class="calc-field">
            <label class="calc-label" for="calc-tier">{copy.labels.step1}</label>
            <select id="calc-tier" class="calc-select">
              <option value="promo">{copy.tierOptions.promo}</option>
              <option value="slider" selected>{copy.tierOptions.slider}</option>
              <option value="cnc">{copy.tierOptions.cnc}</option>
              <option value="acoustic">{copy.tierOptions.acoustic}</option>
            </select>
          </div>

          <div class="calc-field">
            <span class="calc-label">{copy.labels.step2}</span>
            <div class="calc-qty-pills" id="calc-qty-pills">
              <button type="button" class="qty-pill" data-qty="50">50 {t('unit.pcs')}</button>
              <button type="button" class="qty-pill" data-qty="100">100 {t('unit.pcs')}</button>
              <button type="button" class="qty-pill active" data-qty="200">200 {t('unit.pcs')}</button>
              <button type="button" class="qty-pill" data-qty="500">500 {t('unit.pcs')}</button>
              <button type="button" class="qty-pill" data-qty="1000">1,000 {t('unit.pcs')}</button>
            </div>
          </div>

          <div class="calc-field">
            <label class="calc-label" for="calc-branding">{copy.labels.step3}</label>
            <select id="calc-branding" class="calc-select">
              <option value="blank">{copy.brandOptions.blank}</option>
              <option value="laser" selected>{copy.brandOptions.laser}</option>
              <option value="enamel">{copy.brandOptions.enamel}</option>
            </select>
          </div>

          <div class="calc-field">
            <label class="calc-label" for="calc-packaging">{copy.labels.step4}</label>
            <select id="calc-packaging" class="calc-select">
              <option value="vacuum">{copy.pkgOptions.vacuum}</option>
              <option value="eva" selected>{copy.pkgOptions.eva}</option>
              <option value="rigid">{copy.pkgOptions.rigid}</option>
              <option value="tin">{copy.pkgOptions.tin}</option>
            </select>
          </div>

          <div class="calc-field">
            <label class="calc-label" for="calc-msrp">{copy.labels.step5}</label>
            <input id="calc-msrp" type="number" class="calc-input" value="24.99" min="1" step="0.5" />
          </div>

          <div id="calc-moq-alert" class="calc-alert" hidden></div>
        </div>

        <div class="calc-summary-card">
          <div class="calc-summary-top">
            <span class="calc-badge-live">{copy.summary.badge}</span>
            <span class="calc-mold-pill">{copy.summary.moldPill}</span>
          </div>

          <div class="calc-main-metric">
            <span class="calc-metric-label">{copy.summary.unitCostLabel}</span>
            <strong class="calc-metric-value" id="out-unit-cost">$4.50</strong>
          </div>

          <div class="calc-kpi-rows">
            <div class="calc-kpi-row">
              <span>{copy.summary.batchTotalLabel}</span>
              <strong id="out-batch-total">$900.00 USD</strong>
            </div>
            <div class="calc-kpi-row">
              <span>{copy.summary.tierBreakLabel}</span>
              <strong id="out-base-breakdown">$3.55/{copy.runtime.pcWord} ({copy.runtime.bracket200})</strong>
            </div>
            <div class="calc-kpi-row">
              <span>{copy.summary.addonLabel}</span>
              <strong id="out-addon-breakdown">+$0.95/{copy.runtime.pcWord}</strong>
            </div>
            <div class="calc-kpi-row">
              <span>{copy.summary.marginLabel}</span>
              <strong class="calc-profit-hl" id="out-margin">82.0% ($4,098 {copy.runtime.grossWord})</strong>
            </div>
            <div class="calc-kpi-row">
              <span>{copy.summary.sampleRefLabel}</span>
              <strong id="out-sample-ref">{copy.runtime.brandSamples.laser}</strong>
            </div>
            <div class="calc-kpi-row">
              <span>{copy.summary.leadTimeLabel}</span>
              <strong id="out-leadtime">{copy.runtime.brandDays.laser}</strong>
            </div>
          </div>

          <p class="calc-disclaimer">
            {copy.summary.disclaimer}
          </p>

          <form id="calc-sheet-form" class="inline-quick-sheet-form calc-embedded-form" data-inline-sku="Cost Calculator Quote: Core Slider | 200 pcs | 50W Laser | EVA Case ($4.50/pc EXW)" novalidate>
            <div class="inline-qrfq-text">
              <strong>{microHooks.getFullSheetPdf}</strong>
              <span>{copy.summary.formSubtext}</span>
            </div>
            <div class="inline-qrfq-controls">
              <input
                type="email"
                class="inline-qrfq-input"
                placeholder={`${t('contact.workEmail')} (name@company.com)`}
                aria-label={t('contact.workEmail')}
                required
              />
              <button type="submit" class="inline-qrfq-btn">
                ⚡ {microHooks.sheet140} →
              </button>
            </div>
            <div class="inline-qrfq-status" hidden></div>
          </form>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.faqBadge}</span>
        <h2 class="section-title">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {calcFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    const wsEl = document.getElementById('calculator-workspace');
    let i18n = {};
    try {
      i18n = JSON.parse((wsEl && wsEl.getAttribute('data-calc-i18n')) || '{}');
    } catch (_) {
      i18n = {};
    }
    const tl = i18n.tierLabels || {};
    const bl = i18n.brandLabels || {};
    const bs = i18n.brandSamples || {};
    const bd = i18n.brandDays || {};
    const pl = i18n.pkgLabels || {};
    const pcWord = i18n.pcWord || 'pc';
    const pcsWord = i18n.pcsWord || 'pcs';

    const BASE_PRICES = {
      promo: { label: tl.promo || 'Entry Promo Zinc', t50: 0.92, t200: 0.82, t500: 0.74 },
      slider: { label: tl.slider || 'Core Magnetic Slider', t50: 3.92, t200: 3.55, t500: 3.18 },
      cnc: { label: tl.cnc || 'CNC 304SS Coin/Slider', t50: 9.15, t200: 8.29, t500: 7.43 },
      acoustic: { label: tl.acoustic || 'Acoustic / Multi-Layer', t50: 17.80, t200: 16.10, t500: 14.50 }
    };
    const BRANDING_COSTS = {
      blank: { cost: 0, moq: 50, sample: bs.blank || '1-Pc Unit Cost + Buyer Courier', days: bd.blank || '5–7 Business Days', label: bl.blank || 'Blank' },
      laser: { cost: 0.20, moq: 100, sample: bs.laser || '$50 Laser Setup + Buyer Courier', days: bd.laser || '10–15 Business Days', label: bl.laser || '50W Laser' },
      enamel: { cost: 0.45, moq: 100, sample: bs.enamel || '$80–$150 Color-Fill Setup + Courier', days: bd.enamel || '10–15 Business Days', label: bl.enamel || 'Deep Laser + Color' }
    };
    const PKG_COSTS = {
      vacuum: { cost: 0, moq: 50, label: pl.vacuum || 'Vacuum Pouch' },
      eva: { cost: 0.75, moq: 100, label: pl.eva || 'Stock EVA Case' },
      rigid: { cost: 1.45, moq: 500, label: pl.rigid || 'Rigid Gift Box' },
      tin: { cost: 1.15, moq: 1000, label: pl.tin || 'Window Tin MTO' }
    };

    let selectedQty = 200;
    const tierEl = document.getElementById('calc-tier');
    const brandEl = document.getElementById('calc-branding');
    const pkgEl = document.getElementById('calc-packaging');
    const msrpEl = document.getElementById('calc-msrp');
    const alertEl = document.getElementById('calc-moq-alert');
    const qtyButtons = document.querySelectorAll('#calc-qty-pills .qty-pill');

    function recalc() {
      const tier = BASE_PRICES[tierEl.value] || BASE_PRICES.slider;
      const brand = BRANDING_COSTS[brandEl.value] || BRANDING_COSTS.laser;
      const pkg = PKG_COSTS[pkgEl.value] || PKG_COSTS.eva;
      const msrp = Math.max(0.5, parseFloat(msrpEl.value || '24.99'));

      let baseUnit = tier.t50;
      let bracket = i18n.bracket50 || '50–199 bracket';
      if (selectedQty >= 500) {
        baseUnit = tier.t500;
        bracket = i18n.bracket500 || '500+ bracket';
      } else if (selectedQty >= 200) {
        baseUnit = tier.t200;
        bracket = i18n.bracket200 || '200–499 bracket';
      }

      const addonUnit = brand.cost + pkg.cost;
      const unitCost = baseUnit + addonUnit;
      const batchCost = unitCost * selectedQty;
      const marginPct = msrp > 0 ? ((msrp - unitCost) / msrp) * 100 : 0;
      const batchProfit = (msrp - unitCost) * selectedQty;

      document.getElementById('out-unit-cost').textContent = '$' + unitCost.toFixed(2);
      document.getElementById('out-batch-total').textContent = '$' + batchCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
      document.getElementById('out-base-breakdown').textContent = '$' + baseUnit.toFixed(2) + '/' + pcWord + ' (' + bracket + ')';
      document.getElementById('out-addon-breakdown').textContent = '+$' + addonUnit.toFixed(2) + '/' + pcWord;
      document.getElementById('out-margin').textContent = marginPct.toFixed(1) + '% ($' + Math.round(batchProfit).toLocaleString('en-US') + ' ' + (i18n.grossWord || 'gross') + ')';
      document.getElementById('out-sample-ref').textContent = brand.sample;
      document.getElementById('out-leadtime').textContent = brand.days;

      const reqWord = i18n.requiresMoq || 'requires MOQ';
      const warnings = [];
      if (selectedQty < brand.moq) warnings.push(brand.label + ' ' + reqWord + ' ' + brand.moq + ' ' + pcsWord + '.');
      if (selectedQty < pkg.moq) warnings.push(pkg.label + ' ' + reqWord + ' ' + pkg.moq + ' ' + pcsWord + '.');
      if (warnings.length) {
        alertEl.textContent = (i18n.moqNoticePrefix || '⚠ MOQ Notice: ') + warnings.join(' ');
        alertEl.hidden = false;
      } else {
        alertEl.hidden = true;
      }

      const formEl = document.getElementById('calc-sheet-form');
      if (formEl) {
        formEl.setAttribute('data-inline-sku', 'Cost Calculator: ' + tier.label + ' | ' + selectedQty + ' ' + pcsWord + ' | ' + brand.label + ' | ' + pkg.label + ' ($' + unitCost.toFixed(2) + '/pc EXW)');
      }
    }

    qtyButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        qtyButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        selectedQty = parseInt(btn.getAttribute('data-qty') || '200', 10);
        recalc();
      });
    });
    [tierEl, brandEl, pkgEl, msrpEl].forEach((el) => el && el.addEventListener('input', recalc));
    recalc();
  })();
</script>

<style>
  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.75rem;
    align-items: start;
  }
  .calc-controls-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 1.15rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    min-width: 0;
  }
  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .calc-label {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0f172a;
  }
  .calc-select,
  .calc-input {
    width: 100%;
    padding: 0.72rem 0.9rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.92rem;
    color: #0f172a;
    background: #f8fafc;
    font-weight: 600;
  }
  .calc-qty-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .qty-pill {
    padding: 0.55rem 0.95rem;
    border-radius: 9999px;
    border: 1.5px solid #cbd5e1;
    background: #f8fafc;
    color: #0f172a;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .qty-pill.active,
  .qty-pill:hover {
    background: #0369a1;
    color: #ffffff;
    border-color: #0369a1;
  }
  .calc-alert {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: #fffbeb;
    border: 1px solid #f59e0b;
    color: #92400e;
    font-size: 0.84rem;
    font-weight: 700;
  }
  .calc-summary-card {
    background: linear-gradient(155deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 1.15rem;
    padding: 1.75rem;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.25);
    overflow: hidden;
