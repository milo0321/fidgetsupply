---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations } from '../../i18n/utils';
import { localizeInsightMeta } from '../../i18n/insightAndCollectionLocalization';
import { getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);

const guides = (await getCollection('insights')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const guidesHubFaqs = [
  {
    question: 'What topics are covered in the FidgetSupply Engineering & Global Sourcing Insights?',
    answer: 'Our 6 core technical insights cover: (1) Zero-Tooling Ready-Mold Private Label SOP, (2) N35 vs. N52 Neodymium Magnet Pull Force & Haptic Calibration, (3) Die-Cast Zinc Alloy vs. 5-Axis CNC Stainless Steel/PEI Cost Breakdown, (4) Acoustic Tuning Fork Resonance Slider Engineering, (5) 50W Fiber Laser vs. UV Color Logo Branding Durability, and (6) US CPSC 16 CFR 1262 Magnet Safety Compliance.'
  },
  {
    question: 'How do I choose between N35, N45, N52, and N54 neodymium magnets when sourcing sliders?',
    answer: 'As detailed in our Magnetics Guide, N35–N40 magnets are ideal for mechanical track sliders with ball detents where low sliding resistance is preferred, whereas N50–N54 high-flux magnets are mandatory for PTFE unlimited free-floating sliders (like FS-125 and FS-128) so the two plates remain tightly coupled.'
  },
  {
    question: 'When should a Wholesale brand choose Die-Cast Zinc Alloy vs. CNC 304/316 Stainless Steel?',
    answer: 'Choose Zamak #3 Die-Cast Zinc Alloy ($0.75–$9.00 wholesale) for promotional giveaways, corporate swag bags, and entry-level retail under $25. Choose 5-axis CNC 304/316 Stainless Steel, Amber PEI Ultem, or Zirconium ($10–$380+ wholesale) for collector EDC brands retailing at $49–$350.'
  },
  {
    question: 'Why are Acoustic Tuning Fork Fidget Sliders the fastest-growing Wholesale category in 2026–2027?',
    answer: 'Short-form video platforms (TikTok Shop, YouTube Shorts, Instagram Reels) reward products with an unmistakable ASMR audio hook. Cantilevered tuning-fork sliders (such as FS-150, FS-129, and FS-148) produce a sustained 2,800–4,200 Hz metallic "Ding!" chime that drives 3× higher video conversion rates.'
  },
  {
    question: 'How does the "Keep Ready Mold + Add Custom Logo" SOP save $3,000+ for new brands?',
    answer: 'Opening a custom multi-cavity die-casting mold or dedicated CNC fixture typically costs $3,000–$4,500 and takes 35–45 days. By selecting from our 28 Logo-Ready existing molds and adding Fiber Laser or UV branding at 100 pcs MOQ, you launch in 7–10 days with $0 tooling investment.'
  },
  {
    question: 'Which logo branding method lasts longest on everyday-carry metal surfaces?',
    answer: 'Our factory does NOT recommend surface silk-screen or UV ink printing on metal fidgets because smooth, chemically inert metal surfaces lack ink adhesion and peel off under thumb friction. Instead, we recommend 50W MOPA Fiber Laser Engraving for monochrome logos (+$0.15–$0.30/pc, $50 sample) and Deep Laser Engraving + Color Fill for colored logos (+$0.35–$0.60/pc, $80–$150 sample), where the color is locked inside a recessed laser cavity.'
  },
  {
    question: 'How do your insights help Amazon FBA sellers pass US CPSC 16 CFR Part 1262 magnet safety reviews?',
    answer: 'Our CPSC 16 CFR 1262 Compliance Report documents our 3-layer captive magnet retention architecture, thermal-shock drop test protocols, and 14+ Adult EDC warning label standards required by Amazon Seller Central compliance teams.'
  },
  {
    question: 'Do your engineering insights reference real, orderable factory SKU codes?',
    answer: 'Yes. Every article links directly to live production SKUs (FS-001 through FS-150) with exact millimeter dimensions, gram weights, magnet array counts, and 50/200/500+ pcs USD wholesale pricing.'
  },
  {
    question: 'Can we request custom engineering advice or CAD evaluation from your supply chain team?',
    answer: 'Yes. Message our sourcing engineers directly on WhatsApp (+86 187 5012 6315) or email sales@fidgetsupply.com to review magnet grade selection, surface finish pairing, or custom OEM CAD feasibility.'
  },
  {
    question: 'How can we test the materials and mechanisms discussed in these insights?',
    answer: 'Visit our /contact page and list the SKU codes you would like to evaluate before placing your bulk order.'
  }
];

const localizedGuidesHubFaqs = getLocalizedPageFaqs('insights', guidesHubFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedGuidesHubFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---

<Layout
  title={currentLang === 'en' ? 'Metal Fidget Engineering & Sourcing Insights | FidgetSupply' : `${t('guides.heroTitle')} | FidgetSupply`}
  description={currentLang === 'en' ? '30 wholesale engineering guides on N35 vs N52 magnets, Zinc Alloy vs CNC Stainless costs, Tuning Fork sliders, laser branding & CPSC 16 CFR 1262 safety.' : t('guides.heroDesc')}
  activePage="insights"
  jsonLd={faqSchema}
>
  <section class="grand-hero">
    <div class="container grand-hero-centered">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{t('breadcrumb.guides')}</span>
      </nav>

      <div class="hero-badges-row">
        <span class="badge badge-dark">{t('guides.heroBadge')}</span>
        <span class="badge badge-gold">{guides.length} {t('breadcrumb.guides')}</span>
      </div>

      <h1 class="grand-hero-title">{t('guides.heroTitle')}</h1>
      <p class="grand-hero-lead">
        {t('guides.heroDesc')}
      </p>

      <!-- Live Search Bar -->
      <div class="insights-search-wrap">
        <svg class="insights-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input
          type="search"
          id="insightsSearchInput"
          placeholder={t('catalog.searchPlaceholder')}
          autocomplete="off"
        />
      </div>

      <!-- 3 Frosted Glass Data Stats Cards -->
      <div class="hero-glass-grid cols-3">
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('breadcrumb.guides')}</span>
          <strong class="glass-kpi-val">{guides.length}</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('col.stat1Label')}</span>
          <strong class="glass-kpi-val">140 SKUs</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('nav.compliance')}</span>
          <strong class="glass-kpi-val">CPSC · RoHS · IATA</strong>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('guides.geoTitle')}
      answer={t('guides.geoAnswer')}
    />

    <section class="section">
      <div class="grid-3" id="insightsGrid">
        {guides.map((g) => {
          const lm = localizeInsightMeta(g.data, currentLang);
          return (
            <article class="guide-card" data-search={`${lm.title} ${lm.summary} ${lm.category} ${g.data.slug}`.toLowerCase()}>
              <a href={getLocalizedPath(`/insights/${g.data.slug}`, currentLang)} class="guide-img-link">
                <img src={g.data.featuredImage} alt={lm.title} width="400" height="300" />
              </a>
              <div class="guide-body">
                <div class="guide-meta">
                  <span class="guide-cat">{lm.category}</span>
                  <span>{lm.readTime}</span>
                </div>
                <h2>
                  <a href={getLocalizedPath(`/insights/${g.data.slug}`, currentLang)}>{lm.title}</a>
                </h2>
                <p>{lm.summary}</p>
                <a href={getLocalizedPath(`/insights/${g.data.slug}`, currentLang)} class="guide-cta">{t('guides.readCta')}</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Guides Hub FAQ Section -->
    <section class="section section-light guides-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('guides.faqBadge')}</span>
        <h2 class="section-title">{t('guides.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedGuidesHubFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    var searchInput = document.getElementById('insightsSearchInput');
    var cards = document.querySelectorAll('#insightsGrid .guide-card');
    if (!searchInput || !cards.length) return;
    searchInput.addEventListener('input', function () {
      var q = searchInput.value.toLowerCase().trim();
      cards.forEach(function (card) {
        var text = card.getAttribute('data-search') || '';
        card.style.display = !q || text.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();
</script>

<style>
  .insights-search-wrap {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto 1.65rem auto;
  }
  .insights-search-icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }
  .insights-search-wrap input {
    width: 100%;
    padding: 0.95rem 1.25rem 0.95rem 3.1rem;
    border-radius: 9999px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background: rgba(15, 23, 42, 0.82);
    color: #ffffff;
    font-size: 0.96rem;
    outline: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .insights-search-wrap input::placeholder {
    color: #94a3b8;
  }
  .insights-search-wrap input:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.22);
  }
  .guide-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.85rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }
  .guide-img-link {
    aspect-ratio: 4 / 3;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
    overflow: hidden;
  }
  .guide-img-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .guide-body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .guide-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 0.5rem;
  }
  .guide-cat {
    color: #0284c7;
    font-weight: 700;
  }
  .guide-body h2 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }
  .guide-body h2 a {
    color: #0f172a;
  }
  .guide-body p {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }
  .guide-cta {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0284c7;
  }
  .guides-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 640px) {
    .insights-search-wrap input {
      padding: 0.8rem 1rem 0.8rem 2.75rem;
      font-size: 0.88rem;
    }
    .guide-body {
      padding: 1.1rem;
    }
    .guide-body h2 {
      font-size: 1.04rem;
    }
    .guides-faq-box {
      padding: 1.75rem 1.15rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
