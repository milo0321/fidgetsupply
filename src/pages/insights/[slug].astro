const guideFaqs = GUIDE_FAQS_BY_SLUG[guide.data.slug] || GUIDE_FAQS_BY_SLUG['zero-tooling-ready-mold-private-label-fidget-sop'];
const localizedGuideFaqs = localizeInsightFaqs(guide.data.slug, guideFaqs, currentLang);

// Dynamic Reading Time Calculation based on actual text, technical tables, and FAQ elements
const rawText = guide.body ? guide.body.replace(/<[^>]*>?/gm, ' ') : '';
const wordCount = rawText.split(/\s+/).filter((word) => word.length > 0).length;
const tableCount = (guide.body ? guide.body.match(/<table/g) || [] : []).length;
const faqCount = localizedGuideFaqs.length;
const computedReadingMinutes = Math.max(
  8,
  Math.round(wordCount / 160 + tableCount * 1.5 + faqCount * 0.45)
);
const dynamicReadTime = `${computedReadingMinutes} ${t('unit.minRead')}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': ['TechArticle', 'BlogPosting'],
  headline: locGuideMeta.title,
  description: locGuideMeta.summary,
  image: [`https://fidgetsupply.com${guide.data.featuredImage}`],
  datePublished: guide.data.publishDate,
  dateModified: guide.data.updatedDate || guide.data.publishDate,
  author: {
    '@type': 'Organization',
    name: locGuideMeta.author,
    '@id': 'https://fidgetsupply.com/#organization'
  },
  publisher: {
    '@id': 'https://fidgetsupply.com/#organization'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('breadcrumb.home'),
      item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('breadcrumb.guides'),
      item: `https://fidgetsupply.com${getLocalizedPath('/insights', currentLang)}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: locGuideMeta.title,
      item: `https://fidgetsupply.com${getLocalizedPath(`/insights/${guide.data.slug}`, currentLang)}`
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedGuideFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---

<Layout
  title={currentLang === 'en' ? guide.data.metaTitle : `${locGuideMeta.title} | FidgetSupply`}
  description={currentLang === 'en' ? guide.data.metaDescription : locGuideMeta.summary}
  ogImage={guide.data.featuredImage}
  activePage="insights"
  jsonLd={[articleSchema, breadcrumbSchema, faqSchema]}
>
  <article class="guide-article">
    <header class="grand-hero">
      <div class="container" style="max-width: 1040px;">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/insights', currentLang)}>{t('breadcrumb.guides')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{locGuideMeta.category}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-dark">{locGuideMeta.category}</span>
          <span class="badge badge-gold">{dynamicReadTime}</span>
        </div>

        <h1 class="grand-hero-title">{locGuideMeta.title}</h1>
        <p class="grand-hero-lead" style="max-width: 920px;">{locGuideMeta.summary}</p>

        <div class="article-meta-bar">
          <div class="meta-author-block">
            <div class="meta-avatar">FS</div>
            <div class="meta-col">
              <span class="meta-label">{t('guide.by')}</span>
              <strong class="meta-val">{locGuideMeta.author}</strong>
            </div>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-col">
            <span class="meta-label">{t('guide.updated')}</span>
            <strong class="meta-val">{guide.data.updatedDate || guide.data.publishDate}</strong>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-col">
            <span class="meta-label">{t('guide.tocTitle')}</span>
            <strong class="meta-val">{dynamicReadTime}</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- 3-COLUMN BACKLINKO PUBLICATION ARCHITECTURE -->
    <div class="container article-layout-grid">
      <!-- LEFT SIDEBAR: Sticky Table of Contents -->
      <aside class="article-sidebar left-sidebar" aria-label="Table of Contents">
        <div class="sticky-wrapper">
          <h4 class="sidebar-title">{t('guide.tocTitle')}</h4>
          <nav id="toc-container" class="toc-nav">
            <!-- Dynamically populated by inline script -->
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Main Skyscraper Article -->
      <div class="article-main">
        <!-- Featured Hero Image -->
        <div class="article-featured-image-wrap">
          <img
            src={guide.data.featuredImage}
            alt={locGuideMeta.title}
            width="800"
            height="600"
            loading="eager"
          />
        </div>

        <!-- Executive Engineering Summary Callout -->
        <GeoDirectAnswer
          title={t('guide.execBriefTitle')}
          answer={locGuideMeta.summary}
        />

        <!-- Main Editorial Content -->
        <div class="prose article-body clean-editorial-content" set:html={localizedGuideHtml} />

        <!-- Referenced Ready-to-Produce Factory Models -->
        {relatedProducts.length > 0 && (
          <section class="related-skus-section" id="referenced-factory-models">
            <h2>{t('guide.refModelsTitle')}</h2>
            <div class="grid-3">
