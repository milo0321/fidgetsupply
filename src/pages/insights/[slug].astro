<script is:inline>
  (function () {
    // 1. Dynamic TOC & Scrollspy
    var tocNav = document.getElementById('toc-container');
    var articleBody = document.querySelector('.article-main');
    if (tocNav && articleBody) {
      var headings = articleBody.querySelectorAll('h2');
      if (headings.length) {
        var ul = document.createElement('ul');
        headings.forEach(function (h, idx) {
          if (!h.id) {
            h.id = 'section-' + (idx + 1);
          }
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          li.appendChild(a);
          ul.appendChild(li);
        });
        tocNav.appendChild(ul);

        var tocLinks = tocNav.querySelectorAll('a');
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var activeId = entry.target.id;
                  tocLinks.forEach(function (link) {
                    link.classList.toggle('active', link.getAttribute('href') === '#' + activeId);
                  });
                }
              });
            },
            { rootMargin: '-15% 0px -78% 0px', threshold: 0 }
          );
          headings.forEach(function (h) {
            observer.observe(h);
          });
        }
      }
    }

    // 2. Social Share & Copy Link Dock Buttons
    var shareUrl = encodeURIComponent(window.location.href);
    var shareTitle = encodeURIComponent(document.title);

    var linkedinBtn = document.getElementById('share-linkedin');
    if (linkedinBtn) {
      linkedinBtn.addEventListener('click', function () {
        window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + shareUrl, '_blank');
      });
    }

    var twitterBtn = document.getElementById('share-twitter');
    if (twitterBtn) {
      twitterBtn.addEventListener('click', function () {
        window.open('https://twitter.com/intent/tweet?url=' + shareUrl + '&text=' + shareTitle, '_blank');
      });
    }

    var whatsappBtn = document.getElementById('share-whatsapp');
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', function () {
        window.open('https://api.whatsapp.com/send?text=' + shareTitle + '%20' + shareUrl, '_blank');
      });
    }

    var copyBtn = document.getElementById('share-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href).then(function () {
            var iconLink = copyBtn.querySelector('.icon-link');
            var iconCheck = copyBtn.querySelector('.icon-check');
            copyBtn.classList.add('copied');
            if (iconLink) iconLink.style.display = 'none';
            if (iconCheck) iconCheck.style.display = 'block';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              if (iconLink) iconLink.style.display = 'block';
              if (iconCheck) iconCheck.style.display = 'none';
            }, 2000);
          });
        }
      });
    }
  })();
</script>

