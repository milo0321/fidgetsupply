---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getPrivateLabelOemCopy } from '../../i18n/landing/privateLabelOem';

const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const copy = getPrivateLabelOemCopy(currentLang);
const allProducts = await getCollection('products');

const oemSkus = ['FS-125', 'FS-047', 'FS-001', 'FS-013', 'FS-075', 'FS-150', 'FS-009', 'FS-135'];
const oemProducts = oemSkus
  .map((sku) => allProducts.find((p) => p.data.sku === sku))
  .filter(Boolean) as typeof allProducts;

const PAGE_TITLES: Record<string, string> = {
  en: 'Private Label Metal Fidget OEM & Amazon FBA ($0 Mold Fee)',
  de: 'Private Label Metall-Fidget OEM & Amazon FBA ($0 Form)',
  fr: 'OEM Fidget Métal Marque Blanche & Amazon FBA ($0 Moule)',
  nl: 'Private Label Metalen Fidget OEM & Amazon FBA ($0 Mal)',
  es: 'Fabricante OEM Fidget Metálico Marca Blanca ($0 Molde)',
  it: 'OEM Fidget Metallo Private Label & Amazon FBA ($0)',
  pt: 'Fidget Metálico Marca Própria OEM & FBA ($0 Molde)',
  sv: 'Private Label Metallfidget OEM & Amazon FBA ($0 Form)',
  da: 'Private Label Metalfidget OEM & Amazon FBA ($0 Form)',
  no: 'Private Label Metallfidget OEM & Amazon FBA ($0 Form)',
  fi: 'Private Label Metallifidget OEM & FBA ($0 Muotti)',
  pl: 'Private Label Metalowy Fidget OEM & FBA ($0 Forma)',
  cs: 'Private Label Kovový Fidget OEM & Amazon FBA ($0)',
  ru: 'OEM производство металлических фиджетов STM ($0 форма)',
  ja: '金属フィジェットOEM・Amazon FBA向けPB製造（金型代$0）',
  ko: '메탈 피젯 토이 PB/OEM 제조 & 아마존 FBA (금형비 $0)',
  id: 'Pabrik OEM Fidget Logam Private Label & FBA ($0 Cetakan)',
  ar: 'تصنيع فيدجت معدني علامة خاصة OEM و Amazon FBA ($0)'
};

const PAGE_DESCS: Record<string, string> = {
  en: 'Launch a private label metal fidget brand with $0 tooling fees across 140 ready molds: 50W laser OEM, 3-tier EVA/gift packaging, FNSKU & CPSC 16 CFR 1262.',
  de: 'Starten Sie Ihre Metall-Fidget-Eigenmarke ohne Werkzeugkosten ($0) auf 140 Serienformen: 50W-Laser, EVA-Etuis, Amazon FNSKU & US CPSC 16 CFR 1262.',
  fr: 'Lancez votre marque privée de fidgets métal à 0 $ de moule sur 140 modèles : laser 50W, étuis EVA, étiquettes FNSKU et conformité CPSC 16 CFR 1262.',
  nl: 'Lanceer uw private-label metalen fidget merk met $0 matrijskosten op 140 mallen: 50W laser, EVA-cases, Amazon FNSKU & CPSC 16 CFR 1262.',
  es: 'Lance su marca blanca de fidgets metálicos sin costo de molde ($0) en 140 modelos: láser 50W, estuches EVA, FNSKU Amazon y norma CPSC 16 CFR 1262.',
  it: 'Lancia il tuo brand Private Label di fidget in metallo a $0 costi stampo su 140 modelli: laser 50W, custodie EVA, FNSKU e CPSC 16 CFR 1262.',
  pt: 'Lance sua marca própria de fidgets metálicos com $0 custo de molde em 140 modelos: laser 50W, estojos EVA, FNSKU e conformidade CPSC 16 CFR 1262.',
  sv: 'Starta eget varumärke för metallfidgets med $0 verktygskostnad på 140 formar: 50W laser, EVA-fodral, FNSKU & US CPSC 16 CFR 1262.',
  da: 'Start dit eget metalfidget-brand med $0 værktøjsgebyr på 140 forme: 50W laser, EVA-etui, Amazon FNSKU & US CPSC 16 CFR 1262.',
  no: 'Lanser ditt eget metallfidget-merke med $0 verktøykostnad på 140 former: 50W laser, EVA-etui, Amazon FNSKU & CPSC 16 CFR 1262.',
  fi: 'Käynnistä oma metallifidget-brändi ilman muottikuluja ($0) 140 valmiilla muotilla: 50W laser, EVA-kotelot, FNSKU & CPSC 16 CFR 1262.',
  pl: 'Uruchom własną markę metalowych fidgetów bez kosztów formy ($0) na 140 modelach: laser 50W, etui EVA, Amazon FNSKU i CPSC 16 CFR 1262.',
  cs: 'Spusťte vlastní značku kovových fidgetů s poplatkem $0 za formu ze 140 modelů: 50W laser, EVA pouzdra, Amazon FNSKU & CPSC 16 CFR 1262.',
  ru: 'Запустите бренд металлических фиджетов (Private Label) без платы за форму ($0) на 140 моделях: лазер 50 Вт, кейсы EVA, FNSKU и CPSC 16 CFR 1262.',
  ja: '既存140金型で金型代$0の金属フィジェットPB/OEMブランドを立ち上げ：50Wレーザー刻印、3段階パッケージ、FNSKU貼付＆CPSC規制対応。',
  ko: '140종 기성 금형(금형비 $0)으로 메탈 피젯 PB 브랜드 런칭: 50W 레이저 각인, 3단계 패키징, 아마존 FNSKU & CPSC 16 CFR 1262 준수.',
  id: 'Bangun merek fidget logam private label tanpa biaya cetakan ($0) di 140 model: laser 50W, kotak EVA, label FNSKU & kepatuhan CPSC 16 CFR 1262.',
  ar: 'أطلق علامتك التجارية لأدوات الفيدجت المعدنية برسوم قالب 0$ عبر 140 قالباً جاهزاً: ليزر 50W، حافظات EVA، ملصقات FNSKU ومعيار CPSC.'
};

const oemFaqs = copy.faqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: oemFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: copy.serviceName,
  provider: { '@type': 'Organization', name: 'FidgetSupply.com', url: 'https://fidgetsupply.com' },
  description: copy.serviceDesc
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://fidgetsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: copy.bcParent, item: `https://fidgetsupply.com${getLocalizedPath('/wholesale-catalog', currentLang)}` },
    { '@type': 'ListItem', position: 3, name: copy.bcCurrent, item: `https://fidgetsupply.com${getLocalizedPath('/private-label-oem', currentLang)}` }
  ]
};
---

<Layout
  title={PAGE_TITLES[currentLang] || PAGE_TITLES.en}
  description={PAGE_DESCS[currentLang] || PAGE_DESCS.en}
  ogImage="/images/insights/zero-tooling-sop-hero.webp"
  activePage="custom-branding"
  jsonLd={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-grid">
      <div class="grand-hero-info">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/wholesale-catalog', currentLang)}>{copy.bcParent}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{copy.bcCurrent}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-gold">{copy.badge1}</span>
          <span class="badge badge-emerald">{copy.badge2}</span>
        </div>

        <h1 class="grand-hero-title">{PAGE_TITLES[currentLang] || PAGE_TITLES.en}</h1>
        <p class="grand-hero-lead">
          {PAGE_DESCS[currentLang] || PAGE_DESCS.en}
        </p>

        <div class="hero-glass-grid">
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[0].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[0].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[1].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[1].val} {t('unit.pcs')}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[2].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[2].val}</strong>
          </div>
          <div class="glass-kpi-card">
            <span class="glass-kpi-label">{copy.kpis[3].label}</span>
            <strong class="glass-kpi-val">{copy.kpis[3].val} {t('unit.pcs')}</strong>
          </div>
        </div>

        <div class="hero-actions">
          <a href={getLocalizedPath('/contact', currentLang)} class="btn btn-accent btn-hero">
            {copy.ctaPrimary}
          </a>
          <a href={getLocalizedPath('/sample-kit', currentLang)} class="btn btn-secondary-dark btn-hero">
            {copy.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="hero-showcase-card">
        <div class="hero-showcase-top">
          <span class="sku-pill">{copy.showcasePill}</span>
          <span class="hero-showcase-price">MOQ 50 / 100 {t('unit.pcs')}</span>
        </div>
        <div class="hero-showcase-img-wrap">
          <img
            src="/images/insights/zero-tooling-sop-hero.webp"
            alt={`${PAGE_TITLES[currentLang] || PAGE_TITLES.en} — FidgetSupply`}
            width="480"
            height="360"
            loading="eager"
          />
        </div>
        <div class="hero-showcase-meta">
          <span>{copy.showcaseMeta[0]}</span>
          <span>{copy.showcaseMeta[1]}</span>
          <span>{copy.showcaseMeta[2]}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={copy.geoTitle}
      answer={copy.geoAnswer}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Private Label OEM & Amazon FBA Launch Quote (MOQ 100)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.stageBadge}</span>
        <h2 class="section-title">{copy.stageTitle}</h2>
      </div>
      <div class="geo-table-wrap">
        <table class="geo-table">
          <thead>
            <tr>
              <th>{copy.tableHeaders[0]}</th>
              <th>{copy.tableHeaders[1]}</th>
              <th>{copy.tableHeaders[2]}</th>
            </tr>
          </thead>
          <tbody>
            {copy.tableRows.map((row) => (
              <tr>
                <td><strong>{row[0]}</strong></td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-light" style="padding: 2.5rem 1.75rem; border-radius: 1rem;">
      <div class="section-header-center">
        <span class="badge badge-emerald">{copy.picksBadge}</span>
        <h2 class="section-title">{copy.picksTitle}</h2>
      </div>
      <div class="grid-4">
        {oemProducts.map((p) => (
          <ProductCard product={p.data} lang={currentLang} />
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href={getLocalizedPath('/compliance-safety', currentLang)} class="btn btn-primary">
          {copy.picksCta}
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-header-center">
        <span class="badge">{copy.faqBadge}</span>
        <h2 class="section-title">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {oemFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
