# 1. Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Built-time / Public variable. If empty, GA4 script is skipped.
PUBLIC_GA_MEASUREMENT_ID=G-HHP8CN1M58

# 2. Resend Email API (For /api/contact RFQ Form Notification Emails)
# Runtime secret in Cloudflare Pages / Workers
RESEND_API_KEY=
NOTIFICATION_EMAIL=sales@fidgetsupply.com
RESEND_FROM_EMAIL=FidgetSupply Inquiries <quotes@send.fidgetsupply.com>

# 3. Cloudflare Turnstile Anti-Bot Protection
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF1GTaPVmYSNUcHS
TURNSTILE_SECRET_KEY=
